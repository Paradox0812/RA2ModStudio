<UserControl x:Class="RA2IniEditor.IDE.AuthoringDiff.Ra2AuthoringDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:diff="clr-namespace:RA2IniEditor.IDE.AuthoringDiff"
             AutomationProperties.AutomationId="Shell.AuthoringDiff.Document"
             Background="{DynamicResource UiSurfaceBrush}"
             Loaded="View_OnLoaded" SizeChanged="View_OnSizeChanged">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" /></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition MinHeight="32" Height="Auto"/><RowDefinition MinHeight="36" Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="10,5" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,0,0,1"
                AutomationProperties.AutomationId="Shell.AuthoringDiff.StatusBar">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource UiDangerSoftBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource UiWarningSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimaryBrush}" />
                <TextBlock Margin="14,0,0,0" Text="{Binding StatsText}" Foreground="{DynamicResource UiTextSecondaryBrush}"
                           AutomationProperties.AutomationId="Shell.AuthoringDiff.Stats" />
                <TextBlock x:Name="DiagnosticSummaryText" Margin="14,0,0,0" Text="{Binding DiagnosticSummary}"
                           Foreground="{DynamicResource UiWarningBrush}" AutomationProperties.AutomationId="Shell.AuthoringDiff.DiagnosticSummary" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="8,3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ReturnButton" Content="返回源文件" HorizontalAlignment="Left" ToolTip="返回源文件"
                    Style="{StaticResource IdeWorkspaceCommandButtonStyle}" Click="ReturnButton_OnClick"
                    AutomationProperties.AutomationId="Shell.AuthoringDiff.ReturnToSourceButton" AutomationProperties.Name="返回源文件" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,6,0" Content="放弃修改" IsEnabled="{Binding IsDismissEnabled}"
                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}" Click="DismissButton_OnClick"
                        AutomationProperties.AutomationId="Shell.AuthoringDiff.DismissButton" />
                <Button Content="应用全部" IsEnabled="{Binding IsApplyEnabled}" Style="{StaticResource IdeBlueCompactButtonStyle}"
                        Click="ApplyButton_OnClick" AutomationProperties.AutomationId="Shell.AuthoringDiff.ApplyAllButton" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <ListBox x:Name="RowsList" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                     FontFamily="{StaticResource UiCodeFontFamily}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="Shell.AuthoringDiff.Rows">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static diff:Ra2AuthoringDiffRowKind.Added}"><Setter Property="Background" Value="{StaticResource AuthoringDiffAddedRowBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static diff:Ra2AuthoringDiffRowKind.Removed}"><Setter Property="Background" Value="{DynamicResource UiDangerSoftBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static diff:Ra2AuthoringDiffRowKind.HunkHeader}"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OldLineNumber}" Padding="4,2" TextAlignment="Right" Foreground="{DynamicResource UiTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding NewLineNumber}" Padding="4,2" TextAlignment="Right" Foreground="{DynamicResource UiTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Marker}" Padding="4,2" TextAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="{Binding Text}" Padding="6,2" Foreground="{DynamicResource UiTextPrimaryBrush}" TextWrapping="NoWrap"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Border VerticalAlignment="Top" Margin="8" Padding="8,4" Background="{DynamicResource UiWarningSoftBrush}"
                    Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.AutomationId="Shell.AuthoringDiff.StaleNotice">
                <TextBlock Text="该提案已失效或已处理；差异仅供阅读。" Foreground="{DynamicResource UiWarningBrush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
