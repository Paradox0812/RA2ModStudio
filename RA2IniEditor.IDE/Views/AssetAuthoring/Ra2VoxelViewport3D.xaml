<UserControl x:Class="RA2IniEditor.IDE.Views.AssetAuthoring.Ra2VoxelViewport3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             Focusable="True">
    <Grid x:Name="InputSurface"
          Background="{DynamicResource UiCodeSurfaceBrush}" ClipToBounds="True"
          MouseLeftButtonDown="InputSurface_OnMouseLeftButtonDown"
          MouseRightButtonDown="InputSurface_OnMouseRightButtonDown"
          MouseDown="InputSurface_OnMouseDown"
          MouseUp="InputSurface_OnMouseButtonUp"
          MouseMove="InputSurface_OnMouseMove"
          MouseWheel="InputSurface_OnMouseWheel"
          LostMouseCapture="InputSurface_OnLostMouseCapture">
        <Viewport3D x:Name="Viewport"
                    AutomationProperties.AutomationId="VoxelStyle.Preview.Viewport3D"
                    Focusable="True">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" FieldOfView="38" />
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#747A84" />
                        <DirectionalLight Color="#F6F8FC" Direction="-0.7,-0.9,-1.4" />
                        <DirectionalLight Color="#8EA5C4" Direction="0.8,0.35,0.25" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D x:Name="SceneVisual" />
            <ModelVisual3D x:Name="StrokePreviewVisual" />
        </Viewport3D>

        <Border x:Name="StatusOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="14,8" CornerRadius="5" IsHitTestVisible="False"
                Background="{DynamicResource UiSurfaceBrush}" BorderBrush="{DynamicResource UiBorderBrush}"
                BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource UiTextSecondaryBrush}" />
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                Padding="8,4" CornerRadius="4" IsHitTestVisible="False"
                Background="#B8202530">
            <TextBlock Text="左键选择/拖动绘制 · 右键拖动旋转 · Shift+右键/中键平移 · 滚轮缩放"
                       Foreground="#E8EDF5" FontSize="11" />
        </Border>
    </Grid>
</UserControl>
