<UserControl x:Class="RA2IniEditor.IDE.Views.AssetAuthoring.Ra2VoxelStyleWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RA2IniEditor.IDE.Views.AssetAuthoring"
             AutomationProperties.AutomationId="VoxelStyle.Document"
             Background="{DynamicResource UiCanvasBrush}"
             FontFamily="{DynamicResource UiFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="VoxelTaskCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="VoxelStageButtonStyle" TargetType="Button" BasedOn="{StaticResource IdeWorkspaceCommandButtonStyle}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="VoxelSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource IdeWorkspaceCommandButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,4" />
        </Style>
        <Style x:Key="VoxelRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <Grid MinWidth="786">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource IdeWorkspaceCommandBarStyle}" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="VoxelStyle.Cancel"
                            Content="取消当前操作" IsEnabled="{Binding CanCancel}"
                            Style="{StaticResource IdeWorkspaceCommandButtonStyle}" Click="Cancel_OnClick" />
                    <StackPanel>
                        <TextBlock Text="体素上色工作区" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource UiTextPrimaryBrush}" />
                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Model"
                                   Foreground="{DynamicResource UiTextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding SourceName, Mode=OneWay}" /><Run Text="  ·  " />
                            <Run Text="{Binding SourceFacts, Mode=OneWay}" /><Run Text="  ·  " />
                            <Run Text="{Binding ModelDisplayName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" AutomationProperties.AutomationId="VoxelStyle.Workflow.StageNavigator">
                        <Button Click="SelectModelStage_OnClick" AutomationProperties.AutomationId="VoxelStyle.Workflow.Model">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VoxelStageButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsModelStage}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <StackPanel><TextBlock Text="1  模型" /><TextBlock Text="{Binding ModelStageStatus}" FontSize="10" Foreground="{DynamicResource UiTextSecondaryBrush}" /></StackPanel>
                        </Button>
                        <Button Click="SelectGeometryStage_OnClick" AutomationProperties.AutomationId="VoxelStyle.Workflow.Geometry">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VoxelStageButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsGeometryStage}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <StackPanel><TextBlock Text="2  几何" /><TextBlock Text="{Binding GeometryStageStatus}" FontSize="10" Foreground="{DynamicResource UiTextSecondaryBrush}" /></StackPanel>
                        </Button>
                        <Button Click="SelectSemanticsStage_OnClick" AutomationProperties.AutomationId="VoxelStyle.Workflow.Semantics">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VoxelStageButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSemanticsStage}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <StackPanel><TextBlock Text="3  分划与标注" /><TextBlock Text="{Binding SemanticsStageStatus}" FontSize="10" Foreground="{DynamicResource UiTextSecondaryBrush}" /></StackPanel>
                        </Button>
                        <Button Click="SelectColourStage_OnClick" AutomationProperties.AutomationId="VoxelStyle.Workflow.Colour">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VoxelStageButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsColourStage}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <StackPanel><TextBlock Text="4  上色" /><TextBlock Text="{Binding ColourStageStatus}" FontSize="10" Foreground="{DynamicResource UiTextSecondaryBrush}" /></StackPanel>
                        </Button>
                        <Button Click="SelectReviewStage_OnClick" AutomationProperties.AutomationId="VoxelStyle.Workflow.Review">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource VoxelStageButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsReviewStage}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <StackPanel><TextBlock Text="5  审阅与导出" /><TextBlock Text="{Binding ReviewStageStatus}" FontSize="10" Foreground="{DynamicResource UiTextSecondaryBrush}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="InspectorColumn" Width="336" MinWidth="286" MaxWidth="430" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource UiSurfaceBrush}" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid AutomationProperties.AutomationId="VoxelStyle.Workflow.Tabs">
                            <StackPanel Visibility="{Binding IsModelStage, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource VoxelTaskCardStyle}" AutomationProperties.AutomationId="VoxelStyle.Generation.Card">
                                    <StackPanel>
                                        <TextBlock Text="载入模型" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <TextBlock Text="从项目中载入 VOX/VXL；VXL 必须同时指定 VXLSE III 使用的 RA2 PAL。" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,4,0,8" />
                                        <Button AutomationProperties.AutomationId="VoxelStyle.SourcePicker" Content="载入模型…" IsEnabled="{Binding CanChooseSource}" HorizontalAlignment="Left" Style="{StaticResource IdeBlueCompactButtonStyle}" Click="ChooseSource_OnClick" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.SourcePath" Text="{Binding SourcePath}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="1.5 人工确认前向" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <ComboBox AutomationProperties.AutomationId="VoxelStyle.Orientation.Selector" ItemsSource="{Binding ForwardDirectionOptions}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedForwardDirection, Mode=TwoWay}" IsEnabled="{Binding CanEditColourInputs}" Margin="0,7,0,4" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Orientation.Status" Text="{Binding ForwardDirectionStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                        <TextBlock Text="只用于区分前/后，不改变模型方向或几何。" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="从参考图生成（可选）" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <WrapPanel Margin="0,8,0,4">
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Generation.ReferencePicker" Content="选择参考图…" IsEnabled="{Binding CanChooseSource}" Style="{StaticResource VoxelSmallButtonStyle}" Click="ChooseGenerationReference_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Generation.PalettePicker" Content="选择 PAL…" IsEnabled="{Binding CanChooseSource}" Style="{StaticResource VoxelSmallButtonStyle}" Click="ChooseGenerationPalette_OnClick" />
                                        </WrapPanel>
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Generation.ReferenceFacts" Text="{Binding GenerationReferenceFacts}" TextWrapping="Wrap" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Generation.PaletteFacts" Text="{Binding GenerationPaletteFacts}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                        <TextBlock Text="设计说明" FontWeight="SemiBold" Margin="0,8,0,4" />
                                        <TextBox AutomationProperties.AutomationId="VoxelStyle.Generation.Brief" Text="{Binding GenerationBrief, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" Style="{StaticResource IdeCompactTextBoxStyle}" />
                                        <Expander AutomationProperties.AutomationId="VoxelStyle.Generation.Advanced" Header="高级设置" Margin="0,8,0,0">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBox AutomationProperties.AutomationId="VoxelStyle.Generation.NegativeConstraints" Text="{Binding GenerationNegativeConstraints, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap" Style="{StaticResource IdeCompactTextBoxStyle}" />
                                                <WrapPanel Margin="0,6,0,0"><TextBlock Text="分辨率" VerticalAlignment="Center" Margin="0,0,4,0" /><ComboBox AutomationProperties.AutomationId="VoxelStyle.Generation.Resolution" SelectedValue="{Binding GenerationResolution}" SelectedValuePath="Content" Width="70"><ComboBoxItem Content="32" /><ComboBoxItem Content="48" /><ComboBoxItem Content="64" /><ComboBoxItem Content="96" /><ComboBoxItem Content="128" /></ComboBox><TextBlock Text="超时/分钟" VerticalAlignment="Center" Margin="12,0,4,0" /><TextBox AutomationProperties.AutomationId="VoxelStyle.Generation.Timeout" Text="{Binding GenerationTimeoutMinutes}" Width="48" /></WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Generation.CapabilityNotice" Text="{Binding GenerationProviderText}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,8,0,0" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Generation.Progress" Text="{Binding GenerationProgressText}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                        <Button AutomationProperties.AutomationId="VoxelStyle.Generation.Submit" Content="生成模型" IsEnabled="{Binding CanGenerateModel}" HorizontalAlignment="Left" Style="{StaticResource IdeBlueCompactButtonStyle}" Click="GenerateModel_OnClick" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsGeometryStage, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource VoxelTaskCardStyle}"><StackPanel><TextBlock Text="当前几何" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" /><TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.Status" Text="{Binding WorkingGeometryText}" TextWrapping="Wrap" Margin="0,6,0,0" /><TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.Provenance" Text="{Binding QualityProvenanceText}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" /></StackPanel></Border>
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="几何候选" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <TextBlock Text="载入 GLB 后生成本地基线与平滑候选；AI 结构识别是独立的可选步骤。" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,4,0,8" />
                                        <WrapPanel>
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Quality.SourcePicker" Content="载入 GLB…" IsEnabled="{Binding CanChooseQualitySource}" Style="{StaticResource VoxelSmallButtonStyle}" Click="ChooseQualitySource_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Quality.Generate" Content="生成候选" IsEnabled="{Binding CanGenerateQuality}" Style="{StaticResource VoxelSmallButtonStyle}" Click="GenerateQuality_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Quality.AnalyzeStructure" Content="AI 识别结构" IsEnabled="{Binding CanAnalyzeStructure}" ToolTip="{Binding StructureRecognitionToolTip}" Style="{StaticResource VoxelSmallButtonStyle}" Click="AnalyzeStructure_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Quality.UseCandidate" Content="采用当前候选" IsEnabled="{Binding CanUseQualityCandidate}" Style="{StaticResource IdeBlueCompactButtonStyle}" Click="UseQualityCandidate_OnClick" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding QualitySourceName}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding QualityAdmissionText}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsSemanticsStage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="VoxelStyle.Semantics.Card">
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="建立分划" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <TextBox AutomationProperties.AutomationId="VoxelStyle.Semantics.Instructions" Text="{Binding SemanticInstructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" Style="{StaticResource IdeCompactTextBoxStyle}" Margin="0,6,0,8" />
                                        <WrapPanel>
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Prepare" Content="创建人工区域" IsEnabled="{Binding CanAnalyzeSemantics}" Style="{StaticResource VoxelSmallButtonStyle}" Click="PrepareSemantics_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Analyze" Content="获取 AI 建议" IsEnabled="{Binding CanAnalyzeSemantics}" Style="{StaticResource VoxelSmallButtonStyle}" Click="AnalyzeSemantics_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Accept" Content="接受建议" IsEnabled="{Binding CanAcceptSemanticSuggestions}" Style="{StaticResource VoxelSmallButtonStyle}" Click="AcceptSemantics_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Discard" Content="丢弃建议" IsEnabled="{Binding CanDiscardSemanticSuggestions}" Style="{StaticResource VoxelSmallButtonStyle}" Click="DiscardSemantics_OnClick" />
                                        </WrapPanel>
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Semantics.Status" Text="{Binding SemanticStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="分划文件" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <WrapPanel Margin="0,7,0,3"><Button AutomationProperties.AutomationId="VoxelStyle.Semantics.LoadSidecar" Content="载入分划…" IsEnabled="{Binding CanLoadSemanticSidecar}" Style="{StaticResource VoxelSmallButtonStyle}" Click="LoadSemanticSidecar_OnClick" /><Button AutomationProperties.AutomationId="VoxelStyle.Semantics.SaveSidecar" Content="保存分划…" IsEnabled="{Binding CanSaveSemanticSidecar}" Style="{StaticResource VoxelSmallButtonStyle}" Click="SaveSemanticSidecar_OnClick" /></WrapPanel>
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Semantics.PersistenceStatus" Text="{Binding SemanticPersistenceStatus}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="绘制与标注" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <WrapPanel AutomationProperties.AutomationId="VoxelStyle.Semantics.EditMode" Margin="0,7,0,3"><Button Content="浏览" Style="{StaticResource VoxelSmallButtonStyle}" Click="SemanticBrowse_OnClick" /><Button Content="画笔" Style="{StaticResource VoxelSmallButtonStyle}" Click="SemanticPaint_OnClick" /><Button Content="擦除" Style="{StaticResource VoxelSmallButtonStyle}" Click="SemanticErase_OnClick" /></WrapPanel>
                                        <TextBlock Text="画笔目标" FontWeight="SemiBold" />
                                        <ComboBox AutomationProperties.AutomationId="VoxelStyle.Semantics.BrushPart" ItemsSource="{Binding SemanticBrushPartOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding SemanticBrushPartRole}" Margin="0,4,0,4" />
                                        <ComboBox AutomationProperties.AutomationId="VoxelStyle.Semantics.BrushMaterial" ItemsSource="{Binding SemanticBrushMaterialOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding SemanticBrushMaterialRole}" Margin="0,0,0,4" />
                                        <CheckBox AutomationProperties.AutomationId="VoxelStyle.Semantics.BrushRemap" Content="该区域允许阵营色" IsChecked="{Binding SemanticBrushRemapApproved}" Margin="0,2,0,6" />
                                        <WrapPanel><TextBlock Text="大小" VerticalAlignment="Center" Margin="0,0,4,4" /><ComboBox AutomationProperties.AutomationId="VoxelStyle.Semantics.BrushSize" ItemsSource="{Binding SemanticBrushSizes}" SelectedItem="{Binding SemanticBrushSize}" Width="52" Margin="0,0,8,4" /><CheckBox AutomationProperties.AutomationId="VoxelStyle.Semantics.MirrorBrush" Content="镜像" IsChecked="{Binding SemanticMirrorBrush}" Margin="0,0,8,4" /><Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Undo" Content="撤销" IsEnabled="{Binding CanUndoSemanticBrush}" Style="{StaticResource VoxelSmallButtonStyle}" Click="UndoSemanticBrush_OnClick" /><Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Redo" Content="重做" IsEnabled="{Binding CanRedoSemanticBrush}" Style="{StaticResource VoxelSmallButtonStyle}" Click="RedoSemanticBrush_OnClick" /></WrapPanel>
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Semantics.EditStatus" Text="{Binding SemanticEditStatus}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsColourStage, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="1. 人工确认单位类型" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <TextBlock Text="不再调用 DeepSeek 判型。Host 只根据你的选择路由地面、空中、大型水面或保守上色 Skill。" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,4,0,7" />
                                        <ComboBox AutomationProperties.AutomationId="VoxelStyle.UnitClass.Selector" ItemsSource="{Binding UnitClassOptions}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedUnitClass, Mode=TwoWay}" IsEnabled="{Binding CanSelectUnitClass}" />
                                        <Button AutomationProperties.AutomationId="VoxelStyle.UnitClass.Confirm" Content="确认单位类型" IsEnabled="{Binding CanConfirmUnitClass}" HorizontalAlignment="Left" Style="{StaticResource IdeBlueCompactButtonStyle}" Margin="0,7,0,0" Click="ConfirmUnitClass_OnClick" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.UnitClass.Status" Text="{Binding UnitClassStatusText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.UnitClass.Skill" Text="{Binding UnitClassSkillText}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="2. 基准色与上色技法" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <ComboBox AutomationProperties.AutomationId="VoxelStyle.BaseColour.Selector" ItemsSource="{Binding BaseColourOptions}" SelectedItem="{Binding SelectedBaseColour, Mode=TwoWay}" DisplayMemberPath="Display" IsEnabled="{Binding CanEditColourInputs}" Margin="0,7,0,4" />
                                        <Border AutomationProperties.AutomationId="VoxelStyle.BaseColour.Swatch" Background="{Binding BaseColourSwatch}" Height="24" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="1" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.BaseColour.Status" Text="{Binding BaseColourStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,4,0,8" />
                                        <ComboBox AutomationProperties.AutomationId="VoxelStyle.Template.Selector" ItemsSource="{Binding TechniqueOptions}" SelectedItem="{Binding SelectedTechnique, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEditColourInputs}" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Template.Description" Text="{Binding TechniqueDescription}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="3. 编译着色预览" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <ItemsControl AutomationProperties.AutomationId="VoxelStyle.StyleSources" ItemsSource="{Binding StyleSources}" Margin="0,6,0,6" />
                                        <TextBox AutomationProperties.AutomationId="VoxelStyle.StyleOverride" Text="{Binding StyleOverride, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="54" TextWrapping="Wrap" Style="{StaticResource IdeCompactTextBoxStyle}" />
                                        <Button AutomationProperties.AutomationId="VoxelStyle.Compile" Content="编译上色预览" IsEnabled="{Binding CanCompile}" HorizontalAlignment="Left" Style="{StaticResource IdeBlueCompactButtonStyle}" Margin="0,8,0,0" Click="Compile_OnClick" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsReviewStage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="VoxelStyle.Workflow.Output">
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="质量审阅" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.ColourQuality.Status" Text="{Binding ColourQualityStatusText}" TextWrapping="Wrap" Margin="0,6,0,4" />
                                        <TextBlock Text="结构与色阶" FontWeight="SemiBold" Margin="0,6,0,2" />
                                        <ItemsControl AutomationProperties.AutomationId="VoxelStyle.ColourQuality.FormZones" ItemsSource="{Binding ColourQualityFormZones}" />
                                        <TextBlock Text="边界与材质" FontWeight="SemiBold" Margin="0,7,0,2" />
                                        <ItemsControl AutomationProperties.AutomationId="VoxelStyle.ColourQuality.Boundaries" ItemsSource="{Binding ColourQualityBoundaries}" />
                                        <TextBlock Text="强调与细节" FontWeight="SemiBold" Margin="0,7,0,2" />
                                        <ItemsControl AutomationProperties.AutomationId="VoxelStyle.ColourQuality.Accents" ItemsSource="{Binding ColourQualityAccents}" />
                                        <TextBlock Text="游戏尺寸与运行时边界" FontWeight="SemiBold" Margin="0,7,0,2" />
                                        <ItemsControl AutomationProperties.AutomationId="VoxelStyle.ColourQuality.GameScale" ItemsSource="{Binding ColourQualityGameScale}" />
                                        <ItemsControl AutomationProperties.AutomationId="VoxelStyle.ColourQuality.Metrics" ItemsSource="{Binding ColourQualityMetrics}" Visibility="Collapsed" />
                                        <ItemsControl AutomationProperties.AutomationId="VoxelStyle.ColourQuality.Warnings" ItemsSource="{Binding ColourQualityWarnings}" Margin="0,6,0,0" />
                                        <CheckBox AutomationProperties.AutomationId="VoxelStyle.ColourQuality.AcceptWarnings" Content="我已审阅本次候选的质量警告" IsChecked="{Binding QualityWarningsAccepted, Mode=TwoWay}" IsEnabled="{Binding HasReviewableColourWarnings}" Visibility="{Binding HasReviewableColourWarnings, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource VoxelTaskCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="固化与导出" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.FinalCandidate.Status" Text="{Binding AcceptanceText}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,5,0,8" />
                                        <WrapPanel><Button AutomationProperties.AutomationId="VoxelStyle.AcceptSession" Content="固化最终候选" IsEnabled="{Binding CanAccept}" Style="{StaticResource IdeBlueCompactButtonStyle}" Margin="0,0,6,4" Click="AcceptSession_OnClick" /><Button AutomationProperties.AutomationId="VoxelStyle.ExportVox" Content="导出 VOX…" IsEnabled="{Binding CanExportVox}" Style="{StaticResource VoxelSmallButtonStyle}" Click="ExportVox_OnClick" /></WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Border Grid.Row="1" Padding="12,9" Background="{DynamicResource UiInfoSoftBrush}" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,1,0,0" AutomationProperties.AutomationId="VoxelStyle.Workflow.NextAction">
                        <StackPanel><TextBlock Text="{Binding CurrentWorkflowStageText}" FontWeight="SemiBold" /><TextBlock Text="{Binding WorkflowNextActionText}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" /></StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" AutomationProperties.AutomationId="VoxelStyle.Layout.InspectorSplitter" Style="{StaticResource UiGridSplitterStyle}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="260" /><RowDefinition Height="6" /><RowDefinition x:Name="DetailsRow" Height="240" MinHeight="140" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource IdeWorkspaceCommandBarStyle}" Padding="8,6">
                    <DockPanel AutomationProperties.AutomationId="VoxelStyle.Preview.Toolbar">
                        <WrapPanel DockPanel.Dock="Right"><Button AutomationProperties.AutomationId="VoxelStyle.Preview.ResetCamera" Content="重置视角" Style="{StaticResource VoxelSmallButtonStyle}" Click="ResetCamera_OnClick" /><Button AutomationProperties.AutomationId="VoxelStyle.Preview.SliceFallback" Content="切换切片" IsEnabled="{Binding CanUseSliceFallback}" Style="{StaticResource VoxelSmallButtonStyle}" Click="ToggleSliceFallback_OnClick" /></WrapPanel>
                        <WrapPanel><TextBlock Text="预览" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox AutomationProperties.AutomationId="VoxelStyle.Preview.ModeSelector" SelectedIndex="{Binding PreviewModeIndex, Mode=TwoWay}" MinWidth="150"><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.Original" Content="原始模型" /><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.Direct" Content="基线候选" /><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.Refined" Content="平滑候选" IsEnabled="{Binding HasRefinedCandidate}" /><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.Difference" Content="几何差异" IsEnabled="{Binding HasQualityDifference}" /><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.StructureRegions" Content="结构区域" /><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.Symmetry" Content="对称候选" /><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.Semantics" Content="语义分划" /><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.Result" Content="上色结果" /><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.Contrast" Content="对比度候选" /><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.RegionMask" Content="区域蒙版" /><ComboBoxItem AutomationProperties.AutomationId="VoxelStyle.Preview.Palette" Content="色盘" /><ComboBoxItem Content="形体区" IsEnabled="{Binding CanUseRev7DiagnosticPreviews}" /><ComboBoxItem Content="边界" IsEnabled="{Binding CanUseRev7DiagnosticPreviews}" /><ComboBoxItem Content="风险" IsEnabled="{Binding CanUseRev7DiagnosticPreviews}" /></ComboBox>
                            <WrapPanel AutomationProperties.AutomationId="VoxelStyle.Preview.SemanticReviewControls" IsEnabled="{Binding HasSemanticEvidence}" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="分类预览" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <WrapPanel AutomationProperties.AutomationId="VoxelStyle.Semantics.ReviewDimension"><Button AutomationProperties.AutomationId="VoxelStyle.Semantics.ReviewPart" Content="部件" Style="{StaticResource VoxelSmallButtonStyle}" Click="SemanticPartReview_OnClick" /><Button AutomationProperties.AutomationId="VoxelStyle.Semantics.ReviewMaterial" Content="材质" Style="{StaticResource VoxelSmallButtonStyle}" Click="SemanticMaterialReview_OnClick" /></WrapPanel>
                                <ItemsControl AutomationProperties.AutomationId="VoxelStyle.Semantics.ReviewLegend" ItemsSource="{Binding SemanticReviewLegend}" Visibility="{Binding IsSemanticsMode, Converter={StaticResource BoolToVisibility}}" Margin="8,0,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,8,0"><Border Width="10" Height="10" Margin="0,0,3,0" Background="{Binding ColourHex}" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="1" /><TextBlock Text="{Binding Display}" FontSize="11" VerticalAlignment="Center" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                            <WrapPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.FormZones" Content="形体区" IsEnabled="{Binding CanUseRev7DiagnosticPreviews}" Style="{StaticResource VoxelSmallButtonStyle}" Click="ShowFormZones_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.BoundaryIntent" Content="边界" IsEnabled="{Binding CanUseRev7DiagnosticPreviews}" Style="{StaticResource VoxelSmallButtonStyle}" Click="ShowBoundaryIntent_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.RiskOverlay" Content="风险" IsEnabled="{Binding CanUseRev7DiagnosticPreviews}" Style="{StaticResource VoxelSmallButtonStyle}" Click="ShowRiskOverlay_OnClick" />
                                <Button x:Name="GameScalePreviewButton" AutomationProperties.AutomationId="VoxelStyle.Preview.GameScale" Content="游戏尺寸" IsEnabled="{Binding CanUseRev7DiagnosticPreviews}" Style="{StaticResource VoxelSmallButtonStyle}" Click="ToggleGameScale_OnClick" />
                            </WrapPanel>
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1" Background="{DynamicResource UiCanvasBrush}">
                    <local:Ra2VoxelViewport3D x:Name="VoxelViewport" Visibility="{Binding IsThreeDimensionalPreview, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsImagePreviewVisible, Converter={StaticResource BoolToVisibility}}"><Image AutomationProperties.AutomationId="VoxelStyle.Preview.Image" Source="{Binding CurrentPreviewImage}" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" /></ScrollViewer>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Padding="7,3" CornerRadius="4" IsHitTestVisible="False" Background="#A8202530" Visibility="{Binding IsThreeDimensionalPreview, Converter={StaticResource BoolToVisibility}}"><TextBlock AutomationProperties.AutomationId="VoxelStyle.Preview.GeometryLightingNotice" Text="X 右 · Y 深度 · Z 上 · 几何审阅光照（非游戏法线）" Foreground="#E8EDF5" FontSize="11" /></Border>
                </Grid>
                <GridSplitter Grid.Row="2" AutomationProperties.AutomationId="VoxelStyle.Layout.DetailsSplitter" Style="{StaticResource UiGridSplitterStyle}" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <TabControl Grid.Row="3" x:Name="DetailsTabs" AutomationProperties.AutomationId="VoxelStyle.Details.Tabs" Style="{StaticResource UiTabControlStyle}" ItemContainerStyle="{StaticResource UiTabItemStyle}">
                    <TabItem Header="几何摘要" AutomationProperties.AutomationId="VoxelStyle.Details.Quality"><ScrollViewer><StackPanel><Border Style="{StaticResource VoxelTaskCardStyle}"><StackPanel><TextBlock Text="候选比较" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" /><ItemsControl AutomationProperties.AutomationId="VoxelStyle.Quality.Metrics" ItemsSource="{Binding QualityMetrics}" /><TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.NormalComparison" Text="{Binding NormalComparisonText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.Candidates" Text="{Binding QualityCandidatesText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.Admission" Text="{Binding QualityAdmissionText}" TextWrapping="Wrap" /></StackPanel></Border><Border Style="{StaticResource VoxelTaskCardStyle}"><StackPanel><TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.StructureFacts" Text="{Binding StructureProtectionText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.DifferenceLegend" Text="新增=绿 · 移除=红 · 保留=灰" /><TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.SemanticLegend" Text="{Binding SemanticLegendText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.SemanticReview" Text="{Binding SemanticReviewText}" TextWrapping="Wrap" /></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
                    <TabItem Header="区域清单" AutomationProperties.AutomationId="VoxelStyle.Details.Semantics"><ScrollViewer><StackPanel><Grid Margin="8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="区域" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="部件" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="材质" FontWeight="SemiBold" AutomationProperties.AutomationId="VoxelStyle.Semantics.MaterialRows" /><TextBlock Grid.Column="3" Text="来源" FontWeight="SemiBold" AutomationProperties.AutomationId="VoxelStyle.Semantics.RemapApproval" /></Grid><ItemsControl AutomationProperties.AutomationId="VoxelStyle.Semantics.PartRows" ItemsSource="{Binding SemanticAssignments}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource VoxelRowStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding RegionId}" FontWeight="SemiBold" /><TextBlock Text="{Binding GeometryFacts}" Foreground="{DynamicResource UiTextSecondaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding PartRole}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding MaterialRole}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{Binding SourceText}" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
                    <TabItem Header="上色计划" AutomationProperties.AutomationId="VoxelStyle.Details.Colour"><ScrollViewer><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Margin="8"><TextBlock Text="颜色角色" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" /><ItemsControl AutomationProperties.AutomationId="VoxelStyle.Plan.Roles" ItemsSource="{Binding Roles}" /></StackPanel><StackPanel Grid.Column="1" Margin="8"><TextBlock Text="区域规则" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" /><ItemsControl AutomationProperties.AutomationId="VoxelStyle.Plan.Rules" ItemsSource="{Binding Rules}" /><TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.PaletteContrast" Text="{Binding PaletteContrastText}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Grid></ScrollViewer></TabItem>
                    <TabItem Header="审阅问题" AutomationProperties.AutomationId="VoxelStyle.Details.Review"><ScrollViewer><StackPanel Margin="8"><ItemsControl AutomationProperties.AutomationId="VoxelStyle.Review.Issues" ItemsSource="{Binding ReviewIssues}" /><ItemsControl AutomationProperties.AutomationId="VoxelStyle.Quality.SemanticRegions" ItemsSource="{Binding SemanticRegions}" Visibility="Collapsed" /></StackPanel></ScrollViewer></TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="3" AutomationProperties.AutomationId="VoxelStyle.Status" MinHeight="28" Padding="10,5" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,1,0,0">
            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource IdeWorkspaceStatusBarStyle}"><Setter Property="Background" Value="{DynamicResource UiInfoSoftBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Background" Value="{DynamicResource UiDangerSoftBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
        </Border>
    </Grid>
</UserControl>
