<UserControl x:Class="RA2IniEditor.IDE.Views.AssetAuthoring.Ra2VoxelStyleWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RA2IniEditor.IDE.Views.AssetAuthoring"
             AutomationProperties.AutomationId="VoxelStyle.Document"
             Background="{DynamicResource UiCanvasBrush}"
             FontFamily="{DynamicResource UiFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="VoxelInspectorSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="VoxelEvidenceSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="VoxelPreviewModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IdeWorkspaceCommandButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <Style x:Key="VoxelOriginalModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsOriginalMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelDirectModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsDirectMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelRefinedModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsRefinedMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelDifferenceModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsDifferenceMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelStructureModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsStructureRegionsMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelSymmetryModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSymmetryMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelSemanticsModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSemanticsMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelResultModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsResultMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelContrastModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsContrastMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelRegionModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsRegionMaskMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelPaletteModeButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsPaletteMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelSemanticBrowseButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSemanticBrowseMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelSemanticPaintButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSemanticPaintMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelSemanticEraseButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSemanticEraseMode}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelSemanticPartReviewButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSemanticPartReview}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="VoxelSemanticMaterialReviewButtonStyle" TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSemanticMaterialReview}" Value="True"><Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="VoxelRowBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource IdeWorkspaceCommandBarStyle}" Padding="10,6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button AutomationProperties.AutomationId="VoxelStyle.SourcePicker"
                            Content="选择模型…" IsEnabled="{Binding CanChooseSource}"
                            Style="{StaticResource IdeWorkspaceCommandButtonStyle}"
                            Margin="0,0,6,0" Click="ChooseSource_OnClick" />
                    <Button AutomationProperties.AutomationId="VoxelStyle.Cancel"
                            Content="取消" IsEnabled="{Binding CanCancel}"
                            Style="{StaticResource IdeWorkspaceCommandButtonStyle}"
                            Click="Cancel_OnClick" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="体素风格工作区" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource UiTextPrimaryBrush}" />
                    <TextBlock AutomationProperties.AutomationId="VoxelStyle.Model"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource UiTextSecondaryBrush}">
                        <Run Text="{Binding SourceName, Mode=OneWay}" /><Run Text="  ·  " />
                        <Run Text="{Binding SourceFacts, Mode=OneWay}" /><Run Text="  ·  " />
                        <Run Text="{Binding ModelDisplayName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      VerticalContentAlignment="Stretch">
            <Grid MinWidth="786">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InspectorColumn" Width="312" MinWidth="260" MaxWidth="420" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="520" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource UiSurfaceBrush}"
                        BorderBrush="{DynamicResource UiDividerBrush}"
                        BorderThickness="0,0,1,0">
                    <TabControl x:Name="WorkflowTabs"
                                AutomationProperties.AutomationId="VoxelStyle.Workflow.Tabs"
                                SelectedIndex="1"
                                Style="{StaticResource UiTabControlStyle}"
                                ItemContainerStyle="{StaticResource UiTabItemStyle}">
                        <TabItem Header="生成" AutomationProperties.AutomationId="VoxelStyle.Workflow.Generation">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Border AutomationProperties.AutomationId="VoxelStyle.Generation.Card"
                                        Style="{StaticResource VoxelInspectorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="参考图生成" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <TextBlock Text="确认后创建一次 Tencent Hunyuan 3D 几何任务；结果只保留在当前会话。"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,4,0,8" />
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Generation.ReferencePicker"
                                                    Content="选择参考图…" IsEnabled="{Binding CanChooseSource}"
                                                    Style="{StaticResource IdeWorkspaceCommandButtonStyle}" Margin="0,0,6,4"
                                                    Click="ChooseGenerationReference_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Generation.PalettePicker"
                                                    Content="选择 PAL…" IsEnabled="{Binding CanChooseSource}"
                                                    Style="{StaticResource IdeWorkspaceCommandButtonStyle}" Margin="0,0,6,4"
                                                    Click="ChooseGenerationPalette_OnClick" />
                                        </WrapPanel>
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Generation.ReferenceFacts"
                                                   Text="{Binding GenerationReferenceFacts}" TextWrapping="Wrap" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Generation.PaletteFacts"
                                                   Text="{Binding GenerationPaletteFacts}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,2,0,8" />
                                        <TextBlock Text="设计说明（可选）" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox AutomationProperties.AutomationId="VoxelStyle.Generation.Brief"
                                                 Text="{Binding GenerationBrief, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" MinHeight="88" MaxHeight="150"
                                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                 Style="{StaticResource IdeCompactTextBoxStyle}" />
                                        <Expander AutomationProperties.AutomationId="VoxelStyle.Generation.Advanced"
                                                  Header="高级设置" Margin="0,8,0,6">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Text="负面约束（可选）" FontWeight="SemiBold" />
                                                <TextBox AutomationProperties.AutomationId="VoxelStyle.Generation.NegativeConstraints"
                                                         Text="{Binding GenerationNegativeConstraints, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" MinHeight="56" MaxHeight="100"
                                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                         Style="{StaticResource IdeCompactTextBoxStyle}" Margin="0,4,0,6" />
                                                <WrapPanel>
                                                    <TextBlock Text="分辨率" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ComboBox AutomationProperties.AutomationId="VoxelStyle.Generation.Resolution"
                                                              SelectedValue="{Binding GenerationResolution}" SelectedValuePath="Content"
                                                              MinWidth="72" Margin="0,0,14,0">
                                                        <ComboBoxItem Content="32" /><ComboBoxItem Content="48" />
                                                        <ComboBoxItem Content="64" /><ComboBoxItem Content="96" />
                                                        <ComboBoxItem Content="128" />
                                                    </ComboBox>
                                                    <TextBlock Text="超时（分钟）" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBox AutomationProperties.AutomationId="VoxelStyle.Generation.Timeout"
                                                             Text="{Binding GenerationTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="56" Style="{StaticResource IdeCompactTextBoxStyle}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Generation.CapabilityNotice"
                                                   Text="{Binding GenerationProviderText}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,2,0,6" />
                                        <TextBlock AutomationProperties.AutomationId="VoxelStyle.Generation.Progress"
                                                   Text="{Binding GenerationProgressText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <Button AutomationProperties.AutomationId="VoxelStyle.Generation.Submit"
                                                Content="生成预览" IsEnabled="{Binding CanGenerateModel}"
                                                HorizontalAlignment="Left" Style="{StaticResource IdeBlueCompactButtonStyle}"
                                                Click="GenerateModel_OnClick" />
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="几何" AutomationProperties.AutomationId="VoxelStyle.Workflow.Geometry">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Style="{StaticResource VoxelInspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="当前来源" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.SourcePath"
                                                       Text="{Binding SourcePath}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource VoxelInspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="几何候选" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                            <TextBlock Text="可选配对项目内的 GLB，本地生成直接与平滑候选；AI 结构识别需单独执行。"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,4,0,8" />
                                            <WrapPanel Margin="0,0,0,8">
                                                <Button AutomationProperties.AutomationId="VoxelStyle.Quality.SourcePicker"
                                                        Content="选择 GLB…" IsEnabled="{Binding CanChooseQualitySource}"
                                                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}"
                                                        Margin="0,0,6,4" Click="ChooseQualitySource_OnClick" />
                                                <Button AutomationProperties.AutomationId="VoxelStyle.Quality.Generate"
                                                        Content="生成候选" IsEnabled="{Binding CanGenerateQuality}"
                                                        Style="{StaticResource IdeBlueCompactButtonStyle}"
                                                        Margin="0,0,6,4" Click="GenerateQuality_OnClick" />
                                                <Button AutomationProperties.AutomationId="VoxelStyle.Quality.AnalyzeStructure"
                                                        AutomationProperties.HelpText="执行两次 DeepSeek 请求，可能消耗配额；只生成会话内审阅结果，绝不写入文件。"
                                                        Content="AI 识别结构" IsEnabled="{Binding CanAnalyzeStructure}"
                                                        ToolTip="{Binding StructureRecognitionToolTip}"
                                                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}"
                                                        Margin="0,0,6,4" Click="AnalyzeStructure_OnClick" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding QualitySourceName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.Provenance"
                                                       Text="{Binding QualityProvenanceText}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,2,0,4" />
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.Status"
                                                       Text="{Binding WorkingGeometryText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="风格" AutomationProperties.AutomationId="VoxelStyle.Workflow.Style">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border AutomationProperties.AutomationId="VoxelStyle.Semantics.Card"
                                            Style="{StaticResource VoxelInspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="部件与材质语义" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                            <TextBlock Text="DeepSeek 只读取文本化几何证据。建议需人工接受；逐区域人工覆盖优先于 AI，且不会修改几何。"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,4,0,8" />
                                            <TextBox AutomationProperties.AutomationId="VoxelStyle.Semantics.Instructions"
                                                     Text="{Binding SemanticInstructions, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" MinHeight="64" MaxHeight="120"
                                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                     Style="{StaticResource IdeCompactTextBoxStyle}"
                                                     ToolTip="例如：上部中央优先判断为炮塔；车体两侧下部可能是轮胎。证据不足时保持未知。" />
                                            <WrapPanel Margin="0,8,0,4">
                                                <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Prepare"
                                                        Content="仅准备人工区域" IsEnabled="{Binding CanAnalyzeSemantics}"
                                                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}" Margin="0,0,6,4"
                                                        Click="PrepareSemantics_OnClick" />
                                                <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Analyze"
                                                        Content="AI 建议" IsEnabled="{Binding CanAnalyzeSemantics}"
                                                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}" Margin="0,0,6,4"
                                                        Click="AnalyzeSemantics_OnClick" />
                                                <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Accept"
                                                        Content="接受建议" IsEnabled="{Binding CanAcceptSemanticSuggestions}"
                                                        Style="{StaticResource IdeBlueCompactButtonStyle}" Margin="0,0,6,4"
                                                        Click="AcceptSemantics_OnClick" />
                                                <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Discard"
                                                        Content="丢弃建议" IsEnabled="{Binding CanDiscardSemanticSuggestions}"
                                                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}" Margin="0,0,6,4"
                                                        Click="DiscardSemantics_OnClick" />
                                            </WrapPanel>
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Semantics.Status"
                                                       Text="{Binding SemanticStatusText}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource VoxelInspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="风格继承" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                            <ItemsControl AutomationProperties.AutomationId="VoxelStyle.StyleSources"
                                                          ItemsSource="{Binding StyleSources}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"
                                                                   Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource VoxelInspectorSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="本次风格要求" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                            <TextBlock Text="用自然语言补充当前项目风格；普通上色不要求阵营色，留空时只使用继承来源。"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,4,0,8" />
                                            <TextBox AutomationProperties.AutomationId="VoxelStyle.StyleOverride"
                                                     Text="{Binding StyleOverride, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" MinHeight="150" MaxHeight="260"
                                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                                     Style="{StaticResource IdeCompactTextBoxStyle}" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Compile"
                                                    Content="编译着色预览" IsEnabled="{Binding CanCompile}"
                                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Style="{StaticResource IdeBlueCompactButtonStyle}"
                                                    Click="Compile_OnClick" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="输出" AutomationProperties.AutomationId="VoxelStyle.Workflow.Output">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Border AutomationProperties.AutomationId="VoxelStyle.FinalCandidate.Status"
                                        Style="{StaticResource VoxelInspectorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="最终候选" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                                        <TextBlock Text="{Binding AcceptanceText}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource UiTextSecondaryBrush}" Margin="0,5,0,10" />
                                        <WrapPanel>
                                            <Button AutomationProperties.AutomationId="VoxelStyle.AcceptSession"
                                                    Content="固化最终候选" IsEnabled="{Binding CanAccept}"
                                                    Style="{StaticResource IdeWorkspaceCommandButtonStyle}"
                                                    Margin="0,0,6,4" Click="AcceptSession_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.ExportVox"
                                                    Content="导出 VOX…" IsEnabled="{Binding CanExportVox}"
                                                    Style="{StaticResource IdeBlueCompactButtonStyle}"
                                                    Margin="0,0,6,4" Click="ExportVox_OnClick" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Column="1"
                              AutomationProperties.AutomationId="VoxelStyle.Layout.InspectorSplitter"
                              Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              KeyboardIncrement="8" DragIncrement="2"
                              Focusable="True" Style="{StaticResource UiGridSplitterStyle}"
                              DragCompleted="InspectorSplitter_OnDragCompleted" />

                <Grid Grid.Column="2" MinHeight="420">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="260" />
                        <RowDefinition Height="6" />
                        <RowDefinition x:Name="DetailsRow" Height="240" MinHeight="160" MaxHeight="360" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            AutomationProperties.AutomationId="VoxelStyle.Preview.Toolbar"
                            Background="{DynamicResource UiSurfaceSubtleBrush}"
                            BorderBrush="{DynamicResource UiDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PlanSummary}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520"
                                           Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                <TextBlock Text="{Binding PlanTitle}" FontWeight="SemiBold" />
                            </DockPanel>
                            <WrapPanel>
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.Original" Content="原始"
                                        Style="{StaticResource VoxelOriginalModeButtonStyle}" Click="ShowOriginal_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.Direct" Content="基线"
                                        Style="{StaticResource VoxelDirectModeButtonStyle}" IsEnabled="{Binding HasQualityCandidates}" Click="ShowDirect_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.Refined" Content="平滑"
                                        Style="{StaticResource VoxelRefinedModeButtonStyle}" IsEnabled="{Binding HasRefinedCandidate}" Click="ShowRefined_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.Difference" Content="差异"
                                        Style="{StaticResource VoxelDifferenceModeButtonStyle}" IsEnabled="{Binding HasQualityDifference}" Click="ShowDifference_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.StructureRegions" Content="结构区"
                                        Style="{StaticResource VoxelStructureModeButtonStyle}" IsEnabled="{Binding HasStructurePartition}" Click="ShowStructureRegions_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.Symmetry" Content="对称"
                                        Style="{StaticResource VoxelSymmetryModeButtonStyle}" IsEnabled="{Binding HasSymmetryCandidate}" Click="ShowSymmetry_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.Semantics" Content="语义"
                                        Style="{StaticResource VoxelSemanticsModeButtonStyle}" IsEnabled="{Binding HasSemanticEvidence}" Click="ShowSemantics_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Quality.UseCandidate" Content="用于本会话"
                                        Style="{StaticResource VoxelPreviewModeButtonStyle}" IsEnabled="{Binding CanUseQualityCandidate}" Click="UseQualityCandidate_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.Result" Content="着色"
                                        Style="{StaticResource VoxelResultModeButtonStyle}" IsEnabled="{Binding HasPreview}" Click="ShowResult_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.Contrast" Content="对比度"
                                        Style="{StaticResource VoxelContrastModeButtonStyle}" IsEnabled="{Binding HasContrastCandidate}" Click="ShowContrast_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.RegionMask" Content="区域"
                                        Style="{StaticResource VoxelRegionModeButtonStyle}" IsEnabled="{Binding HasPreview}" Click="ShowRegionMask_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.Palette" Content="色板"
                                        Style="{StaticResource VoxelPaletteModeButtonStyle}" IsEnabled="{Binding HasPreview}" Click="ShowPalette_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.ResetCamera" Content="重置视角"
                                        Style="{StaticResource VoxelPreviewModeButtonStyle}"
                                        IsEnabled="{Binding IsThreeDimensionalPreview}" Click="ResetCamera_OnClick" />
                                <Button AutomationProperties.AutomationId="VoxelStyle.Preview.SliceFallback"
                                        IsEnabled="{Binding CanUseSliceFallback}" Click="ToggleSliceFallback_OnClick">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource VoxelPreviewModeButtonStyle}">
                                            <Setter Property="Content" Value="诊断切片" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSliceFallback}" Value="True">
                                                    <Setter Property="Content" Value="返回 3D" />
                                                    <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource UiCodeSurfaceBrush}"
                            BorderBrush="{DynamicResource UiDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6">
                        <Grid>
                            <local:Ra2VoxelViewport3D x:Name="VoxelViewport"
                                                      Visibility="{Binding IsThreeDimensionalPreview, Converter={StaticResource BoolToVisibility}}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsImagePreviewVisible, Converter={StaticResource BoolToVisibility}}">
                                <Image AutomationProperties.AutomationId="VoxelStyle.Preview.Image"
                                       Source="{Binding CurrentPreviewImage}" Stretch="Uniform"
                                       SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </ScrollViewer>
                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8"
                                    Padding="7,3" CornerRadius="4" IsHitTestVisible="False"
                                    Background="#A8202530"
                                    Visibility="{Binding IsThreeDimensionalPreview, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock AutomationProperties.AutomationId="VoxelStyle.Preview.GeometryLightingNotice"
                                           Text="X 右 · Y 深度 · Z 上 · 几何审阅光照（非游戏法线）"
                                           Foreground="#E8EDF5" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="2"
                                  AutomationProperties.AutomationId="VoxelStyle.Layout.DetailsSplitter"
                                  Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  KeyboardIncrement="8" DragIncrement="2"
                                  Focusable="True" Style="{StaticResource UiGridSplitterStyle}"
                                  DragCompleted="DetailsSplitter_OnDragCompleted" />

                    <TabControl x:Name="DetailsTabs"
                                Grid.Row="3"
                                AutomationProperties.AutomationId="VoxelStyle.Details.Tabs"
                                SelectedIndex="3"
                                Style="{StaticResource UiTabControlStyle}"
                                ItemContainerStyle="{StaticResource UiTabItemStyle}">
                        <TabItem Header="质量" AutomationProperties.AutomationId="VoxelStyle.Details.Quality">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource VoxelEvidenceSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="质量指标" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" Margin="0,0,0,4" />
                                            <ItemsControl AutomationProperties.AutomationId="VoxelStyle.Quality.Metrics" ItemsSource="{Binding QualityMetrics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource VoxelRowBorderStyle}">
                                                            <Grid MinWidth="560">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.35*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Current}" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Direct}" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Refined}" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Column="4" Text="{Binding Symmetry}" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource VoxelEvidenceSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="候选比较" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" Margin="0,0,0,4" />
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.NormalComparison"
                                                       Text="{Binding NormalComparisonText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.Candidates"
                                                       Text="{Binding QualityCandidatesText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.Admission"
                                                       Text="{Binding QualityAdmissionText}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="结构" AutomationProperties.AutomationId="VoxelStyle.Details.Structure">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Style="{StaticResource VoxelEvidenceSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="语义区域" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" Margin="0,0,0,4" />
                                            <ItemsControl AutomationProperties.AutomationId="VoxelStyle.Quality.SemanticRegions" ItemsSource="{Binding SemanticRegions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource VoxelRowBorderStyle}">
                                                            <StackPanel>
                                                                <TextBlock><Run Text="{Binding Region, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Disposition, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Provenance, Mode=OneWay}" /></TextBlock>
                                                                <TextBlock Foreground="{DynamicResource UiTextSecondaryBrush}"><Run Text="置信度 " /><Run Text="{Binding Confidence, Mode=OneWay}" /><Run Text=" · 体素 " /><Run Text="{Binding CellCount, Mode=OneWay}" /></TextBlock>
                                                                <TextBlock Text="{Binding ReviewNote}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource VoxelEvidenceSectionStyle}">
                                        <StackPanel>
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.StructureFacts"
                                                       Text="{Binding StructureProtectionText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.DifferenceLegend"
                                                       Text="几何差异：新增=绿 · 移除=红 · 未改变=半透明灰；蓝色仅在 AI 结构区中表示受保护薄结构"
                                                       TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.SemanticLegend"
                                                       Text="{Binding SemanticLegendText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.SemanticReview"
                                                       Text="{Binding SemanticReviewText}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="着色" AutomationProperties.AutomationId="VoxelStyle.Details.Colour">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource VoxelEvidenceSectionStyle}" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Text="颜色角色" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" Margin="0,0,0,4" />
                                            <ItemsControl AutomationProperties.AutomationId="VoxelStyle.Plan.Roles" ItemsSource="{Binding Roles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource VoxelRowBorderStyle}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding PaletteIndex, StringFormat=色板 #{0}}"
                                                                           VerticalAlignment="Center" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource UiDividerBrush}" />
                                    <Border Grid.Column="2" Style="{StaticResource VoxelEvidenceSectionStyle}" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Text="区域规则" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" Margin="0,0,0,4" />
                                            <ItemsControl AutomationProperties.AutomationId="VoxelStyle.Plan.Rules" ItemsSource="{Binding Rules}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource VoxelRowBorderStyle}">
                                                            <StackPanel>
                                                                <TextBlock><Run Text="{Binding Region, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding Role, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                                                <TextBlock Foreground="{DynamicResource UiTextSecondaryBrush}"><Run Text="{Binding Evidence, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" /></TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock AutomationProperties.AutomationId="VoxelStyle.Quality.PaletteContrast"
                                                       Text="{Binding PaletteContrastText}" TextWrapping="Wrap" Margin="8,8,8,0"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="语义" AutomationProperties.AutomationId="VoxelStyle.Details.Semantics">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="8,6" BorderBrush="{DynamicResource UiDividerBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <WrapPanel AutomationProperties.AutomationId="VoxelStyle.Semantics.EditMode">
                                             <Button Content="浏览" Style="{StaticResource VoxelSemanticBrowseButtonStyle}" Click="SemanticBrowse_OnClick" />
                                             <Button Content="画笔" Style="{StaticResource VoxelSemanticPaintButtonStyle}" Click="SemanticPaint_OnClick" />
                                             <Button Content="擦除" Style="{StaticResource VoxelSemanticEraseButtonStyle}" Click="SemanticErase_OnClick" />
                                             <WrapPanel AutomationProperties.AutomationId="VoxelStyle.Semantics.ReviewDimension">
                                                 <TextBlock Text="显示" VerticalAlignment="Center" Margin="8,0,4,4" />
                                                 <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.ReviewPart"
                                                         Content="部件" Style="{StaticResource VoxelSemanticPartReviewButtonStyle}"
                                                         Click="SemanticPartReview_OnClick" />
                                                 <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.ReviewMaterial"
                                                         Content="材质" Style="{StaticResource VoxelSemanticMaterialReviewButtonStyle}"
                                                         Click="SemanticMaterialReview_OnClick" />
                                             </WrapPanel>
                                             <TextBlock Text="大小" VerticalAlignment="Center" Margin="8,0,4,4" />
                                            <ComboBox AutomationProperties.AutomationId="VoxelStyle.Semantics.BrushSize"
                                                      ItemsSource="{Binding SemanticBrushSizes}" SelectedItem="{Binding SemanticBrushSize}"
                                                      Width="52" Margin="0,0,8,4" VerticalAlignment="Center" />
                                            <CheckBox AutomationProperties.AutomationId="VoxelStyle.Semantics.MirrorBrush"
                                                      Content="镜像" IsChecked="{Binding SemanticMirrorBrush}"
                                                      VerticalAlignment="Center" Margin="0,0,8,4" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Undo"
                                                    Content="撤销" IsEnabled="{Binding CanUndoSemanticBrush}"
                                                    Style="{StaticResource VoxelPreviewModeButtonStyle}" Click="UndoSemanticBrush_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.Redo"
                                                    Content="重做" IsEnabled="{Binding CanRedoSemanticBrush}"
                                                    Style="{StaticResource VoxelPreviewModeButtonStyle}" Click="RedoSemanticBrush_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.SaveSidecar"
                                                    Content="保存分划" IsEnabled="{Binding CanSaveSemanticSidecar}"
                                                    Style="{StaticResource VoxelPreviewModeButtonStyle}" Click="SaveSemanticSidecar_OnClick" />
                                            <Button AutomationProperties.AutomationId="VoxelStyle.Semantics.LoadSidecar"
                                                    Content="载入分划" IsEnabled="{Binding CanLoadSemanticSidecar}"
                                                    Style="{StaticResource VoxelPreviewModeButtonStyle}" Click="LoadSemanticSidecar_OnClick" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,2,0,2">
                                            <TextBlock Text="画笔目标" VerticalAlignment="Center" Margin="0,0,6,4" />
                                            <ComboBox ItemsSource="{Binding SemanticBrushPartOptions}" DisplayMemberPath="Display"
                                                      SelectedValuePath="Value" SelectedValue="{Binding SemanticBrushPartRole}"
                                                      Width="120" Margin="0,0,6,4" />
                                            <ComboBox ItemsSource="{Binding SemanticBrushMaterialOptions}" DisplayMemberPath="Display"
                                                      SelectedValuePath="Value" SelectedValue="{Binding SemanticBrushMaterialRole}"
                                                      Width="120" Margin="0,0,6,4" />
                                             <CheckBox Content="阵营色" IsChecked="{Binding SemanticBrushRemapApproved}"
                                                       VerticalAlignment="Center" Margin="0,0,6,4" />
                                         </WrapPanel>
                                         <ItemsControl AutomationProperties.AutomationId="VoxelStyle.Semantics.ReviewLegend"
                                                       ItemsSource="{Binding SemanticReviewLegend}" Margin="0,2,0,3">
                                             <ItemsControl.ItemsPanel>
                                                 <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                             </ItemsControl.ItemsPanel>
                                             <ItemsControl.ItemTemplate>
                                                 <DataTemplate>
                                                     <StackPanel Orientation="Horizontal" Margin="0,0,10,3">
                                                         <Border Width="11" Height="11" CornerRadius="2" Margin="0,0,4,0"
                                                                 BorderBrush="{DynamicResource UiBorderBrush}" BorderThickness="1"
                                                                 Background="{Binding ColourHex}" />
                                                         <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                                     </StackPanel>
                                                 </DataTemplate>
                                             </ItemsControl.ItemTemplate>
                                         </ItemsControl>
                                         <TextBlock AutomationProperties.AutomationId="VoxelStyle.Semantics.EditStatus"
                                                   Text="{Binding SemanticEditStatus}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                         <TextBlock AutomationProperties.AutomationId="VoxelStyle.Semantics.PersistenceStatus"
                                                   Text="{Binding SemanticPersistenceStatus}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <ListBox Grid.Row="1" AutomationProperties.AutomationId="VoxelStyle.Semantics.PartRows"
                                         ItemsSource="{Binding SemanticAssignments}"
                                         SelectedItem="{Binding SelectedSemanticAssignment}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource VoxelRowBorderStyle}">
                                                <Grid MinWidth="850">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.8*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="105" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock><Run Text="{Binding RegionId, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" ↔ " /><Run Text="{Binding MirrorRegionId, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock Text="{Binding GeometryFacts}" TextWrapping="Wrap" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                                        <TextBlock Foreground="{DynamicResource UiTextSecondaryBrush}"><Run Text="AI: " /><Run Text="{Binding SuggestedPartDisplay, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding SuggestedMaterialDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SuggestionConfidence, Mode=OneWay, StringFormat={}{0:P0}}" /><Run Text=" · " /><Run Text="{Binding SuggestionReason, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding PartRoleOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding PartRole, UpdateSourceTrigger=PropertyChanged}" Margin="6,0" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="2" AutomationProperties.AutomationId="VoxelStyle.Semantics.MaterialRows" ItemsSource="{Binding MaterialRoleOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding MaterialRole, UpdateSourceTrigger=PropertyChanged}" Margin="6,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <CheckBox Content="镜像联动" IsChecked="{Binding MirrorLinked}" Margin="0,0,0,4" />
                                                        <CheckBox AutomationProperties.AutomationId="VoxelStyle.Semantics.RemapApproval" Content="批准阵营色" IsChecked="{Binding RemapApproved, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SourceText}" HorizontalAlignment="Center" Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                                        <Button Content="撤销覆盖" IsEnabled="{Binding HasHumanOverride}" Margin="2,4,2,0" Click="ClearSemanticOverride_OnClick" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <TabItem Header="审阅" AutomationProperties.AutomationId="VoxelStyle.Details.Review">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Style="{StaticResource VoxelEvidenceSectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="组合审阅" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource VoxelEvidenceSectionStyle}" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Text="审阅事项" Style="{StaticResource IdeWorkspaceSectionTitleStyle}" Margin="0,0,0,4" />
                                            <ItemsControl AutomationProperties.AutomationId="VoxelStyle.Review.Issues" ItemsSource="{Binding ReviewIssues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"
                                                                   Foreground="{DynamicResource UiTextSecondaryBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3"
                AutomationProperties.AutomationId="VoxelStyle.Status"
                MinHeight="26" MaxHeight="52"
                Padding="10,4"
                BorderBrush="{DynamicResource UiDividerBrush}"
                BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource IdeWorkspaceStatusBarStyle}">
                    <Setter Property="Background" Value="{DynamicResource UiInfoSoftBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource UiDangerSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap" MaxHeight="38"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusText}"
                       Foreground="{DynamicResource UiTextPrimaryBrush}" />
        </Border>
    </Grid>
</UserControl>
