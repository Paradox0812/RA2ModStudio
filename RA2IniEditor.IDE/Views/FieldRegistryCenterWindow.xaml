<Window x:Class="RA2IniEditor.IDE.Views.FieldRegistryCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        AutomationProperties.AutomationId="FieldRegistryCenter.Window"
        Title="字段库中心"
        WindowStyle="None"
        Width="1280"
        Height="720"
        MinWidth="820"
        MinHeight="620"
        ResizeMode="CanResize"
        Background="{DynamicResource UiCanvasBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource IdeFieldRegistryRootStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Border AutomationProperties.AutomationId="FieldRegistryCenter.HeaderArea"
                    Background="{DynamicResource UiSurfaceSubtleBrush}"
                    BorderBrush="{DynamicResource UiDividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource UiFontSizeSectionTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource UiTextPrimaryBrush}"
                                   Text="字段库" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource IdeFieldRegistryMetadataTextStyle}"
                                   Text="浏览与维护智能编辑字段定义" />
                    </StackPanel>
                    <WrapPanel Grid.Column="2"
                               AutomationProperties.AutomationId="FieldRegistryCenter.HeaderChips"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center">
                        <Border Style="{StaticResource IdeFieldRegistryPriorityChipStyle}">
                            <TextBlock Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding Manager.ActiveSourceChipText}" />
                        </Border>
                        <Border Style="{StaticResource IdeFieldRegistryPriorityChipStyle}">
                            <TextBlock Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding Manager.WarningChipText}" />
                        </Border>
                        <Border Style="{StaticResource IdeFieldRegistryPriorityChipStyle}">
                            <TextBlock Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding Manager.BuiltInChipText}" />
                        </Border>
                    </WrapPanel>
                    <Button Grid.Column="3"
                            Width="28"
                            Height="28"
                            AutomationProperties.AutomationId="FieldRegistryCenter.CloseButton"
                            AutomationProperties.Name="关闭字段库中心"
                            ToolTip="关闭字段库中心"
                            Click="CloseButton_OnClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource UiIconButtonStyle}">
                        <Path Width="16" Height="16"
                              Data="{StaticResource IconGeometry.Action.Cancel}"
                              Fill="Transparent"
                              Stroke="{DynamicResource UiTextPrimaryBrush}"
                              StrokeThickness="1.2"
                              Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    AutomationProperties.AutomationId="FieldRegistryCenter.ActionGroup"
                    Style="{StaticResource IdeFieldRegistryCommandBarStyle}">
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Left" AutomationProperties.AutomationId="FieldRegistryCenter.Toolbar">
                        <Button AutomationProperties.AutomationId="FieldRegistryCenter.ReloadButton" Click="ReloadLocalFieldRegistry" Content="重新加载" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                        <Button AutomationProperties.AutomationId="FieldRegistryCenter.LearnFieldsButton" Click="OpenFieldLearning" Content="学习字段" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                        <Separator Margin="3,2,7,2" />
                        <Button AutomationProperties.AutomationId="FieldRegistryCenter.NewFieldButton" Click="CreateNewField" Content="新建字段" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                        <Button AutomationProperties.AutomationId="FieldRegistryCenter.EditFieldButton" Click="EditSelectedField" Content="编辑所选" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                        <Separator Margin="3,2,7,2" />
                        <Button AutomationProperties.AutomationId="FieldRegistryCenter.AdvancedToolsButton" Click="OpenAdvancedTools" Content="高级工具" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                    </WrapPanel>
                    <TextBlock Margin="12,0,0,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource IdeFieldRegistryMetadataTextStyle}"
                               Text="{Binding Manager.CenterFieldListSummaryText}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*" MinWidth="160" MaxWidth="220" />
                    <ColumnDefinition Width="50*" MinWidth="400" />
                    <ColumnDefinition Width="30*" MinWidth="240" MaxWidth="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        AutomationProperties.AutomationId="FieldRegistryCenter.Navigation"
                        Style="{StaticResource IdeFieldRegistryNavigationPaneStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="优先级" />
                        <StackPanel Grid.Row="1"
                                    AutomationProperties.AutomationId="FieldRegistryCenter.PriorityStrip"
                                    Margin="0,8,0,12">
                            <Border AutomationProperties.AutomationId="FieldRegistryCenter.PriorityChipProject" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="1  项目 Project" />
                            </Border>
                            <Border AutomationProperties.AutomationId="FieldRegistryCenter.PriorityChipGlobal" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="2  全局 Global" />
                            </Border>
                            <Border AutomationProperties.AutomationId="FieldRegistryCenter.PriorityChipBuiltIn" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="3  内置 BuiltIn" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" AutomationProperties.AutomationId="FieldRegistryCenter.StatusSummaryPanel">
                            <Border AutomationProperties.AutomationId="FieldRegistryCenter.ProjectStatusCard" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="项目" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding Manager.ProjectRegistryShortDisplayText}" ToolTip="{Binding Manager.ProjectRegistryFullPathToolTip}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Border>
                            <Border AutomationProperties.AutomationId="FieldRegistryCenter.GlobalStatusCard" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="全局" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding Manager.GlobalRegistryShortDisplayText}" ToolTip="{Binding Manager.GlobalRegistryFullPathToolTip}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </Border>
                            <Border AutomationProperties.AutomationId="FieldRegistryCenter.BuiltInStatusCard" Margin="0,0,0,10" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="内置" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding Manager.BuiltInFallbackDisplayText}" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="活跃字段包" />
                        <Border Grid.Row="4"
                                AutomationProperties.AutomationId="FieldRegistryCenter.ActivePacksPanel"
                                Margin="0,6,0,0"
                                Background="Transparent"
                                BorderThickness="0">
                            <Grid AutomationProperties.AutomationId="FieldRegistryCenter.ActivePacksCompactList">
                                <DataGrid AutomationProperties.AutomationId="FieldRegistryCenter.PacksGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding Manager.Packs}"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          Style="{StaticResource IdeFieldRegistryR2DataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="80" Binding="{Binding Scope}" Header="范围" />
                                        <DataGridTextColumn Width="56" Binding="{Binding FieldCount}" Header="字段" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        AutomationProperties.AutomationId="FieldRegistryCenter.FieldList"
                        Style="{StaticResource IdeFieldRegistryListPaneStyle}">
                    <Grid AutomationProperties.AutomationId="FieldRegistryCenter.MainFieldsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border AutomationProperties.AutomationId="FieldRegistryCenter.SearchSummaryRow"
                                Style="{StaticResource IdeFieldRegistryCommandBarStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid AutomationProperties.AutomationId="FieldRegistryCenter.SearchArea">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="14"
                                          Height="14"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource IconGeometry.FieldRegistry.Search}"
                                          Fill="Transparent"
                                          Stroke="{DynamicResource UiTextSecondaryBrush}"
                                          StrokeThickness="1.2"
                                          Stretch="Uniform" />
                                    <TextBox Grid.Column="1"
                                             AutomationProperties.AutomationId="FieldRegistryCenter.SearchTextBox"
                                             TextChanged="SearchTextBox_OnTextChanged"
                                             ToolTip="按 Key、Section、来源或说明筛选字段"
                                             Style="{StaticResource IdeFieldRegistrySearchBoxStyle}" />
                                </Grid>
                                <Border Grid.Column="1"
                                        AutomationProperties.AutomationId="FieldRegistryCenter.FieldCountChip"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource IdeFieldRegistryPriorityChipStyle}">
                                    <TextBlock Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding FieldCountText}" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           AutomationProperties.AutomationId="FieldRegistryCenter.WarningSummary"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource IdeFieldRegistryMetadataTextStyle}"
                                           Text="{Binding Manager.WarningSummaryText}" />
                            </Grid>
                        </Border>

                        <DataGrid x:Name="FieldsGrid"
                                  Grid.Row="1"
                                  AutomationProperties.AutomationId="FieldRegistryCenter.FieldsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  MinHeight="260"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding FieldRows}"
                                  MouseDoubleClick="FieldsGrid_OnMouseDoubleClick"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Style="{StaticResource IdeFieldRegistryR2DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="145" Binding="{Binding Key}" Header="Key" />
                                <DataGridTextColumn Width="100" Binding="{Binding SectionKind}" Header="Section" />
                                <DataGridTextColumn Width="88" Binding="{Binding EditorKind}" Header="类型" />
                                <DataGridTextColumn Width="78" Binding="{Binding SourceKind}" Header="来源" />
                                <DataGridTemplateColumn Width="*" MinWidth="120" Header="说明">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        AutomationProperties.AutomationId="FieldRegistryCenter.Details"
                        Style="{StaticResource IdeFieldRegistryDetailsPaneStyle}">
                    <Grid>
                        <Border AutomationProperties.AutomationId="FieldRegistryCenter.Details.EmptyState">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=FieldsGrid}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel MaxWidth="220"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Path Width="28"
                                      Height="28"
                                      Margin="0,0,0,10"
                                      Data="{StaticResource IconGeometry.Registry}"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource UiTextSecondaryBrush}"
                                      StrokeThickness="1.1"
                                      Stretch="Uniform" />
                                <TextBlock Style="{StaticResource IdeFieldRegistryR2EmptyStateTextStyle}"
                                           Text="选择一个字段，查看定义来源、可信度和取值说明。" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer AutomationProperties.AutomationId="FieldRegistryCenter.Details.Inspector"
                                      DataContext="{Binding SelectedItem.Details, ElementName=FieldsGrid}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=FieldsGrid}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <Border AutomationProperties.AutomationId="FieldRegistryCenter.Details.Identity"
                                        Style="{StaticResource IdeFieldRegistryR2InspectorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock FontFamily="{DynamicResource UiCodeFontFamily}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource UiTextPrimaryBrush}"
                                                   Text="{Binding Key}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource IdeFieldRegistryMetadataTextStyle}"
                                                   Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border AutomationProperties.AutomationId="FieldRegistryCenter.Details.Trust"
                                        Style="{StaticResource IdeFieldRegistryR2InspectorSectionStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="可信度" />
                                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource UiAccentBrush}" />
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource UiTextPrimaryBrush}"
                                                       Text="{Binding TrustDisplay}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource IdeFieldRegistryMetadataTextStyle}"
                                                   Text="{Binding TrustDetail}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasTrustDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>

                                <Border AutomationProperties.AutomationId="FieldRegistryCenter.Details.Definition"
                                        Style="{StaticResource IdeFieldRegistryR2InspectorSectionStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource IdeFieldRegistryFormLabelStyle}" Text="Section" />
                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding SectionKindDisplay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource IdeFieldRegistryFormLabelStyle}" Text="编辑器" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding EditorKindDisplay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource IdeFieldRegistryFormLabelStyle}" Text="值类型" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding ValueKindDisplay}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource IdeFieldRegistryFormLabelStyle}" Text="定义来源" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding SourceDisplay}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <Border AutomationProperties.AutomationId="FieldRegistryCenter.Details.Description"
                                        Style="{StaticResource IdeFieldRegistryR2InspectorSectionStyle}"
                                        Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="说明" />
                                        <TextBlock Margin="0,7,0,0"
                                                   Foreground="{DynamicResource UiTextPrimaryBrush}"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border AutomationProperties.AutomationId="FieldRegistryCenter.Details.Examples"
                                        Style="{StaticResource IdeFieldRegistryR2InspectorSectionStyle}"
                                        Visibility="{Binding HasExamples, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="示例" />
                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Examples}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock FontFamily="{DynamicResource UiCodeFontFamily}"
                                                                   Foreground="{DynamicResource UiTextPrimaryBrush}"
                                                                   Text="{Binding Value}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource IdeFieldRegistryMetadataTextStyle}"
                                                                   Text="{Binding Description}"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border AutomationProperties.AutomationId="FieldRegistryCenter.Details.AllowedValues"
                                        Style="{StaticResource IdeFieldRegistryR2InspectorSectionStyle}"
                                        Visibility="{Binding HasAllowedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="允许值" />
                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding AllowedValues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontFamily="{DynamicResource UiCodeFontFamily}"
                                                                   Foreground="{DynamicResource UiTextPrimaryBrush}"
                                                                   Text="{Binding Value}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="8,0,0,0"
                                                                   Style="{StaticResource IdeFieldRegistryMetadataTextStyle}"
                                                                   Text="{Binding DisplayName}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border AutomationProperties.AutomationId="FieldRegistryCenter.Details.CurrentStatus"
                                        BorderThickness="0"
                                        Padding="0,2,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding DataContext.Manager.LoadedPackSummaryText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding DataContext.Manager.ProjectFolderDisabledReason, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding DataContext.Manager.GlobalRegistryDisplayText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    AutomationProperties.AutomationId="FieldRegistryCenter.StatusArea"
                    Style="{StaticResource IdeFieldRegistryStatusBarStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding Manager.StatusText}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding Manager.WarningsStatusText}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
