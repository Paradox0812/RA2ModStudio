<Window x:Class="RA2IniEditor.IDE.Views.FieldRegistryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        AutomationProperties.AutomationId="FieldRegistryManager.Window"
        Title="字段库高级工具"
        WindowStyle="None"
        Width="1180"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        ResizeMode="CanResize"
        Background="{DynamicResource UiCanvasBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource IdeFieldRegistryRootStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Border AutomationProperties.AutomationId="FieldRegistryManager.HeaderArea"
                    Background="{DynamicResource UiSurfaceSubtleBrush}"
                    BorderBrush="{DynamicResource UiDividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource UiFontSizeSectionTitle}" FontWeight="SemiBold" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="字段库高级工具" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="状态、导入入口、清理预览与备份回滚" />
                    </StackPanel>
                    <WrapPanel Grid.Column="2"
                               AutomationProperties.AutomationId="FieldRegistryManager.StatusChips"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center">
                        <Border AutomationProperties.AutomationId="FieldRegistryManager.ActivePackChip" Style="{StaticResource IdeFieldRegistryPriorityChipStyle}">
                            <TextBlock Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding ActiveSourceChipText}" />
                        </Border>
                        <Border AutomationProperties.AutomationId="FieldRegistryManager.WarningChip" Style="{StaticResource IdeFieldRegistryPriorityChipStyle}">
                            <TextBlock Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding WarningChipText}" />
                        </Border>
                        <Border AutomationProperties.AutomationId="FieldRegistryManager.BuiltInChip" Style="{StaticResource IdeFieldRegistryPriorityChipStyle}">
                            <TextBlock Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding BuiltInChipText}" />
                        </Border>
                    </WrapPanel>
                    <Button Grid.Column="3"
                            Width="28"
                            Height="28"
                            AutomationProperties.AutomationId="FieldRegistryManager.CloseButton"
                            AutomationProperties.Name="关闭字段库高级工具"
                            ToolTip="关闭字段库高级工具"
                            Click="CloseButton_OnClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource UiIconButtonStyle}">
                        <Path Width="16" Height="16"
                              Data="{StaticResource IconGeometry.Action.Cancel}"
                              Fill="Transparent"
                              Stroke="{DynamicResource UiTextPrimaryBrush}"
                              StrokeThickness="1.2"
                              Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    AutomationProperties.AutomationId="FieldRegistryManager.EntryActionsPanel"
                    Style="{StaticResource IdeFieldRegistryCommandBarStyle}">
                <WrapPanel AutomationProperties.AutomationId="FieldRegistryManager.ReadOnlyActionsGroup">
                    <WrapPanel AutomationProperties.AutomationId="FieldRegistryManager.Toolbar">
                        <Button AutomationProperties.AutomationId="FieldRegistryManager.ReloadButton" Click="ReloadLocalFieldRegistry" Content="重新加载本地字段库" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                        <Button AutomationProperties.AutomationId="FieldRegistryManager.OpenFieldImportPreviewButton" Click="OpenHarvestPreview" Content="打开字段导入预览" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                        <Button AutomationProperties.AutomationId="FieldRegistryManager.RelearnCurrentIniButton" Click="RelearnCurrentIni" Content="重新学习当前 INI" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                        <Separator Margin="3,2,7,2" />
                        <Button AutomationProperties.AutomationId="FieldRegistryManager.OpenGlobalFolderButton" Click="OpenGlobalRegistryFolder" Content="打开全局目录" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                        <Button AutomationProperties.AutomationId="FieldRegistryManager.OpenProjectFolderButton" Click="OpenProjectRegistryFolder" Content="打开项目目录" IsEnabled="{Binding HasProject}" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                    </WrapPanel>
                </WrapPanel>
            </Border>

            <TabControl Grid.Row="2"
                        Margin="0"
                        Padding="0"
                        Style="{StaticResource IdeFieldRegistryTabControlStyle}">
                <TabItem Header="状态与来源" Style="{StaticResource IdeFieldRegistryTabItemStyle}">
                    <Grid AutomationProperties.AutomationId="FieldRegistryManager.StatusHubPanel" Margin="12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" AutomationProperties.AutomationId="FieldRegistryManager.ProjectChip" Margin="0,0,6,0" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="项目 / Project" />
                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding ProjectRegistryShortDisplayText}" ToolTip="{Binding ProjectRegistryFullPathToolTip}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding ProjectFolderDisabledReason}" MaxHeight="36" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" AutomationProperties.AutomationId="FieldRegistryManager.GlobalChip" Margin="3,0" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="全局 / Global" />
                                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding GlobalRegistryShortDisplayText}" ToolTip="{Binding GlobalRegistryFullPathToolTip}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding LoadedPackSummaryText}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="{Binding SourcePriorityText}" />
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding BuiltInFallbackDisplayText}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" AutomationProperties.AutomationId="FieldRegistryManager.ActivePacksPanel" Margin="0,0,6,0" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <Grid AutomationProperties.AutomationId="FieldRegistryManager.ActivePacksSection">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="当前 active 字段库" />
                                    <TextBlock Grid.Row="1" AutomationProperties.AutomationId="FieldRegistryManager.ActivePacksHelpText" Margin="0,4,0,7" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="项目 > 全局 > 内置。UnknownKey 仅表示该键未出现在当前有效字段库中。" />
                                    <Border Grid.Row="2" AutomationProperties.AutomationId="FieldRegistryManager.ActivePacksScrollHost" MinHeight="170">
                                        <DataGrid AutomationProperties.AutomationId="FieldRegistryManager.PacksGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  ItemsSource="{Binding Packs}"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  Style="{StaticResource IdeFieldRegistryR2DataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="74" Binding="{Binding Scope}" Header="范围" />
                                                <DataGridTemplateColumn Width="*" Header="目录">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate><TextBlock Text="{Binding ShortDirectoryPath}" ToolTip="{Binding DirectoryPathToolTip}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Width="70" Binding="{Binding FieldCount}" Header="字段" />
                                                <DataGridTextColumn Width="70" Binding="{Binding WarningCount}" Header="警告" />
                                                <DataGridTextColumn Width="120" Binding="{Binding StatusText}" Header="状态" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" AutomationProperties.AutomationId="FieldRegistryManager.WarningsPanel" Margin="6,0,0,0" Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                                <Grid AutomationProperties.AutomationId="FieldRegistryManager.WarningsSection">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="警告" />
                                        <TextBlock AutomationProperties.AutomationId="FieldRegistryManager.WarningsEmptyState" Margin="10,0,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding WarningsEmptyStateText}" />
                                    </DockPanel>
                                    <Border Grid.Row="1" AutomationProperties.AutomationId="FieldRegistryManager.WarningsScrollHost" Margin="0,8,0,0" MinHeight="110">
                                        <ListBox AutomationProperties.AutomationId="FieldRegistryManager.WarningsBox"
                                                 ItemsSource="{Binding Warnings}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource UiListBoxStyle}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="备份与回滚" Style="{StaticResource IdeFieldRegistryTabItemStyle}">
                    <Grid AutomationProperties.AutomationId="FieldRegistryManager.RollbackPanel" Margin="12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border AutomationProperties.AutomationId="FieldRegistryManager.RollbackRiskSummary" Style="{StaticResource IdeFieldRegistryWriteBoundaryStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="最近导入备份" />
                                    <TextBlock Margin="0,4,12,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="回滚会根据备份清单恢复或删除目标字段库；仍需显式确认。" />
                                    <TextBlock Margin="0,3,12,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding RollbackEmptyStateText}" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button AutomationProperties.AutomationId="FieldRegistryManager.RefreshRollbackManifestsButton" Click="RefreshRollbackManifests" Content="刷新备份" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                                    <Button AutomationProperties.AutomationId="FieldRegistryManager.RollbackSelectedButton" Click="RollbackSelected" Content="回滚所选" IsEnabled="{Binding CanRollbackSelected}" Style="{StaticResource IdeFieldRegistryR2FlatAccentButtonStyle}" />
                                    <Button AutomationProperties.AutomationId="FieldRegistryManager.OpenRollbackTargetFolderButton" Click="OpenRollbackTargetFolder" Content="目标" IsEnabled="{Binding CanOpenRollbackTargetFolder}" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                                    <Button AutomationProperties.AutomationId="FieldRegistryManager.OpenRollbackManifestFolderButton" Click="OpenRollbackManifestFolder" Content="清单" IsEnabled="{Binding CanOpenRollbackManifestFolder}" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                                    <Button AutomationProperties.AutomationId="FieldRegistryManager.OpenRollbackBackupFolderButton" Click="OpenRollbackBackupFolder" Content="备份" IsEnabled="{Binding CanOpenRollbackBackupFolder}" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  AutomationProperties.AutomationId="FieldRegistryManager.RollbackManifestsGrid"
                                  Margin="0,10,0,0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding RollbackManifests}"
                                  SelectedItem="{Binding SelectedRollbackManifest, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Style="{StaticResource IdeFieldRegistryR2DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="70" Binding="{Binding Scope}" Header="范围" />
                                <DataGridTextColumn Width="96" Binding="{Binding Status}" Header="状态" />
                                <DataGridTextColumn Width="160" Binding="{Binding TimestampUtc}" Header="时间戳" />
                                <DataGridTextColumn Width="*" MinWidth="140" Binding="{Binding TargetFileName}" Header="目标文件" />
                                <DataGridTextColumn Width="52" Binding="{Binding AddCount}" Header="新增" />
                                <DataGridTextColumn Width="64" Binding="{Binding UpdateCount}" Header="更新" />
                                <DataGridTextColumn Width="52" Binding="{Binding SkipCount}" Header="跳过" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2"
                                AutomationProperties.AutomationId="FieldRegistryManager.RollbackDetails"
                                DataContext="{Binding SelectedRollbackManifest}"
                                Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource IdeFieldRegistryFormLabelStyle}" Text="状态说明" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Style="{StaticResource IdeFieldRegistryFormLabelStyle}" Text="应用模式" />
                                <TextBlock Grid.Column="3" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding Mode}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Style="{StaticResource IdeFieldRegistryFormLabelStyle}" Text="目标路径" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding TargetFilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetFilePath}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource IdeFieldRegistryFormLabelStyle}" Text="清单路径" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding ManifestFilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ManifestFilePath}" />
                                <CheckBox Grid.Row="2"
                                          Grid.Column="3"
                                          HorizontalAlignment="Right"
                                          IsChecked="{Binding TargetFileExisted, Mode=OneWay}"
                                          IsHitTestVisible="False"
                                          Content="目标原本存在"
                                          Style="{StaticResource UiCheckBoxStyle}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="3" Margin="0,6,0,0">
                            <TextBlock AutomationProperties.AutomationId="FieldRegistryManager.RollbackDisabledReason" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding RollbackDisabledReason}" />
                            <TextBlock AutomationProperties.AutomationId="FieldRegistryManager.RollbackStatusText" Margin="0,3,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding RollbackStatusText}" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="概括清理" Style="{StaticResource IdeFieldRegistryTabItemStyle}">
                    <Grid AutomationProperties.AutomationId="FieldRegistryManager.CleanupPreviewPanel" Margin="12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border AutomationProperties.AutomationId="FieldRegistryManager.CleanupPreviewSummaryCard" Style="{StaticResource IdeFieldRegistryWriteBoundaryStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="字段库概括清理预览" />
                                    <TextBlock AutomationProperties.AutomationId="FieldRegistryManager.CleanupReadOnlySummary" Margin="0,4,12,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding CleanupPreviewEmptyStateText}" />
                                    <TextBlock AutomationProperties.AutomationId="FieldRegistryManager.CleanupPreviewEmptyState" Margin="0,3,12,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="先构建只读计划，再检查候选、删除、跳过和警告。" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button AutomationProperties.AutomationId="FieldRegistryManager.BuildCleanupPlanButton" Click="BuildCleanupPlan" Content="构建清理计划" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                                    <WrapPanel AutomationProperties.AutomationId="FieldRegistryManager.WriteActionsGroup">
                                        <Button AutomationProperties.AutomationId="FieldRegistryManager.ApplyCleanupPlanButton" Click="ApplyCleanupPlan" Content="应用清理" Style="{StaticResource IdeFieldRegistryR2FlatAccentButtonStyle}" />
                                    </WrapPanel>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Expander Grid.Row="1"
                                  AutomationProperties.AutomationId="FieldRegistryManager.CleanupPreviewExpander"
                                  Margin="0,10,0,0"
                                  Header="清理预览详情"
                                  IsExpanded="{Binding HasCleanupPreviewDetails, Mode=OneWay}"
                                  Style="{StaticResource UiExpanderStyle}">
                            <Border AutomationProperties.AutomationId="FieldRegistryManager.CleanupPreviewScrollHost" Margin="0,8,0,0" MaxHeight="260">
                                <TabControl AutomationProperties.AutomationId="FieldRegistryManager.RepairPreviewTabs" Style="{StaticResource IdeFieldRegistryTabControlStyle}">
                                    <TabItem Header="候选" Style="{StaticResource IdeFieldRegistryTabItemStyle}">
                                        <DataGrid AutomationProperties.AutomationId="FieldRegistryManager.CleanupPlanGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding CleanupPlanRows}" Style="{StaticResource IdeFieldRegistryR2DataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="70" Binding="{Binding Scope}" Header="范围" />
                                                <DataGridTextColumn Width="140" Binding="{Binding Key}" Header="Key" />
                                                <DataGridTextColumn Width="92" Binding="{Binding TargetSection}" Header="目标" />
                                                <DataGridTextColumn Width="210" Binding="{Binding SourceSections}" Header="具体 Section" />
                                                <DataGridTextColumn Width="94" Binding="{Binding EditorKind}" Header="编辑器" />
                                                <DataGridTextColumn Width="94" Binding="{Binding ValueKind}" Header="值类型" />
                                                <DataGridTextColumn Width="64" Binding="{Binding SourceFieldCount}" Header="字段数" />
                                                <DataGridTextColumn Width="76" Binding="{Binding MergedAllowedValueCount}" Header="值数量" />
                                                <DataGridTextColumn Width="*" Binding="{Binding SourceFiles}" Header="文件" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="摘要" Style="{StaticResource IdeFieldRegistryTabItemStyle}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock AutomationProperties.AutomationId="FieldRegistryManager.RepairPreviewSummary" Margin="10" Foreground="{DynamicResource UiTextPrimaryBrush}" Text="{Binding RepairPreview.SummaryText}" TextWrapping="Wrap" /></ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="抽象字段" Style="{StaticResource IdeFieldRegistryTabItemStyle}">
                                        <DataGrid AutomationProperties.AutomationId="FieldRegistryManager.RepairPreviewAbstractFieldsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding RepairPreview.AbstractFields}" Style="{StaticResource IdeFieldRegistryR2DataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="58" Binding="{Binding OperationText}" Header="操作" />
                                                <DataGridTextColumn Width="130" Binding="{Binding Key}" Header="Key" />
                                                <DataGridTextColumn Width="112" Binding="{Binding TargetSectionKind}" Header="目标 Section" />
                                                <DataGridTextColumn Width="220" Binding="{Binding SourceSectionKindsText}" Header="来源 Section" />
                                                <DataGridTextColumn Width="90" Binding="{Binding ValueKindText}" Header="值类型" />
                                                <DataGridTextColumn Width="220" Binding="{Binding AllowedValuesPreviewText}" Header="允许值" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="说明" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="将删除" Style="{StaticResource IdeFieldRegistryTabItemStyle}">
                                        <DataGrid AutomationProperties.AutomationId="FieldRegistryManager.RepairPreviewRemovedConcreteGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding RepairPreview.RemovedConcreteFields}" Style="{StaticResource IdeFieldRegistryR2DataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="160" Binding="{Binding Key}" Header="Key" />
                                                <DataGridTextColumn Width="140" Binding="{Binding ConcreteSectionKind}" Header="具体 Section" />
                                                <DataGridTextColumn Width="150" Binding="{Binding ReplacedBySectionKind}" Header="替代为" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Reason}" Header="原因" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="跳过" Style="{StaticResource IdeFieldRegistryTabItemStyle}">
                                        <DataGrid AutomationProperties.AutomationId="FieldRegistryManager.RepairPreviewSkippedGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding RepairPreview.SkippedFields}" Style="{StaticResource IdeFieldRegistryR2DataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="160" Binding="{Binding Key}" Header="Key" />
                                                <DataGridTextColumn Width="260" Binding="{Binding SectionKindsText}" Header="Section" />
                                                <DataGridTextColumn Width="*" Binding="{Binding Reason}" Header="原因" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="警告" Style="{StaticResource IdeFieldRegistryTabItemStyle}">
                                        <ListBox AutomationProperties.AutomationId="FieldRegistryManager.RepairPreviewWarningsList" ItemsSource="{Binding RepairPreview.Warnings}" Style="{StaticResource UiListBoxStyle}" />
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Expander>
                        <StackPanel Grid.Row="2"
                                    AutomationProperties.AutomationId="FieldRegistryManager.CleanupDetails"
                                    Margin="0,8,0,0">
                            <TextBlock AutomationProperties.AutomationId="FieldRegistryManager.CleanupWriteWarning" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding CleanupWriteWarningText}" />
                            <TextBlock AutomationProperties.AutomationId="FieldRegistryManager.CleanupStatusText" Margin="0,3,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding CleanupStatusText}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="3" Style="{StaticResource IdeFieldRegistryStatusBarStyle}">
                <TextBlock AutomationProperties.AutomationId="FieldRegistryManager.StatusText" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="{Binding StatusText}" />
            </Border>
        </Grid>
    </Border>
</Window>
