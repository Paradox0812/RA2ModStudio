<Window x:Class="RA2IniEditor.IDE.Views.FieldBrowser.Ra2AddPropertyWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        AutomationProperties.AutomationId="AddProperty.Window"
        Title="添加属性"
        Width="960"
        Height="680"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource UiCanvasBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="Button" BasedOn="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource IdeFieldRegistryFormInputStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource IdeFieldRegistryFormComboBoxStyle}" />
        <Style TargetType="DataGrid" BasedOn="{StaticResource IdeFieldRegistryR2DataGridStyle}" />
    </Window.Resources>
    <Border Style="{StaticResource IdeFieldRegistryRootStyle}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Text="类型：" />
            <ComboBox Grid.Column="1"
                      Margin="0,0,12,0"
                      AutomationProperties.AutomationId="AddProperty.SectionKindComboBox"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding SectionKindOptions}"
                      SelectedItem="{Binding SelectedSectionKindOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Text="范围：" />
            <ComboBox Grid.Column="3"
                      Margin="0,0,12,0"
                      AutomationProperties.AutomationId="AddProperty.SearchModeComboBox"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding SearchModeOptions}"
                      SelectedItem="{Binding SelectedSearchModeOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="4"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Text="搜索：" />
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="5"
                     AutomationProperties.AutomationId="AddProperty.SearchTextBox"
                     PreviewKeyDown="SearchTextBox_OnPreviewKeyDown"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock AutomationProperties.AutomationId="AddProperty.AnnotationStatusText"
                       Foreground="{DynamicResource UiTextSecondaryBrush}"
                       Text="{Binding AnnotationStatusText}" />
            <TextBlock AutomationProperties.AutomationId="AddProperty.AnnotationWarningsText"
                       Foreground="{DynamicResource UiWarningBrush}"
                       Text="{Binding AnnotationWarningsText}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid Grid.Row="2"
                  Margin="0,12,0,12"
                  AutoGenerateColumns="False"
                  AutomationProperties.AutomationId="AddProperty.FieldsGrid"
                  IsReadOnly="True"
                  ItemsSource="{Binding FilteredItems}"
                  MouseDoubleClick="FieldsGrid_OnMouseDoubleClick"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  Style="{StaticResource IdeFieldRegistryR2DataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="58" MinWidth="58" Binding="{Binding RecentDisplay}" Header="最近" />
                <DataGridTextColumn Width="140" MinWidth="130" Binding="{Binding Key}" Header="键名" />
                <DataGridTextColumn Width="150" MinWidth="140" Binding="{Binding DisplayName}" Header="显示名" />
                <DataGridTextColumn Width="105" MinWidth="100" Binding="{Binding TypeDisplay}" Header="类型" />
                <DataGridTextColumn Width="74" MinWidth="70" Binding="{Binding AnnotationDisplay}" Header="注释" />
                <DataGridTextColumn Width="95" MinWidth="90" Binding="{Binding ApplicabilityDisplay}" Header="分类" />
                <DataGridTextColumn Width="95" MinWidth="90" Binding="{Binding MatchSourceDisplay}" Header="命中" />
                <DataGridTextColumn Width="120" MinWidth="110" Binding="{Binding SourceDisplay}" Header="字段来源" />
                <DataGridTextColumn Width="*" MinWidth="220" Binding="{Binding Note}" Header="备注" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" AutomationProperties.AutomationId="AddProperty.ValueEntry">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     AutomationProperties.AutomationId="AddProperty.OptionTextBox"
                     Text="{Binding OptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="1"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Text="=" />
            <TextBox Grid.Column="2"
                     AutomationProperties.AutomationId="AddProperty.ValueTextBox"
                     Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Border Grid.Row="4"
                AutomationProperties.AutomationId="AddProperty.Inspector"
                Margin="0,10,0,0"
                Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel AutomationProperties.AutomationId="AddProperty.FieldDetailsPanel">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding SelectedItem.Details.Title}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource UiTextSecondaryBrush}"
                               Text="{Binding SelectedItem.Details.SourceDisplay}" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource UiTextSecondaryBrush}"
                               Text="{Binding SelectedItem.Details.TrustDisplay}" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding SelectedItem.Details.Description}"
                               TextWrapping="Wrap"
                               Visibility="{Binding SelectedItem.Details.HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ItemsControl Margin="0,8,0,0"
                                  ItemsSource="{Binding SelectedItem.Details.Examples}"
                                  Visibility="{Binding SelectedItem.Details.HasExamples, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="{x:Type ItemsControl}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="示例" />
                                    <ItemsPresenter />
                                </StackPanel>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                    <TextBlock FontFamily="Consolas"
                                               FontWeight="SemiBold"
                                               Text="{Binding Value}" />
                                    <TextBlock Margin="8,0,0,0"
                                               Foreground="{DynamicResource UiTextSecondaryBrush}"
                                               Text="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="5" Margin="0,8,0,0">
            <TextBlock AutomationProperties.AutomationId="AddProperty.ValueHintText"
                       Foreground="{DynamicResource UiTextSecondaryBrush}"
                       Text="{Binding ValueHintText}" />
            <TextBlock AutomationProperties.AutomationId="AddProperty.InsertPreviewText"
                       FontFamily="Consolas"
                       Foreground="{DynamicResource UiTextPrimaryBrush}"
                       Text="{Binding InsertPreviewText}" />
            <TextBlock AutomationProperties.AutomationId="AddProperty.DuplicateWarningText"
                       Foreground="{DynamicResource UiWarningBrush}"
                       Text="{Binding DuplicateWarningText}" />
            <StackPanel Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding HasDuplicate, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock VerticalAlignment="Center"
                           AutomationProperties.AutomationId="AddProperty.DuplicateActionWarningText"
                           Foreground="{DynamicResource UiWarningBrush}"
                           Text="{Binding DuplicateActionWarningText}" />
                <TextBlock Margin="12,0,6,0"
                           VerticalAlignment="Center"
                           Text="重复字段操作：" />
                <ComboBox MinWidth="150"
                          AutomationProperties.AutomationId="AddProperty.DuplicateActionComboBox"
                          ItemsSource="{Binding DuplicateActions}"
                          SelectedItem="{Binding SelectedDuplicateAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <TextBlock AutomationProperties.AutomationId="AddProperty.ReadOnlyHintText"
                       Foreground="{DynamicResource UiWarningBrush}"
                       Text="{Binding ReadOnlyHintText}" />
        </StackPanel>

        <Border Grid.Row="6"
                AutomationProperties.AutomationId="AddProperty.ActionFooter"
                Margin="0,10,0,0"
                Style="{StaticResource IdeFieldRegistryWriteBoundaryStyle}">
        <DockPanel>
            <TextBlock VerticalAlignment="Center"
                       DockPanel.Dock="Left"
                       Text="{Binding StatusText}" />
            <StackPanel HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Orientation="Horizontal">
                <Button MinWidth="118"
                        Margin="0,0,8,0"
                        AutomationProperties.AutomationId="AddProperty.EditAnnotationButton"
                        Click="EditAnnotationButton_OnClick"
                        Content="编辑字段注释..."
                        IsEnabled="{Binding CanEditAnnotation}" />
                <Button MinWidth="88"
                        Margin="0,0,8,0"
                        AutomationProperties.AutomationId="AddProperty.CancelButton"
                        Click="CancelButton_OnClick"
                        Content="取消" />
                <Button MinWidth="110"
                        AutomationProperties.AutomationId="AddProperty.AddSelectedButton"
                        Click="AddSelectedButton_OnClick"
                        Content="{Binding ConfirmButtonText}"
                        IsEnabled="{Binding CanConfirm}"
                        Style="{StaticResource IdeFieldRegistryR2FlatAccentButtonStyle}" />
            </StackPanel>
        </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
