<Window x:Class="RA2IniEditor.IDE.Views.FieldRegistryHarvestPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="FieldImportPreview.Window"
        Title="字段库导入预览"
        Width="1180" Height="720" MinWidth="820" MinHeight="650" ResizeMode="CanResize"
        Background="{DynamicResource UiSurfaceBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- Scoped migration aliases keep the existing dense advanced tabs readable without
             changing application-wide compatibility resources. -->
        <Style x:Key="IdeFieldRegistryDataGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource IdeFieldRegistryR2DataGridStyle}" />
        <Style x:Key="IdeFieldRegistryCommandButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
        <Style x:Key="IdeFieldRegistryAccentButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IdeFieldRegistryR2FlatAccentButtonStyle}" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border AutomationProperties.AutomationId="FieldImportPreview.WorkflowStepStrip"
                    Background="{DynamicResource UiSurfaceSubtleBrush}"
                    BorderBrush="{DynamicResource UiDividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource UiAccentBrush}" Text="1  来源" />
                    <TextBlock Margin="14,0" Foreground="{DynamicResource UiTextSecondaryBrush}" Text="›" />
                    <TextBlock Foreground="{DynamicResource UiTextPrimaryBrush}" Text="2  审阅" />
                    <TextBlock Margin="14,0" Foreground="{DynamicResource UiTextSecondaryBrush}" Text="›" />
                    <TextBlock Foreground="{DynamicResource UiTextPrimaryBrush}" Text="3  计划" />
                    <TextBlock Margin="14,0" Foreground="{DynamicResource UiTextSecondaryBrush}" Text="›" />
                    <TextBlock Foreground="{DynamicResource UiTextPrimaryBrush}" Text="4  确认 / 结果" />
                </StackPanel>
            </Border>
            <DockPanel Grid.Row="1" Margin="0,6,0,0">
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button MinWidth="0" AutomationProperties.AutomationId="FieldImportPreview.InsertSampleButton" Click="InsertSample" Content="插入示例" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                <Button MinWidth="0" AutomationProperties.AutomationId="FieldImportPreview.ParsePreviewButton" Click="ParseAndPreview" Content="解析并预览" Style="{StaticResource IdeFieldRegistryR2FlatAccentButtonStyle}" />
                <Button MinWidth="0" AutomationProperties.AutomationId="FieldImportPreview.UseCurrentIniButton" Click="UseCurrentIni" Content="使用当前 INI" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
                <Button MinWidth="0" AutomationProperties.AutomationId="FieldImportPreview.ClearButton" Click="ClearPreview" Content="清空" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource UiTextSecondaryBrush}" Text="来源名称" /><TextBox Width="240" AutomationProperties.AutomationId="FieldImportPreview.SourceNameTextBox" Text="{Binding SourceName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource IdeFieldRegistryFormInputStyle}" /></StackPanel>
            </DockPanel>
        </Grid>
        <Border Grid.Row="1"
                AutomationProperties.AutomationId="FieldImportPreview.SourceArea"
                Margin="0,8,0,0"
                MinHeight="130"
                MaxHeight="180"
                Style="{StaticResource IdeFieldRegistryR2FlatSectionStyle}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="来源 / Source" /><TextBlock Margin="0,2,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="粘贴字段文档或 INI 风格文本" /></StackPanel><TextBlock Margin="16,0,0,0" Style="{StaticResource IdeFieldRegistryMetadataTextStyle}" Text="步骤 1：解析原始文本；步骤 2：差异审阅；步骤 3：构建计划并确认应用。" TextWrapping="Wrap" /></DockPanel>
                <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource UiTextSecondaryBrush}" Text="获取 URL" /><TextBox Grid.Column="1" AutomationProperties.AutomationId="FieldImportPreview.FetchUrlTextBox" Margin="0,0,8,0" Text="{Binding FetchUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding FetchUrl}" Style="{StaticResource IdeFieldRegistryFormInputStyle}" /><Button Grid.Column="2" AutomationProperties.AutomationId="FieldImportPreview.FetchRawTextButton" Click="FetchRawText" Content="获取原始文本" IsEnabled="{Binding CanFetchRawText}" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" /><Button Grid.Column="3" AutomationProperties.AutomationId="FieldImportPreview.CancelFetchButton" Click="CancelFetch" Content="取消" IsEnabled="{Binding CanCancelFetch}" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" /></Grid>
                <TextBox Grid.Row="2" AutomationProperties.AutomationId="FieldImportPreview.RawTextBox" Margin="0,8,0,0" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="NoWrap" Style="{StaticResource IdeFieldRegistryCodeTextBoxStyle}" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding SummaryText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="FieldImportPreview.FetchStatusText" Margin="0,3,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding FetchStatusText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="FieldImportPreview.CurrentIniHarvestStatusText" Margin="0,3,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding CurrentIniHarvestStatusText}" TextWrapping="Wrap" /></StackPanel>
        <Border Grid.Row="3"
                AutomationProperties.AutomationId="FieldImportPreview.PlanArea"
                Margin="0,8,0,0"
                Style="{StaticResource IdeFieldRegistryWriteBoundaryStyle}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <WrapPanel><TextBlock VerticalAlignment="Center" Margin="0,0,12,6" Style="{StaticResource IdeFieldRegistrySectionHeaderStyle}" Text="应用计划" /><TextBlock VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{DynamicResource UiTextSecondaryBrush}" Text="目标" /><ComboBox Width="150" AutomationProperties.AutomationId="FieldImportPreview.TargetScopeComboBox" Margin="0,0,10,6" DisplayMemberPath="DisplayName" ItemsSource="{Binding TargetScopeOptions}" SelectedValue="{Binding SelectedTargetScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" Style="{StaticResource IdeFieldRegistryFormComboBoxStyle}" /><TextBlock VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{DynamicResource UiTextSecondaryBrush}" Text="模式" /><ComboBox Width="150" AutomationProperties.AutomationId="FieldImportPreview.ApplyModeComboBox" Margin="0,0,10,6" DisplayMemberPath="DisplayName" ItemsSource="{Binding ApplyModeOptions}" SelectedValue="{Binding SelectedApplyMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" Style="{StaticResource IdeFieldRegistryFormComboBoxStyle}" /><Button AutomationProperties.AutomationId="FieldImportPreview.BuildApplyPlanButton" Click="BuildApplyPlan" Content="构建应用计划" IsEnabled="{Binding CanBuildApplyPlan}" Style="{StaticResource IdeFieldRegistryR2FlatCommandButtonStyle}" /><Button AutomationProperties.AutomationId="FieldImportPreview.ApplyButton" Click="ApplyCurrentPlan" Content="应用" IsEnabled="{Binding CanApply}" Style="{StaticResource IdeFieldRegistryR2FlatAccentButtonStyle}" /></WrapPanel>
                <StackPanel Grid.Row="1" Margin="0,4,0,0"><TextBlock Foreground="{StaticResource ShellMutedTextBrush}" AutomationProperties.AutomationId="FieldImportPreview.TargetFilePreviewText" Text="{Binding TargetFilePreviewText}" TextWrapping="Wrap" /><TextBlock Margin="0,3,0,0" AutomationProperties.AutomationId="FieldImportPreview.ApplySummaryText" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding ApplySummaryText}" TextWrapping="Wrap" /></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="0,10,0,0" MinHeight="260"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TabControl AutomationProperties.AutomationId="FieldImportPreview.MainFlowTabs" ItemContainerStyle="{StaticResource IdeFieldRegistryTabItemStyle}" Style="{StaticResource IdeFieldRegistryTabControlStyle}">
                <TabItem AutomationProperties.AutomationId="FieldImportPreview.PreviewDiffTab" Header="预览结果"><DataGrid Style="{StaticResource IdeFieldRegistryDataGridStyle}" AutoGenerateColumns="False" AutomationProperties.AutomationId="FieldImportPreview.PreviewDiffGrid" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding DiffRows}"><DataGrid.Columns><DataGridTextColumn Width="90" Binding="{Binding Kind}" Header="类型" /><DataGridTextColumn Width="150" Binding="{Binding Key}" Header="Key" /><DataGridTextColumn Width="110" Binding="{Binding AppliesTo}" Header="适用对象" /><DataGridTextColumn Width="120" Binding="{Binding ExistingScope}" Header="已有范围" /><DataGridTextColumn Width="150" Binding="{Binding ExistingSourceName}" Header="已有来源" /><DataGridTextColumn Width="120" Binding="{Binding PreviewEditorKind}" Header="预览编辑器" /><DataGridTextColumn Width="120" Binding="{Binding ExistingEditorKind}" Header="已有编辑器" /><DataGridTextColumn Width="120" Binding="{Binding PreviewSourceKind}" Header="预览来源" /><DataGridTextColumn Width="120" Binding="{Binding ExistingSourceKind}" Header="已有来源类型" /><DataGridTextColumn Width="*" Binding="{Binding Message}" Header="消息" /></DataGrid.Columns></DataGrid></TabItem>
                <TabItem AutomationProperties.AutomationId="FieldImportPreview.ApplyPlanTab" Header="应用计划"><DockPanel Margin="8"><ScrollViewer DockPanel.Dock="Top" MaxHeight="116" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock AutomationProperties.AutomationId="FieldImportPreview.ApplyDisabledReasonText" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding ApplyDisabledReason}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="FieldImportPreview.ApplyStatusText" Margin="0,3,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding ApplyStatusText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="FieldImportPreview.GeneralizationSummaryText" Margin="0,6,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding GeneralizationSummaryText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="FieldImportPreview.GeneralizationApplySummaryText" Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{StaticResource ShellPrimaryTextBrush}" Text="{Binding GeneralizationApplySummaryText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="FieldImportPreview.GeneralizationWarningSummaryText" Margin="0,3,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding GeneralizationWarningSummaryText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="FieldImportPreview.LastApplySummaryText" Margin="0,6,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding LastApplySummaryText}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="FieldImportPreview.LastApplyTargetPathText" Margin="0,3,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding LastApplyTargetFilePath}" TextWrapping="Wrap" /><TextBlock AutomationProperties.AutomationId="FieldImportPreview.LastApplyManifestPathText" Margin="0,3,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding LastApplyBackupManifestPath}" TextWrapping="Wrap" /></StackPanel></ScrollViewer><DataGrid Style="{StaticResource IdeFieldRegistryDataGridStyle}" AutoGenerateColumns="False" AutomationProperties.AutomationId="FieldImportPreview.ApplyPlanGrid" Margin="0,8,0,0" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding ApplyPlanItems}"><DataGrid.Columns><DataGridTextColumn Width="90" Binding="{Binding Operation}" Header="操作" /><DataGridTextColumn Width="160" Binding="{Binding Key}" Header="Key" /><DataGridTextColumn Width="110" Binding="{Binding AppliesTo}" Header="适用对象" /><DataGridTextColumn Width="120" Binding="{Binding TargetScope}" Header="目标范围" /><DataGridTextColumn Width="120" Binding="{Binding ExistingScope}" Header="已有范围" /><DataGridTextColumn Width="150" Binding="{Binding ExistingSource}" Header="已有来源" /><DataGridTextColumn Width="*" Binding="{Binding Message}" Header="消息" /></DataGrid.Columns></DataGrid></DockPanel></TabItem>
                <TabItem AutomationProperties.AutomationId="FieldImportPreview.IssuesWarningsTab" Header="问题与警告"><TabControl Margin="8" ItemContainerStyle="{StaticResource IdeFieldRegistryTabItemStyle}" Style="{StaticResource IdeFieldRegistryTabControlStyle}"><TabItem Header="验证问题"><DataGrid Style="{StaticResource IdeFieldRegistryDataGridStyle}" AutoGenerateColumns="False" AutomationProperties.AutomationId="FieldImportPreview.ValidationIssuesGrid" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding Issues}"><DataGrid.Columns><DataGridTextColumn Width="90" Binding="{Binding Severity}" Header="级别" /><DataGridTextColumn Width="150" Binding="{Binding Key}" Header="Key" /><DataGridTextColumn Width="120" Binding="{Binding SourceName}" Header="来源" /><DataGridTextColumn Width="80" Binding="{Binding LineNumber}" Header="行" /><DataGridTextColumn Width="*" Binding="{Binding Message}" Header="消息" /></DataGrid.Columns></DataGrid></TabItem><TabItem Header="解析警告"><DataGrid Style="{StaticResource IdeFieldRegistryDataGridStyle}" AutoGenerateColumns="False" AutomationProperties.AutomationId="FieldImportPreview.ParseWarningsGrid" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding ParseWarnings}"><DataGrid.Columns><DataGridTextColumn Width="160" Binding="{Binding SourceName}" Header="来源" /><DataGridTextColumn Width="90" Binding="{Binding LineNumber}" Header="行" /><DataGridTextColumn Width="*" Binding="{Binding Message}" Header="消息" /></DataGrid.Columns></DataGrid></TabItem></TabControl></TabItem>
            </TabControl>
            <Expander Grid.Row="1" AutomationProperties.AutomationId="FieldImportPreview.AdvancedDetailsExpander" Margin="0,8,0,0" Header="显示高级详情" ToolTip="远程来源、预设与诊断详情" IsExpanded="False" MaxHeight="260" Style="{StaticResource UiExpanderStyle}"><TabControl AutomationProperties.AutomationId="FieldImportPreview.AdvancedDetailsTabs" MinHeight="180" ItemContainerStyle="{StaticResource IdeFieldRegistryTabItemStyle}" Style="{StaticResource IdeFieldRegistryTabControlStyle}">
                <TabItem AutomationProperties.AutomationId="FieldImportPreview.RemoteHistoryTab" Header="远程历史"><DockPanel Margin="8"><WrapPanel DockPanel.Dock="Top"><Button MinWidth="112" AutomationProperties.AutomationId="FieldImportPreview.RefreshRemoteHistoryButton" Margin="0,0,8,6" Padding="12,5" Click="RefreshRemoteHistory" Content="刷新历史" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /><Button MinWidth="112" AutomationProperties.AutomationId="FieldImportPreview.UseCachedTextButton" Margin="0,0,8,6" Padding="12,5" Click="UseCachedText" Content="使用缓存文本" IsEnabled="{Binding CanUseCachedRemoteText}" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /><Button MinWidth="112" AutomationProperties.AutomationId="FieldImportPreview.RefetchSelectedButton" Margin="0,0,8,6" Padding="12,5" Click="RefetchSelected" Content="重新获取所选" IsEnabled="{Binding CanRefetchSelectedHistory}" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /><Button MinWidth="112" AutomationProperties.AutomationId="FieldImportPreview.ClearRemoteHistoryButton" Margin="0,0,8,6" Padding="12,5" Click="ClearRemoteHistory" Content="清空历史" IsEnabled="{Binding CanClearRemoteHistory}" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /></WrapPanel><TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="FieldImportPreview.RemoteHistoryStatusText" Margin="0,8,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding RemoteHistoryStatusText}" TextWrapping="Wrap" /><DataGrid Style="{StaticResource IdeFieldRegistryDataGridStyle}" AutoGenerateColumns="False" AutomationProperties.AutomationId="FieldImportPreview.RemoteHistoryGrid" Margin="0,8,0,0" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding RemoteHistoryEntries}" SelectedItem="{Binding SelectedRemoteHistoryEntry, Mode=TwoWay}"><DataGrid.Columns><DataGridTextColumn Width="160" Binding="{Binding SourceName}" Header="来源" /><DataGridTextColumn Width="*" Binding="{Binding Url}" Header="URL" /><DataGridTextColumn Width="170" Binding="{Binding FetchedAtUtc}" Header="获取时间" /><DataGridTextColumn Width="90" Binding="{Binding ByteCount}" Header="字节数" /></DataGrid.Columns></DataGrid></DockPanel></TabItem>
                <TabItem AutomationProperties.AutomationId="FieldImportPreview.RemotePresetsTab" Header="远程预设"><DockPanel Margin="8"><WrapPanel DockPanel.Dock="Top"><Button MinWidth="112" AutomationProperties.AutomationId="FieldImportPreview.RefreshRemotePresetsButton" Margin="0,0,8,6" Padding="12,5" Click="RefreshRemotePresets" Content="刷新预设" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /><Button MinWidth="112" AutomationProperties.AutomationId="FieldImportPreview.UsePresetUrlButton" Margin="0,0,8,6" Padding="12,5" Click="UsePresetUrl" Content="使用预设 URL" IsEnabled="{Binding CanUsePresetUrl}" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /><Button MinWidth="136" AutomationProperties.AutomationId="FieldImportPreview.FetchSelectedPresetButton" Margin="0,0,8,6" Padding="12,5" Click="FetchSelectedPreset" Content="获取所选预设" IsEnabled="{Binding CanFetchSelectedPreset}" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /><Button MinWidth="96" AutomationProperties.AutomationId="FieldImportPreview.AddPresetButton" Margin="0,0,8,6" Padding="12,5" Click="AddPreset" Content="新增预设" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /><Button MinWidth="96" AutomationProperties.AutomationId="FieldImportPreview.EditPresetButton" Margin="0,0,8,6" Padding="12,5" Click="EditPreset" Content="编辑预设" IsEnabled="{Binding CanEditSelectedPreset}" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /><Button MinWidth="112" AutomationProperties.AutomationId="FieldImportPreview.RemovePresetButton" Margin="0,0,8,6" Padding="12,5" Click="RemovePreset" Content="移除预设" IsEnabled="{Binding CanRemoveSelectedPreset}" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /><Button MinWidth="112" AutomationProperties.AutomationId="FieldImportPreview.ImportPresetsButton" Margin="0,0,8,6" Padding="12,5" Click="ImportPresets" Content="导入预设" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /><Button MinWidth="112" AutomationProperties.AutomationId="FieldImportPreview.ExportPresetsButton" Margin="0,0,8,6" Padding="12,5" Click="ExportPresets" Content="导出预设" IsEnabled="{Binding CanExportPresets}" Style="{StaticResource IdeFieldRegistryCommandButtonStyle}" /></WrapPanel><TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="FieldImportPreview.RemotePresetStatusText" Margin="0,8,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding RemotePresetStatusText}" TextWrapping="Wrap" /><DataGrid Style="{StaticResource IdeFieldRegistryDataGridStyle}" AutoGenerateColumns="False" AutomationProperties.AutomationId="FieldImportPreview.RemotePresetsGrid" Margin="0,8,0,0" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding RemotePresets}" SelectedItem="{Binding SelectedRemotePreset, Mode=TwoWay}"><DataGrid.Columns><DataGridTextColumn Width="150" Binding="{Binding Name}" Header="名称" /><DataGridTextColumn Width="2*" Binding="{Binding Url}" Header="URL" /><DataGridTextColumn Width="150" Binding="{Binding TagsText}" Header="标签" /><DataGridCheckBoxColumn Width="80" Binding="{Binding IsEnabled}" Header="启用" /><DataGridTextColumn Width="170" Binding="{Binding UpdatedAtUtc}" Header="更新时间" /><DataGridTextColumn Width="*" Binding="{Binding Description}" Header="说明" /></DataGrid.Columns></DataGrid></DockPanel></TabItem>
                <TabItem AutomationProperties.AutomationId="FieldImportPreview.CurrentIniDraftsTab" Header="当前 INI 草稿"><DataGrid Style="{StaticResource IdeFieldRegistryDataGridStyle}" AutoGenerateColumns="False" AutomationProperties.AutomationId="FieldImportPreview.CurrentIniDraftsGrid" CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding CurrentIniDraftRows}"><DataGrid.Columns><DataGridCheckBoxColumn Width="72" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="使用" /><DataGridTextColumn Width="150" Binding="{Binding Key}" Header="Key" IsReadOnly="True" /><DataGridTextColumn Width="110" Binding="{Binding SectionKind}" Header="Section" IsReadOnly="True" /><DataGridTextColumn Width="110" Binding="{Binding EditorKind}" Header="编辑器" IsReadOnly="True" /><DataGridTextColumn Width="110" Binding="{Binding ValueKind}" Header="值类型" IsReadOnly="True" /><DataGridTextColumn Width="110" Binding="{Binding BooleanStyle}" Header="布尔" IsReadOnly="True" /><DataGridTextColumn Width="80" Binding="{Binding OccurrenceCount}" Header="次数" IsReadOnly="True" /><DataGridTextColumn Width="180" Binding="{Binding SampleValueSummary}" Header="样例" IsReadOnly="True" /><DataGridTextColumn Width="220" Binding="{Binding AllowedValuesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Header="允许值" /><DataGridTextColumn Width="*" Binding="{Binding IssueSummary}" Header="问题" IsReadOnly="True" /></DataGrid.Columns></DataGrid></TabItem>
                <TabItem AutomationProperties.AutomationId="FieldImportPreview.GeneralizationTab" Header="字段归纳摘要"><DataGrid Style="{StaticResource IdeFieldRegistryDataGridStyle}" AutoGenerateColumns="False" AutomationProperties.AutomationId="FieldImportPreview.GeneralizationGrid" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding GeneralizationMessages}"><DataGrid.Columns><DataGridTextColumn Width="90" Binding="{Binding Severity}" Header="级别" /><DataGridTextColumn Width="160" Binding="{Binding Key}" Header="Key" /><DataGridTextColumn Width="110" Binding="{Binding TargetKind}" Header="目标" /><DataGridTextColumn Width="240" Binding="{Binding SourceKinds}" Header="合并来源" /><DataGridTextColumn Width="*" Binding="{Binding Message}" Header="消息" /></DataGrid.Columns></DataGrid></TabItem>
                <TabItem AutomationProperties.AutomationId="FieldImportPreview.ParsedFieldsTab" Header="已解析字段"><DataGrid Style="{StaticResource IdeFieldRegistryDataGridStyle}" AutoGenerateColumns="False" AutomationProperties.AutomationId="FieldImportPreview.ParsedFieldsGrid" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding Candidates}"><DataGrid.Columns><DataGridTextColumn Width="160" Binding="{Binding Key}" Header="Key" /><DataGridTextColumn Width="130" Binding="{Binding AppliesToRaw}" Header="原始适用对象" /><DataGridTextColumn Width="120" Binding="{Binding EditorKindRaw}" Header="原始编辑器类型" /><DataGridTextColumn Width="100" Binding="{Binding Confidence}" Header="置信度" /><DataGridTextColumn Width="*" Binding="{Binding SourceName}" Header="来源" /><DataGridTextColumn Width="70" Binding="{Binding LineNumber}" Header="行" /></DataGrid.Columns></DataGrid></TabItem>
                <TabItem AutomationProperties.AutomationId="FieldImportPreview.FieldDraftsTab" Header="字段草稿 JSON"><DataGrid Style="{StaticResource IdeFieldRegistryDataGridStyle}" AutoGenerateColumns="False" AutomationProperties.AutomationId="FieldImportPreview.FieldDraftsGrid" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding Definitions}"><DataGrid.Columns><DataGridTextColumn Width="160" Binding="{Binding Key}" Header="Key" /><DataGridTextColumn Width="170" Binding="{Binding AppliesTo}" Header="适用对象" /><DataGridTextColumn Width="120" Binding="{Binding EditorKind}" Header="编辑器类型" /><DataGridTextColumn Width="120" Binding="{Binding SourceKind}" Header="来源类型" /><DataGridTextColumn Width="*" Binding="{Binding Description}" Header="说明" /></DataGrid.Columns></DataGrid></TabItem>
                <TabItem AutomationProperties.AutomationId="FieldImportPreview.RawTextPreviewTab" Header="远程内容预览"><TextBox Margin="8" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" Text="{Binding RawText, Mode=OneWay}" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" /></TabItem>
            </TabControl></Expander>
        </Grid>
        <TextBlock Grid.Row="5" AutomationProperties.AutomationId="FieldImportPreview.StatusText" Margin="0,10,0,0" Foreground="{StaticResource ShellMutedTextBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" />
    </Grid>
</Window>
