<UserControl x:Class="RA2IniEditor.IDE.Views.AI.Ra2AiEditProposalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="AiAssistant.EditProposalCard"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Border Margin="0,6,0,2"
            Padding="8"
            Background="{DynamicResource UiSurfaceBrush}"
            BorderBrush="{DynamicResource UiDividerBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource UiCornerSmall}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource IdeWorkspaceSectionTitleStyle}" />
                <Border Grid.Column="1"
                        Padding="6,2"
                        Background="{DynamicResource UiAccentSoftBrush}"
                        CornerRadius="{StaticResource UiCornerSmall}">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource UiAccentBrush}"
                               FontSize="{StaticResource UiFontSizeMetadata}"
                               AutomationProperties.AutomationId="AiAssistant.EditProposalCard.Status" />
                </Border>
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,6,0,5"
                       Text="{Binding Summary}"
                       Style="{StaticResource IdeAiMessageTextStyle}"
                       MaxHeight="54"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="AiAssistant.EditProposalCard.Summary" />

            <TextBlock Grid.Row="2"
                       Margin="0,0,0,3"
                       Text="{Binding ProjectSummary}"
                       Visibility="{Binding IsProject, Converter={StaticResource BoolToVisibilityConverter}}"
                       Style="{StaticResource IdeAiMetadataTextStyle}"
                       AutomationProperties.AutomationId="AiAssistant.EditProposalCard.ProjectSummary" />

            <TextBlock Grid.Row="3"
                       Margin="0,0,0,3"
                       Text="{Binding AssetManifestSummary}"
                       Visibility="{Binding IsProject, Converter={StaticResource BoolToVisibilityConverter}}"
                       Style="{StaticResource IdeAiMetadataTextStyle}"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="AiAssistant.EditProposalCard.AssetManifestSummary" />

            <ListBox Grid.Row="4"
                     MaxHeight="240"
                     Padding="0"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemsSource="{Binding Operations}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.AutomationId="AiAssistant.EditProposalCard.OperationList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0,6"
                                BorderBrush="{DynamicResource UiDividerBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Margin="0,0,7,0"
                                               Text="{Binding ActionText}"
                                               Foreground="{DynamicResource UiAccentBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TargetText}"
                                               Foreground="{DynamicResource UiTextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding ChangeText}"
                                           Style="{StaticResource IdeAiMessageTextStyle}" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding EvidenceText}"
                                           Style="{StaticResource IdeAiMetadataTextStyle}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="5" Margin="0,6,0,0">
                <TextBlock Text="{Binding RiskSummary}"
                           Style="{StaticResource IdeAiMetadataTextStyle}"
                           AutomationProperties.AutomationId="AiAssistant.EditProposalCard.DiagnosticSummary" />
                <TextBlock Margin="0,3,0,0"
                           Text="{Binding ResultMessage}"
                           Style="{StaticResource IdeAiMetadataTextStyle}"
                           AutomationProperties.AutomationId="AiAssistant.EditProposalCard.ResultMessage" />
            </StackPanel>

            <WrapPanel Grid.Row="6"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Right">
                <Button Margin="0,0,6,0"
                        Content="查看更改"
                        IsEnabled="{Binding IsDismissEnabled}"
                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}"
                        Click="OpenDiffButton_OnClick"
                        AutomationProperties.AutomationId="AiAssistant.EditProposalCard.OpenDiffButton"
                        AutomationProperties.Name="在主工作区查看更改" />
                <Button Margin="0,0,6,0"
                        Content="{Binding ApplyButtonText}"
                        IsEnabled="{Binding IsApplyEnabled}"
                        Style="{StaticResource IdeBlueCompactButtonStyle}"
                        Click="ApplyButton_OnClick"
                        AutomationProperties.AutomationId="AiAssistant.EditProposalCard.ApplyButton"
                        AutomationProperties.Name="应用 AI 修改建议" />
                <Button Content="忽略"
                        IsEnabled="{Binding IsDismissEnabled}"
                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}"
                        Click="DismissButton_OnClick"
                        AutomationProperties.AutomationId="AiAssistant.EditProposalCard.DismissButton"
                        AutomationProperties.Name="忽略 AI 修改建议" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
