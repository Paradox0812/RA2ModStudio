<UserControl x:Class="RA2IniEditor.IDE.Views.Language.Ra2CompletionDropdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Ra2CompletionDropdown.View">
    <Border Width="520"
            MaxHeight="220"
            Style="{StaticResource IdeAssistPopupFrameStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border AutomationProperties.AutomationId="Ra2CompletionDropdown.Header"
                    Style="{StaticResource IdeAssistPopupHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IdeAssistTitleTextStyle}"
                               Text="补全建议" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource IdeAssistMetadataTextStyle}"
                               Text="名称  ·  类型  ·  说明  ·  来源" />
                </Grid>
            </Border>

            <ListBox x:Name="ItemsList"
                     Grid.Row="1"
                     AutomationProperties.AutomationId="Ra2CompletionDropdown.ItemsList"
                     MaxHeight="188"
                     ItemsSource="{Binding Items}"
                     ItemContainerStyle="{StaticResource IdeAssistCompletionItemStyle}"
                     MouseDoubleClick="ItemsList_OnMouseDoubleClick"
                     PreviewKeyDown="ItemsList_OnPreviewKeyDown"
                     PreviewMouseDown="ItemsList_OnPreviewMouseDown"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource IdeAssistCompletionListStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="9,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource IdeAssistCompletionPrimaryTextStyle}"
                                       Text="{Binding Label}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource IdeAssistMetadataTextStyle}"
                                       Text="{Binding TypeDisplay}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource IdeAssistMetadataTextStyle}"
                                       Text="{Binding AnnotationText}" />
                            <Border Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource IdeAssistBadgeStyle}">
                                <TextBlock MaxWidth="80"
                                           Style="{StaticResource IdeAssistBadgeTextStyle}"
                                           Text="{Binding SourceDisplayText}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
