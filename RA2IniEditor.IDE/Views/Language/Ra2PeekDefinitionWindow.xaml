<Window x:Class="RA2IniEditor.IDE.Views.Language.Ra2PeekDefinitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="Ra2PeekDefinition.Window"
        Title="查看定义"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_OnKeyDown"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Border Style="{StaticResource IdeAssistPopupFrameStyle}">
        <Grid Width="500" Style="{StaticResource IdeAssistInspectorRootStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource IdeAssistInspectorHeaderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock AutomationProperties.AutomationId="Ra2PeekDefinition.TitleText"
                               Margin="0,2,8,0"
                               Style="{StaticResource IdeAssistTitleTextStyle}"
                               Text="{Binding Title}" />
                    <Button AutomationProperties.AutomationId="Ra2PeekDefinition.CloseButton"
                            AutomationProperties.Name="关闭"
                            Grid.Column="1"
                            Click="CloseButton_OnClick"
                            Style="{StaticResource IdeAssistIconButtonStyle}"
                            ToolTip="关闭">
                        <Path Width="9"
                              Height="9"
                              Data="M 0,0 L 9,9 M 9,0 L 0,9"
                              SnapsToDevicePixels="True"
                              Stroke="{StaticResource UiTextSecondaryBrush}"
                              StrokeThickness="1.2" />
                    </Button>
                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0">
                        <Border Style="{StaticResource IdeAssistAccentBadgeStyle}">
                            <TextBlock Style="{StaticResource IdeAssistBadgeTextStyle}" Text="{Binding Kind}" />
                        </Border>
                        <Border Style="{StaticResource IdeAssistBadgeStyle}">
                            <TextBlock Style="{StaticResource IdeAssistBadgeTextStyle}" Text="{Binding LineText}" />
                        </Border>
                        <Border Style="{StaticResource IdeAssistBadgeStyle}">
                            <TextBlock AutomationProperties.AutomationId="Ra2PeekDefinition.SourceText"
                                       Style="{StaticResource IdeAssistBadgeTextStyle}"
                                       Text="{Binding SourceName}" />
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          AutomationProperties.AutomationId="Ra2PeekDefinition.ContentScrollViewer"
                          MaxHeight="410"
                          Margin="10"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock AutomationProperties.AutomationId="Ra2PeekDefinition.DetailText"
                               Margin="2,0,2,2"
                               Style="{StaticResource IdeAssistMutedTextStyle}"
                               Text="{Binding Detail}" />

                    <Border Style="{StaticResource IdeAssistSectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource IdeAssistSectionTitleStyle}" Text="说明" />
                            <TextBlock Style="{StaticResource IdeAssistBodyTextStyle}" Text="{Binding Description}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource IdeAssistSectionStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource IdeAssistSectionTitleStyle}" Text="来源" />
                            <TextBlock Style="{StaticResource IdeAssistPathTextStyle}"
                                       Text="{Binding SourcePath}"
                                       ToolTip="{Binding SourcePath}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
