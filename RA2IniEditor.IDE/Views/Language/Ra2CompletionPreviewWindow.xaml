<Window x:Class="RA2IniEditor.IDE.Views.Language.Ra2CompletionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="Ra2CompletionPreview.Window"
        Title="补全预览"
        Width="760"
        Height="560"
        MinWidth="560"
        MinHeight="360"
        Background="{StaticResource UiCanvasBrush}">
    <Border Style="{StaticResource IdeAssistDialogRootStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource IdeAssistToolWindowHeaderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource IdeAssistTitleTextStyle}"
                               Text="补全候选诊断" />
                    <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                        <Border Style="{StaticResource IdeAssistAccentBadgeStyle}">
                            <TextBlock AutomationProperties.AutomationId="Ra2CompletionPreview.CountText"
                                       Style="{StaticResource IdeAssistBadgeTextStyle}"
                                       Text="{Binding CountText}" />
                        </Border>
                        <TextBlock AutomationProperties.AutomationId="Ra2CompletionPreview.ReplacementText"
                                   Margin="4,2,0,0"
                                   Style="{StaticResource IdeAssistMetadataTextStyle}"
                                   Text="{Binding ReplacementText}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl AutomationProperties.AutomationId="Ra2CompletionPreview.ItemsGrid"
                              ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Style="{StaticResource IdeAssistDialogCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource IdeAssistSectionTitleStyle}"
                                               Text="{Binding Name}" />
                                    <DataGrid Grid.Row="1"
                                              MaxHeight="240"
                                              Margin="0,4,0,0"
                                              AutoGenerateColumns="False"
                                              HeadersVisibility="Column"
                                              IsReadOnly="True"
                                              ItemsSource="{Binding Items}"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              Style="{StaticResource IdeAssistDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="1.4*" Binding="{Binding Label}" Header="名称" />
                                            <DataGridTextColumn Width="110" Binding="{Binding SourceDisplayText}" Header="来源" />
                                            <DataGridCheckBoxColumn Width="70" Binding="{Binding IsFallback}" Header="回退" />
                                            <DataGridTextColumn Width="1.4*" Binding="{Binding Detail}" Header="详情" />
                                            <DataGridTextColumn Width="1.8*" Binding="{Binding Documentation}" Header="说明" />
                                            <DataGridTextColumn Width="1.2*" Binding="{Binding InsertText}" Header="插入文本" />
                                            <DataGridTextColumn Width="64" Binding="{Binding Priority}" Header="优先级" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Style="{StaticResource IdeAssistStatusBarStyle}">
                <TextBlock AutomationProperties.AutomationId="Ra2CompletionPreview.StatusText"
                           Style="{StaticResource IdeAssistMetadataTextStyle}"
                           Text="{Binding StatusText}" />
            </Border>
        </Grid>
    </Border>
</Window>
