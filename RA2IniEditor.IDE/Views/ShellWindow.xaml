<Window x:Class="RA2IniEditor.IDE.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalondock="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:languageViews="clr-namespace:RA2IniEditor.IDE.Views.Language"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:RA2IniEditor.IDE.Views"
        xmlns:viewModels="clr-namespace:RA2IniEditor.IDE.ViewModels"
        AutomationProperties.AutomationId="Shell.Window"
        Title="{Binding Title}"
        Icon="/Assets/AppIcon.ico"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource UiCanvasBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.DataContext>
        <viewModels:ShellViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Internal ScrollViewer/ToolTip instances are scoped to the Shell; no app-wide implicit adoption. -->
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource UiScrollBarStyle}" />
        <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource UiToolTipStyle}" />
        <Style x:Key="ShellProjectExplorerTreeItemStyle"
               TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource UiTreeViewItemStyle}">
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayTextWithCount}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="ItemContainerStyle" Value="{DynamicResource ShellProjectExplorerTreeItemStyle}" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                AutomationProperties.AutomationId="Shell.TitleBar"
                AutomationProperties.Name="主窗口标题栏"
                Grid.ColumnSpan="3"
                BorderBrush="{DynamicResource UiDividerBrush}"
                Style="{StaticResource IdeShellTitleBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ShellTitleBarSystemMenuButton"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="Shell.TitleBar.SystemMenuButton"
                        AutomationProperties.Name="系统菜单"
                        Click="ShellTitleBarSystemMenuButton_OnClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource IdeShellSystemMenuButtonStyle}"
                        ToolTip="系统菜单">
                    <Image Width="16" Height="16" Source="/Assets/AppIcon.ico" />
                </Button>

                <Menu Grid.Column="1"
                      AutomationProperties.AutomationId="Shell.MainMenu"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      Style="{StaticResource IdeMainMenuStyle}">
                    <MenuItem Header="文件">
                        <MenuItem AutomationProperties.AutomationId="Shell.Menu.OpenFolder"
                                  Header="打开项目..."
                                  Click="OpenProjectFolder" />
                        <MenuItem Header="保存当前文件"
                                  Click="SaveCurrentFile_OnClick" />
                        <Separator />
                        <MenuItem Header="退出"
                                  Click="CloseShell_OnClick" />
                    </MenuItem>
                    <MenuItem Header="编辑">
                        <MenuItem Header="撤销"
                                  Click="UndoCurrentFile_OnClick" />
                        <MenuItem Header="重做"
                                  Click="RedoCurrentFile_OnClick" />
                        <MenuItem Header="放弃内存修改"
                                  Click="RevertInMemoryChanges_OnClick" />
                        <Separator />
                        <MenuItem Header="添加属性..."
                                  Click="AddProperty_OnClick" />
                        <MenuItem Header="显示补全候选"
                                  Click="ShowCompletionPreview_OnClick" />
                    </MenuItem>
                    <MenuItem Header="视图">
                        <MenuItem AutomationProperties.AutomationId="Shell.Menu.ToggleProjectExplorer"
                                  Header="项目浏览器"
                                  Click="ToggleProjectExplorer" />
                        <MenuItem AutomationProperties.AutomationId="Shell.Menu.OpenAiAssistant"
                                  Header="AI 助手"
                                  Click="OpenAiAssistantInRightToolWell" />
                        <MenuItem AutomationProperties.AutomationId="Shell.Menu.Issues"
                                  Header="问题"
                                  Click="FocusIssuesToolTab" />
                        <MenuItem Header="输出"
                                  Click="FocusOutputToolTab" />
                        <MenuItem Header="查找"
                                  Click="FocusSearchResultsToolTab" />
                        <MenuItem AutomationProperties.AutomationId="Shell.View.ToggleBottomToolPanelMenuItem"
                                  Header="底部记录栏"
                                  Click="ToggleBottomToolPanel" />
                        <MenuItem AutomationProperties.AutomationId="Shell.Menu.WindowLayout"
                                  Header="窗口布局">
                            <MenuItem AutomationProperties.AutomationId="Shell.Menu.WindowLayout.ReturnFloatingToolsHome"
                                      Header="将浮动窗口全部归位"
                                      Click="ReturnFloatingToolsHome_OnClick" />
                            <MenuItem AutomationProperties.AutomationId="Shell.Menu.WindowLayout.ResetDefaultLayout"
                                      Header="恢复默认布局"
                                      Click="ResetDefaultDockLayout_OnClick" />
                        </MenuItem>
                        <Separator />
                        <MenuItem AutomationProperties.AutomationId="Shell.Menu.FieldRegistryCenter"
                                  Header="字段库中心"
                                  Click="OpenFieldRegistryManagerWindow" />
                    </MenuItem>
                    <MenuItem Header="搜索">
                        <MenuItem AutomationProperties.AutomationId="Shell.Menu.Search"
                                  Header="查找"
                                  Click="OpenSearchToolWindow" />
                        <MenuItem Header="查找当前文件引用"
                                  Click="FindAllReferences_OnClick" />
                        <MenuItem Header="转到定义"
                                  Click="GoToDefinition_OnClick" />
                        <MenuItem Header="预览定义"
                                  Click="PeekDefinition_OnClick" />
                    </MenuItem>
                    <MenuItem Header="项目">
                        <MenuItem Header="重新加载项目"
                                  IsEnabled="False" />
                        <MenuItem Header="打开项目目录"
                                  IsEnabled="False" />
                    </MenuItem>
                    <MenuItem Header="字段库">
                        <MenuItem Header="字段库中心"
                                  Click="OpenFieldRegistryManagerWindow" />
                        <MenuItem Header="从当前字段添加"
                                  Click="AddProperty_OnClick" />
                        <MenuItem AutomationProperties.AutomationId="Shell.FieldRegistry.LearnFromCurrentSectionMenuItem"
                                  Header="从当前对象学习字段"
                                  Click="OpenFieldLearningFromCurrentSection" />
                        <MenuItem AutomationProperties.AutomationId="Shell.FieldRegistry.LearnFromCurrentIniMenuItem"
                                  Header="从当前 INI 学习字段"
                                  Click="OpenFieldLearningFromCurrentIni" />
                        <Separator />
                        <MenuItem Header="导入字段说明"
                                  IsEnabled="False" />
                        <MenuItem Header="高级字段库工具"
                                  Click="OpenAdvancedFieldRegistryToolsWindow" />
                        <MenuItem Header="重新加载字段库"
                                  Click="ReloadFieldRegistryFromShell" />
                    </MenuItem>
                    <MenuItem Header="问题">
                        <MenuItem Header="打开问题"
                                  Click="FocusIssuesToolTab" />
                        <MenuItem Header="刷新当前文件检查"
                                  Click="RefreshCurrentFileDiagnosticsFromShell" />
                        <MenuItem Header="运行全量诊断"
                                  Click="RunManualFullDiagnosticsFromShell" />
                        <MenuItem Header="清空问题"
                                  Click="ClearIssuesFromShell" />
                    </MenuItem>
                    <MenuItem Header="工具">
                        <MenuItem Header="选项"
                                  IsEnabled="False" />
                        <MenuItem Header="打开日志目录"
                                  IsEnabled="False" />
                    </MenuItem>
                    <MenuItem Header="帮助"
                              IsEnabled="False" />
                </Menu>

                <Border x:Name="ShellTitleBarDragRegion"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="Shell.TitleBar.DragRegion"
                        AutomationProperties.Name="窗口拖动区域"
                        Background="Transparent" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="Shell.TitleBar.MinimizeButton"
                            AutomationProperties.Name="最小化"
                            Click="ShellTitleBarMinimizeButton_OnClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource IdeShellCaptionButtonStyle}"
                            ToolTip="最小化">
                        <Path Width="10" Height="1" Data="M 0,0.5 L 10,0.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" />
                    </Button>
                    <Button x:Name="ShellTitleBarMaximizeRestoreButton"
                            AutomationProperties.AutomationId="Shell.TitleBar.MaximizeRestoreButton"
                            AutomationProperties.Name="最大化"
                            Click="ShellTitleBarMaximizeRestoreButton_OnClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource IdeShellCaptionButtonStyle}"
                            ToolTip="最大化">
                        <Grid Width="12" Height="12">
                            <Border Width="10" Height="10"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border Width="8" Height="8" Margin="0,3,3,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Background="{StaticResource ShellTopChromeBrush}"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        BorderThickness="1" />
                                <Border Width="8" Height="8" Margin="3,0,0,3"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        BorderThickness="1" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button AutomationProperties.AutomationId="Shell.TitleBar.CloseButton"
                            AutomationProperties.Name="关闭"
                            Click="ShellTitleBarCloseButton_OnClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource IdeShellCloseCaptionButtonStyle}"
                            ToolTip="关闭">
                        <Path Width="10" Height="10" Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.ColumnSpan="3"
                AutomationProperties.AutomationId="Shell.MainToolbar"
                Style="{StaticResource IdeMainToolbarStyle}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="Shell.MainToolbar.OpenFolderButton"
                            AutomationProperties.Name="打开目录"
                            Click="OpenProjectFolder"
                            Content="{StaticResource IconOpenFolder}"
                            Style="{StaticResource IdePrimaryIconCommandButtonStyle}"
                            ToolTip="打开项目目录" />
                    <Border Style="{StaticResource IdeCommandSeparatorStyle}" />
                    <Button x:Name="SaveCurrentFileButton"
                            AutomationProperties.AutomationId="Shell.SourceEditor.SaveCurrentFileButton"
                            AutomationProperties.Name="保存"
                            Click="SaveCurrentFile_OnClick"
                            Content="{StaticResource IconSave}"
                            Style="{StaticResource IdeIconCommandButtonStyle}"
                            ToolTip="保存当前文件" />
                    <Button x:Name="UndoCurrentFileButton"
                            AutomationProperties.AutomationId="Shell.SourceEditor.UndoButton"
                            AutomationProperties.Name="撤销"
                            Click="UndoCurrentFile_OnClick"
                            Content="{StaticResource IconUndo}"
                            Style="{StaticResource IdeIconCommandButtonStyle}"
                            ToolTip="撤销上一步编辑" />
                    <Button x:Name="RedoCurrentFileButton"
                            AutomationProperties.AutomationId="Shell.SourceEditor.RedoButton"
                            AutomationProperties.Name="重做"
                            Click="RedoCurrentFile_OnClick"
                            Content="{StaticResource IconRedo}"
                            Style="{StaticResource IdeIconCommandButtonStyle}"
                            ToolTip="重做上一步撤销" />
                    <Button x:Name="RevertInMemoryChangesButton"
                            AutomationProperties.AutomationId="Shell.SourceEditor.RevertInMemoryChangesButton"
                            AutomationProperties.Name="放弃修改"
                            Click="RevertInMemoryChanges_OnClick"
                            Content="{StaticResource IconRevert}"
                            Style="{StaticResource IdeIconCommandButtonStyle}"
                            ToolTip="放弃当前未保存修改" />
                    <Button x:Name="EnterEditModeButton"
                            AutomationProperties.AutomationId="Shell.SourceEditor.EnterEditModeButton"
                            AutomationProperties.Name="进入编辑模式"
                            Visibility="Collapsed"
                            Click="EnterEditMode_OnClick"
                            Content="{StaticResource IconEditMode}"
                            Style="{StaticResource IdeIconCommandButtonStyle}"
                            ToolTip="进入编辑模式" />
                    <Border Style="{StaticResource IdeCommandSeparatorStyle}" />
                    <Button AutomationProperties.AutomationId="Shell.MainToolbar.SearchButton"
                            AutomationProperties.Name="搜索"
                            Click="OpenSearchToolWindow"
                            Content="{StaticResource IconSearch}"
                            Style="{StaticResource IdeIconCommandButtonStyle}"
                            ToolTip="搜索当前项目" />
                    <Button AutomationProperties.AutomationId="Shell.MainToolbar.FieldRegistryButton"
                            AutomationProperties.Name="字段库"
                            Click="OpenFieldRegistryManagerWindow"
                            Content="{StaticResource IconFieldRegistry}"
                            Style="{StaticResource IdeIconCommandButtonStyle}"
                            ToolTip="打开字段库中心" />
                    <Button AutomationProperties.AutomationId="Shell.MainToolbar.IssuesButton"
                            AutomationProperties.Name="问题"
                            Click="FocusIssuesToolTab"
                            Content="{StaticResource IconIssues}"
                            Style="{StaticResource IdeIconCommandButtonStyle}"
                            ToolTip="显示问题面板" />
                    <Button AutomationProperties.AutomationId="Shell.MainToolbar.ProjectExplorerButton"
                            AutomationProperties.Name="项目浏览器"
                            Click="ToggleProjectExplorer"
                            Content="{StaticResource IconProjectExplorer}"
                            Style="{StaticResource IdeIconCommandButtonStyle}"
                            ToolTip="显示项目浏览器" />
                    <Button x:Name="WindowLayoutButton"
                            AutomationProperties.AutomationId="Shell.MainToolbar.WindowLayoutButton"
                            AutomationProperties.Name="窗口布局"
                            Click="OpenWindowLayoutMenu_OnClick"
                            Style="{StaticResource IdeIconCommandButtonStyle}"
                            ToolTip="窗口布局">
                        <Button.Content>
                            <Grid Width="16" Height="16" SnapsToDevicePixels="True">
                                <Path Data="M 1.5,2.5 L 14.5,2.5 L 14.5,12.5 L 1.5,12.5 Z M 9.5,2.5 L 9.5,12.5 M 1.5,7.5 L 9.5,7.5"
                                      Stroke="{DynamicResource ShellPrimaryTextBrush}"
                                      StrokeLineJoin="Miter"
                                      StrokeThickness="1.2" />
                                <Path Data="M 11,13 L 13,15 L 15,13"
                                      Stroke="{DynamicResource ShellPrimaryTextBrush}"
                                      StrokeEndLineCap="Square"
                                      StrokeStartLineCap="Square"
                                      StrokeThickness="1.1" />
                            </Grid>
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu AutomationProperties.AutomationId="Shell.WindowLayout.Menu"
                                         Style="{StaticResource UiContextMenuStyle}"
                                         Placement="Bottom">
                                <MenuItem AutomationProperties.AutomationId="Shell.WindowLayout.ReturnFloatingToolsHome"
                                          Header="将浮动窗口全部归位"
                                          Click="ReturnFloatingToolsHome_OnClick" />
                                <Separator />
                                <MenuItem AutomationProperties.AutomationId="Shell.WindowLayout.ResetDefaultLayout"
                                          Header="恢复默认布局"
                                          Click="ResetDefaultDockLayout_OnClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="EditorStateTextBlock"
                           AutomationProperties.AutomationId="Shell.SourceEditor.EditorStateText"
                           Visibility="Collapsed" />
                <TextBlock x:Name="EditorSaveHintTextBlock"
                           AutomationProperties.AutomationId="Shell.SourceEditor.SaveHintText"
                           Visibility="Collapsed" />
            </DockPanel>
        </Border>

        <avalondock:DockingManager x:Name="ShellDockManager"
                                   Grid.Row="2"
                                   AutomationProperties.AutomationId="Shell.DockManager"
                                   AnchorableHiding="ShellDockManager_OnAnchorableHiding"
                                   AnchorableHeaderTemplate="{StaticResource IdeDockAnchorableHeaderTemplate}"
                                   AnchorablePaneControlStyle="{StaticResource IdeDockAnchorablePaneControlStyle}"
                                   AnchorableTitleTemplate="{StaticResource IdeDockAnchorableTitleTemplate}"
                                   AllowMixedOrientation="True"
                                   Background="{DynamicResource ShellPanelBrush}"
                                   BorderBrush="{DynamicResource ShellBorderBrush}"
                                   DocumentHeaderTemplate="{StaticResource IdeDockDocumentHeaderTemplate}"
                                   Foreground="{DynamicResource ShellPrimaryTextBrush}"
                                   GridSplitterHeight="4"
                                   GridSplitterHorizontalStyle="{StaticResource IdeDockSplitterStyle}"
                                   GridSplitterWidth="4"
                                   GridSplitterVerticalStyle="{StaticResource IdeDockSplitterStyle}"
                                   IsVirtualizingAnchorable="True"
                                   IsVirtualizingDocument="False">
            <avalondock:LayoutRoot>
                <avalondock:LayoutPanel x:Name="ShellRootDockLayout" Orientation="Horizontal">
                    <avalondock:LayoutPanel x:Name="EditorDockLayout" DockWidth="*" Orientation="Vertical">
                        <avalondock:LayoutDocumentPaneGroup DockHeight="*" Orientation="Horizontal">
                            <avalondock:LayoutDocumentPane ShowHeader="False">
                                <avalondock:LayoutDocument x:Name="SourceDocumentAnchorable"
                                                           CanClose="False"
                                                           CanFloat="False"
                                                           CanMove="False"
                                                           ContentId="Document.Source"
                                                           Title="{Binding SourceEditor.DocumentTitle}">
                                    <avalondock:LayoutDocument.Content>
                                        <Border AutomationProperties.AutomationId="Shell.EditorColumn"
                                        Margin="0"
                                        Style="{StaticResource IdeDockPanelStyle}">
                                        <Grid>
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        
                                        <Border AutomationProperties.AutomationId="Shell.SourceEditor.DocumentTabStrip"
                                        Grid.Row="0"
                                        HorizontalAlignment="Stretch">
                                        <Border.Style>
                                        <Style BasedOn="{StaticResource IdeDocumentTabStripStyle}"
                                        TargetType="Border">
                                        <Style.Triggers>
                                        <DataTrigger Binding="{Binding SourceEditor.DocumentTitle}"
                                        Value="未选择文件">
                                        <Setter Property="Visibility"
                                        Value="Collapsed" />
                                        </DataTrigger>
                                        </Style.Triggers>
                                        </Style>
                                        </Border.Style>
                                        <Border AutomationProperties.AutomationId="Shell.SourceEditor.DocumentTab"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource IdeDocumentTabStyle}"
                                        ToolTip="{Binding StatusCurrentFileText}">
                                        <DockPanel LastChildFill="True">
                                        <TextBlock AutomationProperties.AutomationId="Shell.SourceEditor.DocumentDirtyMarker"
                                        DockPanel.Dock="Left"
                                        Style="{StaticResource IdeDocumentDirtyMarkerStyle}"
                                        ToolTip="{Binding StatusDirtyStateText}" />
                                        <TextBlock AutomationProperties.AutomationId="Shell.SourceEditor.DocumentTabTitle"
                                        Style="{StaticResource IdeDocumentTabTitleTextStyle}"
                                        Text="{Binding SourceEditor.DocumentTitle}" />
                                        </DockPanel>
                                        </Border>
                                        </Border>
                                        
                                        <avalonedit:TextEditor x:Name="SourceTextEditor"
                                        AutomationProperties.AutomationId="Shell.SourceEditor"
                                        Grid.Row="1"
                                        Margin="0"
                                        FontFamily="Consolas"
                                        FontSize="13"
                                        Foreground="{StaticResource ShellPrimaryTextBrush}"
                                        Background="{StaticResource ShellPanelBrush}"
                                        BorderBrush="{StaticResource ShellBorderBrush}"
                                        BorderThickness="0"
                                        HorizontalScrollBarVisibility="Auto"
                                        IsReadOnly="True"
                                        KeyboardNavigation.TabNavigation="None"
                                        LostKeyboardFocus="SourceTextEditor_OnLostKeyboardFocus"
                                        Padding="8"
                                        PreviewKeyDown="SourceTextEditor_OnPreviewKeyDown"
                                        PreviewMouseRightButtonDown="SourceTextEditor_OnPreviewMouseRightButtonDown"
                                        ShowLineNumbers="True"
                                        TextChanged="SourceTextEditor_OnTextChanged"
                                        VerticalScrollBarVisibility="Auto"
                                        WordWrap="False">
                                        <avalonedit:TextEditor.ContextMenu>
                                        <ContextMenu AutomationProperties.AutomationId="Shell.SourceEditor.ContextMenu"
                                        Style="{StaticResource UiContextMenuStyle}"
                                        Opened="SourceEditorContextMenu_OnOpened">
                                        <MenuItem AutomationProperties.AutomationId="Shell.SourceEditor.GoToDefinitionMenuItem"
                                        Click="GoToDefinition_OnClick"
                                        Header="转到定义" />
                                        <MenuItem AutomationProperties.AutomationId="Shell.SourceEditor.PeekDefinitionMenuItem"
                                        Click="PeekDefinition_OnClick"
                                        Header="查看定义" />
                                        <MenuItem x:Name="PeekFieldDetailsMenuItem"
                                        AutomationProperties.AutomationId="Shell.SourceEditor.PeekFieldDetailsMenuItem"
                                        Click="PeekFieldDetails_OnClick"
                                        Header="速览字段详情"
                                        IsEnabled="False" />
                                        <MenuItem x:Name="FindReferencesMenuItem"
                                        AutomationProperties.AutomationId="Shell.SourceEditor.FindReferencesMenuItem"
                                        Click="FindAllReferences_OnClick"
                                        Header="查找当前文件引用"
                                        IsEnabled="False" />
                                        <Separator />
                                        <MenuItem AutomationProperties.AutomationId="Shell.SourceEditor.ShowCompletionPreviewMenuItem"
                                        Click="ShowCompletionPreview_OnClick"
                                        Header="显示补全预览" />
                                        <Separator />
                                        <MenuItem AutomationProperties.AutomationId="Shell.SourceEditor.AddPropertyMenuItem"
                                        Click="AddProperty_OnClick"
                                        Header="添加属性..." />
                                        </ContextMenu>
                                        </avalonedit:TextEditor.ContextMenu>
                                        </avalonedit:TextEditor>
                                        
                                        <Popup x:Name="CompletionDropdownPopup"
                                        AllowsTransparency="True"
                                        AutomationProperties.AutomationId="Shell.CompletionDropdownPopup"
                                        Placement="Relative"
                                        PlacementTarget="{Binding ElementName=SourceTextEditor}"
                                        PopupAnimation="Fade"
                                        StaysOpen="True">
                                        <languageViews:Ra2CompletionDropdownView x:Name="CompletionDropdownView" />
                                        </Popup>
                                        </Grid>
                                        </Border>
                                    </avalondock:LayoutDocument.Content>
                                </avalondock:LayoutDocument>
                            </avalondock:LayoutDocumentPane>
                        </avalondock:LayoutDocumentPaneGroup>

                        <avalondock:LayoutAnchorablePaneGroup x:Name="BottomToolPaneGroup"
                                                            DockHeight="260"
                                                            DockMinHeight="160"
                                                            Orientation="Horizontal">
                            <avalondock:LayoutAnchorablePane x:Name="BottomToolTabs"
                                                           AutomationProperties.AutomationId="Shell.BottomToolTabs"
                                                           SelectedContentIndex="1">
                                <avalondock:LayoutAnchorable x:Name="BottomProblemsAnchorable"
                                                           AutomationProperties.AutomationId="Shell.Dock.Tool.Problems"
                                                           CanAutoHide="True"
                                                           CanClose="False"
                                                           CanDockAsTabbedDocument="False"
                                                           CanFloat="True"
                                                           CanHide="True"
                                                           ContentId="Tool.Problems"
                                                           FloatingHeight="460"
                                                           FloatingWidth="880"
                                                           Title="问题">
                                    <avalondock:LayoutAnchorable.Content>
                                        <Grid x:Name="BottomErrorListTab"
                                        AutomationProperties.AutomationId="Shell.BottomToolTabs.ErrorList">
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        
                                        <Border Style="{StaticResource IdeWorkspaceCommandBarStyle}">
                                        <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                        <Button
                                        AutomationProperties.AutomationId="Shell.BottomIssues.RefreshCurrentFileButton"
                                        Click="RefreshCurrentFileDiagnosticsFromShell"
                                        Content="刷新当前"
                                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}" />
                                        <Button
                                        AutomationProperties.AutomationId="Shell.BottomIssues.RunFullDiagnosticsButton"
                                        Click="RunManualFullDiagnosticsFromShell"
                                        Content="全量诊断"
                                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}" />
                                        <Button
                                        AutomationProperties.AutomationId="Shell.BottomIssues.ClearButton"
                                        Click="ClearIssuesFromShell"
                                        Content="清空"
                                        Style="{StaticResource IdeWorkspaceCommandButtonStyle}" />
                                        </StackPanel>
                                        <ListBox Width="272"
                                                 Margin="0,0,8,0"
                                                 ItemsSource="{Binding Issues.SeverityFilterOptions}"
                                                 ItemContainerStyle="{StaticResource IdeIssueSeveritySelectorItemStyle}"
                                                 SelectedItem="{Binding Issues.SelectedSeverityFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource IdeIssueSeveritySelectorStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid AutomationProperties.Name="{Binding}">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="AutomationProperties.AutomationId" Value="Shell.BottomIssues.Filter.All" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="Error">
                                                                        <Setter Property="AutomationProperties.AutomationId" Value="Shell.BottomIssues.Filter.Error" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="Warning">
                                                                        <Setter Property="AutomationProperties.AutomationId" Value="Shell.BottomIssues.Filter.Warning" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="Info">
                                                                        <Setter Property="AutomationProperties.AutomationId" Value="Shell.BottomIssues.Filter.Info" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Width="14"
                                                                  Height="14"
                                                                  Margin="0,0,4,0"
                                                                  StrokeThickness="1.4"
                                                                  StrokeLineJoin="Round"
                                                                  Stretch="Uniform">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Data" Value="{DynamicResource IconGeometry.Issue.All}" />
                                                                        <Setter Property="Stroke" Value="{DynamicResource UiTextSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding}" Value="Error">
                                                                                <Setter Property="Data" Value="{DynamicResource IconGeometry.Issue.Error}" />
                                                                                <Setter Property="Stroke" Value="{DynamicResource UiDangerBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="Warning">
                                                                                <Setter Property="Data" Value="{DynamicResource IconGeometry.Issue.Warning}" />
                                                                                <Setter Property="Stroke" Value="{DynamicResource UiWarningBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="Info">
                                                                                <Setter Property="Data" Value="{DynamicResource IconGeometry.Issue.Info}" />
                                                                                <Setter Property="Stroke" Value="{DynamicResource UiInfoBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            <TextBlock VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="全部" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding}" Value="Error"><Setter Property="Text" Value="错误" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="Warning"><Setter Property="Text" Value="警告" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="Info"><Setter Property="Text" Value="信息" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource UiTextSecondaryBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="AutomationProperties.AutomationId" Value="Shell.BottomIssues.Count.All" />
                                                                        <Setter Property="Text" Value="{Binding DataContext.Issues.TotalCount, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding}" Value="Error">
                                                                                <Setter Property="AutomationProperties.AutomationId" Value="Shell.BottomIssues.Count.Error" />
                                                                                <Setter Property="Text" Value="{Binding DataContext.Issues.ErrorCount, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="Warning">
                                                                                <Setter Property="AutomationProperties.AutomationId" Value="Shell.BottomIssues.Count.Warning" />
                                                                                <Setter Property="Text" Value="{Binding DataContext.Issues.WarningCount, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding}" Value="Info">
                                                                                <Setter Property="AutomationProperties.AutomationId" Value="Shell.BottomIssues.Count.Info" />
                                                                                <Setter Property="Text" Value="{Binding DataContext.Issues.InfoCount, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Margin="4,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource UiTextSecondaryBrush}"
                                                   Text="{Binding Issues.StatusText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        </Border>
                                        
                                        <DataGrid x:Name="BottomIssuesGrid"
                                        Grid.Row="1"
                                        AutomationProperties.AutomationId="Shell.BottomIssues.Grid"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        IsReadOnly="True"
                                        ItemsSource="{Binding Issues.Items}"
                                        MouseDoubleClick="BottomIssuesGrid_OnMouseDoubleClick"
                                        SelectionMode="Single"
                                        SelectionUnit="FullRow"
                                        SelectedItem="{Binding Issues.SelectedIssue, Mode=TwoWay}"
                                        Style="{StaticResource IdeIssueDataGridStyle}">
                                        <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="36"
                                                                Header=""
                                                                CellTemplate="{StaticResource IdeIssueSeverityIconTemplate}" />
                                        <DataGridTextColumn Width="120"
                                        Binding="{Binding LocationText}"
                                        Header="位置" />
                                        <DataGridTextColumn Width="96"
                                        Binding="{Binding Code}"
                                        Header="代码" />
                                        <DataGridTemplateColumn Width="*"
                                        Header="消息">
                                        <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                        <TextBlock Text="{Binding Message}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Message}" />
                                        </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Width="150"
                                        Binding="{Binding SourceText}"
                                        Header="来源" />
                                        </DataGrid.Columns>
                                        </DataGrid>
                                        
                                        </Grid>
                                    </avalondock:LayoutAnchorable.Content>
                                </avalondock:LayoutAnchorable>
                                <avalondock:LayoutAnchorable x:Name="BottomOutputAnchorable"
                                                           AutomationProperties.AutomationId="Shell.Dock.Tool.Output"
                                                           CanAutoHide="True"
                                                           CanClose="False"
                                                           CanDockAsTabbedDocument="False"
                                                           CanFloat="True"
                                                           CanHide="True"
                                                           ContentId="Tool.Output"
                                                           FloatingHeight="420"
                                                           FloatingWidth="800"
                                                           Title="输出">
                                    <avalondock:LayoutAnchorable.Content>
                                        <Grid x:Name="BottomOutputTab"
                                              AutomationProperties.AutomationId="Shell.BottomToolTabs.Output">
                                             <TextBox AutomationProperties.AutomationId="Shell.OutputTextBox"
                                             AcceptsReturn="True"
                                            HorizontalScrollBarVisibility="Auto"
                                            IsReadOnly="True"
                                            Text="{Binding OutputText, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto"
                                            Style="{StaticResource IdeOutputTextSurfaceStyle}" />
                                        </Grid>
                                    </avalondock:LayoutAnchorable.Content>
                                </avalondock:LayoutAnchorable>
                                <avalondock:LayoutAnchorable x:Name="SearchAnchorable"
                                                           AutomationProperties.AutomationId="Shell.Dock.Tool.Search"
                                                           CanAutoHide="True"
                                                           CanClose="False"
                                                           CanDockAsTabbedDocument="False"
                                                           CanFloat="True"
                                                           CanHide="True"
                                                           ContentId="Tool.Search"
                                                           FloatingHeight="620"
                                                           FloatingWidth="560"
                                                           IsVisible="False"
                                                           Title="查找">
                                    <avalondock:LayoutAnchorable.Content>
                                        <Grid x:Name="SearchToolContentHost"
                                              AutomationProperties.AutomationId="Shell.Tool.Search.Content"
                                              Focusable="True">
                                            <views:SearchToolView />
                                        </Grid>
                                    </avalondock:LayoutAnchorable.Content>
                                </avalondock:LayoutAnchorable>
                                <avalondock:LayoutAnchorable x:Name="FindReferencesAnchorable"
                                                           AutomationProperties.AutomationId="Shell.Dock.Tool.FindReferences"
                                                           CanAutoHide="True"
                                                           CanClose="False"
                                                           CanDockAsTabbedDocument="False"
                                                           CanFloat="True"
                                                           CanHide="True"
                                                           ContentId="Tool.FindReferences"
                                                           FloatingHeight="460"
                                                           FloatingWidth="700"
                                                           IsVisible="False"
                                                           Title="查找引用">
                                    <avalondock:LayoutAnchorable.Content>
                                        <languageViews:Ra2FindReferencesView x:Name="FindReferencesView" />
                                    </avalondock:LayoutAnchorable.Content>
                                </avalondock:LayoutAnchorable>
                            </avalondock:LayoutAnchorablePane>
                        </avalondock:LayoutAnchorablePaneGroup>
                    </avalondock:LayoutPanel>

                    <avalondock:LayoutAnchorablePaneGroup x:Name="RightToolPaneGroup"
                                                        AutomationProperties.AutomationId="RightToolWell.ActiveView"
                                                        DockMinWidth="240"
                                                        DockWidth="300"
                                                        Orientation="Horizontal">
                        <avalondock:LayoutAnchorablePane x:Name="RightToolWellRoot"
                                                       AutomationProperties.AutomationId="RightToolWell.Root"
                                                       SelectedContentIndex="0">
                            <avalondock:LayoutAnchorable x:Name="SectionExplorerAnchorable"
                                                       AutomationProperties.AutomationId="RightToolWell.SectionTab"
                                                       CanAutoHide="True"
                                                       CanClose="False"
                                                       CanDockAsTabbedDocument="False"
                                                       CanFloat="True"
                                                       CanHide="True"
                                                       ContentId="Tool.SectionExplorer"
                                                       FloatingHeight="720"
                                                       FloatingWidth="320"
                                                       Title="项目浏览器">
                                <avalondock:LayoutAnchorable.Content>
                                    <Grid x:Name="RightToolWellSectionView"
                                    AutomationProperties.AutomationId="RightToolWell.ActiveView">
                                    <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <TreeView x:Name="ProjectExplorerTreeView"
                                    AutomationProperties.AutomationId="Shell.ProjectExplorer"
                                    Grid.Row="0"
                                    Margin="0"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ShellProjectExplorerTreeItemStyle}"
                                    ItemsSource="{Binding ProjectExplorer.Items}"
                                    ScrollViewer.CanContentScroll="True"
                                    SelectedItemChanged="ProjectExplorerTreeView_OnSelectedItemChanged"
                                    Style="{StaticResource UiTreeViewStyle}"
                                    VirtualizingStackPanel.IsVirtualizing="True"
                                    VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type viewModels:ProjectExplorerItemViewModel}"
                                    ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal"
                                    ToolTip="{Binding ToolTipText}">
                                    <Border Width="18"
                                    Height="18"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True"
                                    ToolTip="{Binding IconText}">
                                    <Image Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    UseLayoutRounding="True"
                                    Source="{Binding IconKey, Converter={StaticResource IconKeyToDrawingImageConverter}}" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayTextWithCount}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="Foreground" Value="{StaticResource ShellPrimaryTextBrush}" />
                                    <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentFile}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrentSection}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    </Style.Triggers>
                                    </Style>
                                    </TextBlock.Style>
                                    </TextBlock>
                                    </StackPanel>
                                    </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                    </TreeView>
                                    
                                    <Border Grid.Row="1"
                                            Style="{StaticResource IdeToolFooterStyle}">
                                        <TextBlock AutomationProperties.AutomationId="Shell.ProjectExplorerStatusText"
                                                   Style="{StaticResource IdeToolWindowStatusStyle}"
                                                   Text="{Binding ProjectExplorer.StatusText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    </Grid>
                                </avalondock:LayoutAnchorable.Content>
                            </avalondock:LayoutAnchorable>
                            <avalondock:LayoutAnchorable x:Name="AiAssistantAnchorable"
                                                       AutomationProperties.AutomationId="RightToolWell.AiTab"
                                                       CanAutoHide="True"
                                                       CanClose="False"
                                                       CanDockAsTabbedDocument="False"
                                                       CanFloat="True"
                                                       CanHide="True"
                                                       ContentId="Tool.AiAssistant"
                                                       FloatingHeight="760"
                                                       FloatingWidth="360"
                                                       Title="AI 助手">
                                <avalondock:LayoutAnchorable.Content>
                                    <Grid x:Name="AiAssistantSkeletonView"
                                    AutomationProperties.AutomationId="AiAssistant.Panel"
                                    Style="{StaticResource IdeAiWorkspaceRootStyle}">
                                    <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <Border Grid.Row="0"
                                    MaxHeight="44"
                                    Style="{StaticResource IdeAiContextStripStyle}"
                                    ToolTip="{Binding Text, ElementName=AiAssistantContextSummaryText}">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="AiAssistantContextSummaryText"
                                    AutomationProperties.AutomationId="AiAssistant.ContextSummary"
                                    Style="{StaticResource IdeAiContextTextStyle}"
                                    Text="上下文：发送时会将当前文档的受限上下文传输给所选 DeepSeek 模型，包括选区或附近行、当前 Section/字段、字段证据、诊断摘要和最近对话。不会读取整个项目或修改文件。"
                                    Visibility="Collapsed" />
                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                    <TextBlock AutomationProperties.AutomationId="AiAssistant.Header"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource IdeWorkspaceSectionTitleStyle}"
                                    Text="上下文" />
                                    <TextBlock x:Name="AiAssistantCurrentSubjectSummaryText"
                                    AutomationProperties.AutomationId="AiAssistant.CurrentSubjectSummary"
                                    Style="{StaticResource IdeAiR2CompactContextTextStyle}"
                                    Text="当前主题：无" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1"
                                    x:Name="AiAssistantConversationContextSummaryText"
                                    AutomationProperties.AutomationId="AiAssistant.ConversationContextSummary"
                                    Style="{StaticResource IdeAiR2CompactContextTextStyle}"
                                    Text="对话上下文：最近 0 轮，未截断" />
                                    </Grid>
                                    </Border>
                                    
                                    <Grid Grid.Row="1"
                                    AutomationProperties.AutomationId="AiAssistant.ChatHistory"
                                    Margin="0">
                                    <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Grid.Row="0"
                                    AutomationProperties.AutomationId="AiAssistant.ChatHistoryActions"
                                    Margin="8,4,4,2"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <Button x:Name="AiAssistantClearButton"
                                    AutomationProperties.AutomationId="AiAssistant.ClearButton"
                                    IsEnabled="False"
                                    Click="ClearAiAssistantMessages"
                                    Style="{StaticResource IdeWorkspaceCommandButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="14"
                                          Height="14"
                                          Margin="0,0,4,0"
                                          Data="{StaticResource IconGeometry.Action.Clear}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          StrokeThickness="1.2"
                                          Stretch="Uniform" />
                                    <TextBlock VerticalAlignment="Center" Text="清空" />
                                    </StackPanel>
                                    </Button>
                                    </StackPanel>
                                    
                                    <Border Grid.Row="1" Style="{StaticResource IdeAiChatViewportStyle}">
                                    <ScrollViewer
                                    x:Name="AiAssistantChatScrollViewer"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="AiAssistantChatMessages">
                                    <Border x:Name="AiAssistantInitialAssistantMessage"
                                    Style="{StaticResource IdeAiAssistantMessageStyle}"
                                    Visibility="Collapsed" />
                                    <Border x:Name="AiAssistantEmptyStateMessage"
                                    AutomationProperties.AutomationId="AiAssistant.EmptyStateMessage"
                                    Style="{StaticResource IdeAiAssistantMessageStyle}">
                                    <StackPanel>
                                    <TextBlock x:Name="AiAssistantEmptyStatePrimaryText"
                                    AutomationProperties.AutomationId="AiAssistant.ResponseArea"
                                    Style="{StaticResource IdeAiMessageTextStyle}"
                                    Text="可以直接描述需求，例如“帮我设计一个轻型防空车”。默认使用 DeepSeek V4 Flash。"
                                    TextWrapping="Wrap" />
                                    <TextBlock x:Name="AiAssistantEmptyStateSecondaryText"
                                    AutomationProperties.AutomationId="AiAssistant.DraftPreview"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource IdeAiMetadataTextStyle}"
                                    Text="回复只作为草稿或建议；发送会联网，但不会修改文件。"
                                    TextWrapping="Wrap" />
                                    </StackPanel>
                                    </Border>
                                    </StackPanel>
                                    </ScrollViewer>
                                    </Border>
                                    </Grid>
                                    
                                    <Border Grid.Row="2"
                                    AutomationProperties.AutomationId="AiAssistant.Composer"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0"
                                    x:Name="AiAssistantRequestPreparationNotice"
                                    AutomationProperties.AutomationId="AiAssistant.RequestPreparationNotice"
                                    Margin="8,0,8,2"
                                    Foreground="{DynamicResource UiDangerBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                                    
                                    <Border Grid.Row="1"
                                    Style="{StaticResource IdeAiCopilotComposerSurfaceStyle}">
                                    <Grid>
                                    <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          x:Name="AiAssistantModeSelector"
                                          AutomationProperties.AutomationId="AiAssistant.ModeSelector"
                                          Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     x:Name="AiAssistantChatModeButton"
                                                     AutomationProperties.AutomationId="AiAssistant.ChatModeButton"
                                                     AutomationProperties.Name="聊天模式"
                                                     GroupName="AiAssistantMode"
                                                     IsChecked="True"
                                                     Checked="AiAssistantModeButton_OnChecked"
                                                     Content="聊天"
                                                     Style="{StaticResource IdeAiModeSegmentStyle}" />
                                        <RadioButton Grid.Column="1"
                                                     x:Name="AiAssistantWorkModeButton"
                                                     AutomationProperties.AutomationId="AiAssistant.WorkModeButton"
                                                     AutomationProperties.Name="工作模式"
                                                     GroupName="AiAssistantMode"
                                                     Margin="-1,0,0,0"
                                                     Checked="AiAssistantModeButton_OnChecked"
                                                     Content="工作"
                                                     Style="{StaticResource IdeAiModeSegmentStyle}" />
                                        <TextBlock Grid.Column="2"
                                                   x:Name="AiAssistantModeSummaryText"
                                                   AutomationProperties.AutomationId="AiAssistant.ModeSummary"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource UiTextSecondaryBrush}"
                                                   Text="解释与建议"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </Grid>

                                    <TextBox Grid.Row="1"
                                    x:Name="AiAssistantPromptBox"
                                    AutomationProperties.AutomationId="AiAssistant.PromptBox"
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    HorizontalScrollBarVisibility="Disabled"
                                    MaxHeight="112"
                                    MinHeight="48"
                                    MinLines="2"
                                    Padding="2,3"
                                    PreviewKeyDown="AiAssistantPromptBox_OnPreviewKeyDown"
                                    Style="{StaticResource IdeAiComposerInputStyle}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                                    
                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                    x:Name="AiAssistantModelSelector"
                                    AutomationProperties.AutomationId="AiAssistant.ModelSelector"
                                    AutomationProperties.Name="AI 模型"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    DisplayMemberPath="DisplayName"
                                    Height="28"
                                    HorizontalAlignment="Stretch"
                                    MaxDropDownHeight="80"
                                    MinHeight="28"
                                    MinWidth="0"
                                    Padding="5,2"
                                    SelectedValuePath="Value"
                                    Style="{StaticResource UiComboBoxStyle}"
                                    ToolTip="选择本次请求使用的 DeepSeek 模型；活动请求期间不可切换。">
                                    </ComboBox>
                                    <ToggleButton Grid.Column="1"
                                    x:Name="AiAssistantAdvancedToggle"
                                    AutomationProperties.AutomationId="AiAssistant.AdvancedButton"
                                    AutomationProperties.Name="模型与配置状态"
                                    Margin="4,0,0,0"
                                    Style="{StaticResource IdeAiComposerAdvancedButtonStyle}"
                                    ToolTip="显示或隐藏模型配置状态">
                                    <Path Width="14"
                                          Height="14"
                                          Data="{StaticResource IconGeometry.Action.Advanced}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                          StrokeThickness="1.2"
                                          Stretch="Uniform" />
                                    </ToggleButton>
                                    <Grid Grid.Column="2" Margin="4,0,0,0">
                                    <Button x:Name="AiAssistantGenerateButton"
                                    AutomationProperties.AutomationId="AiAssistant.GenerateButton"
                                    AutomationProperties.Name="发送"
                                    Click="GenerateAiAssistantResponse"
                                    Style="{StaticResource IdeAiComposerSendButtonStyle}"
                                    ToolTip="发送">
                                    <Path Width="14"
                                          Height="14"
                                          Data="{StaticResource IconGeometry.Action.Send}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          StrokeThickness="1.2"
                                          Stretch="Uniform" />
                                    </Button>
                                    <Button x:Name="AiAssistantCancelButton"
                                    AutomationProperties.AutomationId="AiAssistant.CancelButton"
                                    AutomationProperties.Name="取消生成"
                                    Click="CancelAiAssistantResponse"
                                    IsEnabled="False"
                                    Style="{StaticResource IdeAiComposerCancelButtonStyle}"
                                    ToolTip="取消生成">
                                    <Path Width="14"
                                          Height="14"
                                          Data="{StaticResource IconGeometry.Action.Cancel}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          StrokeThickness="1.2"
                                          Stretch="Uniform" />
                                    </Button>
                                    </Grid>
                                    </Grid>

                                    <Border Grid.Row="3"
                                    AutomationProperties.AutomationId="AiAssistant.AdvancedOptions">
                                    <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource IdeAiCopilotAdvancedOptionsStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=AiAssistantAdvancedToggle}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    </Style.Triggers>
                                    </Style>
                                    </Border.Style>
                                    <TextBlock x:Name="AiAssistantConfigurationStatusText"
                                    AutomationProperties.AutomationId="AiAssistant.ConfigurationStatus"
                                    Style="{StaticResource IdeAiCopilotConfigurationStatusStyle}"
                                    Text="配置状态：尚未检查"
                                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </Border>
                                    </Grid>
                                    </Border>
                                    
                                    <TextBlock Grid.Row="2"
                                    x:Name="AiAssistantSafetyFooterText"
                                    AutomationProperties.AutomationId="AiAssistant.SafetyFooter"
                                    Style="{StaticResource IdeAiR2SafetyTextStyle}"
                                    Text="AI 输出仅供参考；发送会联网，但不会修改文件。"
                                    ToolTip="AI 输出仅作为草稿或建议；发送会把受限上下文传输给所选 DeepSeek 模型并可能产生费用，但不会修改文件。" />
                                     </Grid>
                                    </Border>
                                    </Grid>
                                </avalondock:LayoutAnchorable.Content>
                            </avalondock:LayoutAnchorable>
                        </avalondock:LayoutAnchorablePane>
                    </avalondock:LayoutAnchorablePaneGroup>
                </avalondock:LayoutPanel>
            </avalondock:LayoutRoot>
        </avalondock:DockingManager>

        <Border Grid.Row="3"
                AutomationProperties.AutomationId="StatusBar"
                Style="{StaticResource IdeShellStatusBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock AutomationProperties.AutomationId="StatusCurrentFileText"
                               Margin="0,0,18,0"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ShellPrimaryTextBrush}"
                               Text="{Binding StatusCurrentFileText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock AutomationProperties.AutomationId="StatusDirtyStateText"
                               Margin="0,0,18,0"
                               Foreground="{StaticResource ShellMutedTextBrush}"
                               Text="{Binding StatusDirtyStateText}" />
                    <TextBlock AutomationProperties.AutomationId="StatusEncodingText"
                               Margin="0,0,18,0"
                               Foreground="{StaticResource ShellMutedTextBrush}"
                               Text="{Binding StatusEncodingText}" />
                    <TextBlock AutomationProperties.AutomationId="StatusNewlineText"
                               Foreground="{StaticResource ShellMutedTextBrush}"
                               Text="{Binding StatusNewlineText}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="18,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock AutomationProperties.AutomationId="StatusOperationKindText"
                               Margin="0,0,8,0"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ShellMutedTextBrush}"
                               Text="{Binding StatusOperationKindText}" />
                    <TextBlock AutomationProperties.AutomationId="StatusOperationText"
                               MaxWidth="420"
                               Foreground="{StaticResource ShellPrimaryTextBrush}"
                               Text="{Binding StatusOperationText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock AutomationProperties.AutomationId="StatusCaretPositionText"
                               Margin="0,0,18,0"
                               Foreground="{StaticResource ShellMutedTextBrush}"
                               Text="{Binding StatusCaretPositionText}" />
                    <TextBlock AutomationProperties.AutomationId="StatusSelectionText"
                               Foreground="{StaticResource ShellMutedTextBrush}"
                               Text="{Binding StatusSelectionText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
