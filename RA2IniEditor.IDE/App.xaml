<Application x:Class="RA2IniEditor.IDE.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="clr-namespace:RA2IniEditor.IDE.Resources"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/IdeVisualTokens.xaml" />
                <ResourceDictionary Source="Themes/IdeControlStyles.xaml" />
                <ResourceDictionary Source="Themes/IdeCollectionStyles.xaml" />
                <ResourceDictionary Source="Themes/IdeWorkspaceStyles.xaml" />
                <ResourceDictionary Source="Themes/IdeFieldRegistryStyles.xaml" />
                <ResourceDictionary Source="Themes/IdeEditorAssistStyles.xaml" />
                <ResourceDictionary Source="Themes/ShellTheme.xaml" />
                <ResourceDictionary Source="Themes/IconResources.xaml" />
                <ResourceDictionary Source="Themes/IconGeometryResources.xaml" />
                <ResourceDictionary Source="Themes/IconImageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <resources:IconKeyToDrawingImageConverter x:Key="IconKeyToDrawingImageConverter" />
            <!-- 仅统一窗口继承字体；颜色、字号、模板和文字渲染模式仍由各视觉表面负责。 -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
