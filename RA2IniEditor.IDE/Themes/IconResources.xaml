<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Icon-S2B: main toolbar vector icon presenters. -->
    <SolidColorBrush x:Key="IconBrush.Normal" Color="#202733" />
    <SolidColorBrush x:Key="IconBrush.Muted" Color="#697386" />
    <SolidColorBrush x:Key="IconBrush.Disabled" Color="#A7B0BD" />
    <SolidColorBrush x:Key="IconBrush.Warning" Color="#B7791F" />
    <SolidColorBrush x:Key="IconBrush.Error" Color="#C2413A" />
    <SolidColorBrush x:Key="IconBrush.Success" Color="#2F855A" />
    <SolidColorBrush x:Key="IconBrush.Accent" Color="#3B73B9" />
    <SolidColorBrush x:Key="IconBrush.Project" Color="#3B73B9" />
    <SolidColorBrush x:Key="IconBrush.Global" Color="#6B5FB5" />
    <SolidColorBrush x:Key="IconBrush.BuiltIn" Color="#5F6B7A" />

    <Viewbox x:Key="IconSampleCheck"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Path Data="M3,8.2 L6.3,11.5 L13,4.5"
                  Stroke="{DynamicResource IconBrush.Success}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="IconOpenFolder"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Path Data="M2.5,5.5 L6,5.5 L7.2,7 L13.5,7 L13.5,12.5 L2.5,12.5 Z"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
            <Path Data="M3,6.8 L4.2,4.4 L7,4.4 L8.1,5.5"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="IconSave"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Path Data="M3.2,2.8 L11.6,2.8 L13.2,4.4 L13.2,13.2 L2.8,13.2 L2.8,2.8 Z"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.4"
                  StrokeLineJoin="Round" />
            <Path Data="M5,2.9 L10,2.9 L10,6 L5,6 Z"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.2"
                  StrokeLineJoin="Round" />
            <Path Data="M5,10.2 L11,10.2"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="IconUndo"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Path Data="M6.2,4 L3.3,6.7 L6.2,9.4"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
            <Path Data="M3.8,6.7 L9.3,6.7 C12,6.7 13.2,8.2 13.2,10.5 C13.2,11.3 13,12 12.6,12.7"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="IconRedo"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Path Data="M9.8,4 L12.7,6.7 L9.8,9.4"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
            <Path Data="M12.2,6.7 L6.7,6.7 C4,6.7 2.8,8.2 2.8,10.5 C2.8,11.3 3,12 3.4,12.7"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="IconRevert"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Path Data="M4.5,2.8 L10,2.8 L12.5,5.3 L12.5,13.2 L4.5,13.2 Z"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.25"
                  StrokeLineJoin="Round" />
            <Path Data="M10,2.9 L10,5.3 L12.4,5.3"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.15"
                  StrokeLineJoin="Round" />
            <Path Data="M8,8.4 L4.7,8.4"
                  Stroke="{DynamicResource IconBrush.Muted}"
                  StrokeThickness="1.35"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Path Data="M6.2,6.6 L4.4,8.4 L6.2,10.2"
                  Stroke="{DynamicResource IconBrush.Muted}"
                  StrokeThickness="1.35"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="IconEditMode"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Path Data="M4,11.8 L4.6,9.4 L10.3,3.7 L12.3,5.7 L6.6,11.4 Z"
                  Stroke="{DynamicResource IconBrush.Muted}"
                  StrokeThickness="1.35"
                  StrokeLineJoin="Round" />
            <Path Data="M9.2,4.8 L11.2,6.8"
                  Stroke="{DynamicResource IconBrush.Muted}"
                  StrokeThickness="1.35"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="IconSearch"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Ellipse Canvas.Left="3.2"
                     Canvas.Top="3.2"
                     Width="7"
                     Height="7"
                     Stroke="{DynamicResource IconBrush.Normal}"
                     StrokeThickness="1.5" />
            <Path Data="M9.5,9.5 L12.8,12.8"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="IconFieldRegistry"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Path Data="M3.2,3 L12.8,3 L12.8,13 L3.2,13 Z"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.35"
                  StrokeLineJoin="Round" />
            <Path Data="M5,3 L5,13"
                  Stroke="{DynamicResource IconBrush.Muted}"
                  StrokeThickness="1.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Path Data="M7,6 L11,6 M7,8.4 L11,8.4 M7,10.8 L10,10.8"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.15"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="IconIssues"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Path Data="M7.7,2.8 L13.1,12.6 L2.9,12.6 Z"
                  Stroke="{DynamicResource IconBrush.Warning}"
                  StrokeThickness="1.35"
                  StrokeLineJoin="Round" />
            <Path Data="M7.9,6 L7.9,8.7"
                  Stroke="{DynamicResource IconBrush.Warning}"
                  StrokeThickness="1.35"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <Ellipse Canvas.Left="7.25"
                     Canvas.Top="10.25"
                     Width="1.3"
                     Height="1.3"
                     Fill="{DynamicResource IconBrush.Warning}" />
        </Canvas>
    </Viewbox>

    <Viewbox x:Key="IconProjectExplorer"
             x:Shared="False"
             Width="16"
             Height="16"
             Stretch="Uniform"
             StretchDirection="Both"
             SnapsToDevicePixels="True">
        <Canvas Width="16" Height="16">
            <Path Data="M3.5,3 L13,3 L13,13 L3.5,13 Z"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.25"
                  StrokeLineJoin="Round" />
            <Path Data="M6,5.2 L6,10.8 M6,6.2 L8,6.2 M6,9.9 L8,9.9"
                  Stroke="{DynamicResource IconBrush.Normal}"
                  StrokeThickness="1.2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
            <Ellipse Canvas.Left="8.4"
                     Canvas.Top="5.25"
                     Width="2"
                     Height="2"
                     Stroke="{DynamicResource IconBrush.Muted}"
                     StrokeThickness="1" />
            <Ellipse Canvas.Left="8.4"
                     Canvas.Top="9"
                     Width="2"
                     Height="2"
                     Stroke="{DynamicResource IconBrush.Muted}"
                     StrokeThickness="1" />
        </Canvas>
    </Viewbox>
</ResourceDictionary>
