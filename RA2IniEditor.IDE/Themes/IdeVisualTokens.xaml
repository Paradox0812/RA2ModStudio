<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Semantic colors are the single light-theme authority. Brushes and Shell compatibility resources consume them. -->
    <Color x:Key="UiCanvasColor">#F4F6F8</Color>
    <Color x:Key="UiSurfaceColor">#FFFFFF</Color>
    <Color x:Key="UiSurfaceSubtleColor">#F5F7FA</Color>
    <Color x:Key="UiSurfaceHoverColor">#EAF2FB</Color>
    <Color x:Key="UiSurfacePressedColor">#DCE9F7</Color>
    <Color x:Key="UiBorderColor">#D7DCE2</Color>
    <Color x:Key="UiDividerColor">#E3E8EF</Color>
    <Color x:Key="UiTextPrimaryColor">#202733</Color>
    <Color x:Key="UiTextSecondaryColor">#697386</Color>
    <Color x:Key="UiTextDisabledColor">#98A2B3</Color>
    <Color x:Key="UiAccentColor">#0F6CBD</Color>
    <Color x:Key="UiAccentHoverColor">#115EA3</Color>
    <Color x:Key="UiAccentPressedColor">#0C3B5E</Color>
    <Color x:Key="UiAccentSoftColor">#EAF4FF</Color>
    <Color x:Key="UiDangerColor">#B42318</Color>
    <Color x:Key="UiDangerSoftColor">#FDECEC</Color>
    <Color x:Key="UiWarningColor">#B54708</Color>
    <Color x:Key="UiWarningSoftColor">#FFF4E5</Color>
    <Color x:Key="UiInfoColor">#2563EB</Color>
    <Color x:Key="UiInfoSoftColor">#EAF2FF</Color>
    <Color x:Key="UiSuccessColor">#107C10</Color>
    <Color x:Key="UiCodeSurfaceColor">#F7F8FA</Color>
    <Color x:Key="UiSelectionColor">#DCEEFF</Color>
    <Color x:Key="UiSelectionInactiveColor">#EEF2F7</Color>

    <!-- Existing Shell-only tones remain token-owned so compatibility keys contain no independent color literals. -->
    <Color x:Key="UiTopChromeInnerDividerColor">#EEF2F6</Color>
    <Color x:Key="UiToolbarBottomBorderColor">#D5DCE5</Color>
    <Color x:Key="UiDockHeaderColor">#F7F9FC</Color>
    <Color x:Key="UiDockSplitterColor">#E2E7ED</Color>
    <Color x:Key="UiDockSplitterHoverColor">#A9C7E8</Color>

    <SolidColorBrush x:Key="UiCanvasBrush" Color="{StaticResource UiCanvasColor}" />
    <SolidColorBrush x:Key="UiSurfaceBrush" Color="{StaticResource UiSurfaceColor}" />
    <SolidColorBrush x:Key="UiSurfaceSubtleBrush" Color="{StaticResource UiSurfaceSubtleColor}" />
    <SolidColorBrush x:Key="UiSurfaceHoverBrush" Color="{StaticResource UiSurfaceHoverColor}" />
    <SolidColorBrush x:Key="UiSurfacePressedBrush" Color="{StaticResource UiSurfacePressedColor}" />
    <SolidColorBrush x:Key="UiBorderBrush" Color="{StaticResource UiBorderColor}" />
    <SolidColorBrush x:Key="UiDividerBrush" Color="{StaticResource UiDividerColor}" />
    <SolidColorBrush x:Key="UiTextPrimaryBrush" Color="{StaticResource UiTextPrimaryColor}" />
    <SolidColorBrush x:Key="UiTextSecondaryBrush" Color="{StaticResource UiTextSecondaryColor}" />
    <SolidColorBrush x:Key="UiTextDisabledBrush" Color="{StaticResource UiTextDisabledColor}" />
    <SolidColorBrush x:Key="UiAccentBrush" Color="{StaticResource UiAccentColor}" />
    <SolidColorBrush x:Key="UiAccentHoverBrush" Color="{StaticResource UiAccentHoverColor}" />
    <SolidColorBrush x:Key="UiAccentPressedBrush" Color="{StaticResource UiAccentPressedColor}" />
    <SolidColorBrush x:Key="UiAccentSoftBrush" Color="{StaticResource UiAccentSoftColor}" />
    <SolidColorBrush x:Key="UiFocusBrush" Color="{StaticResource UiAccentColor}" />
    <SolidColorBrush x:Key="UiDangerBrush" Color="{StaticResource UiDangerColor}" />
    <SolidColorBrush x:Key="UiDangerSoftBrush" Color="{StaticResource UiDangerSoftColor}" />
    <SolidColorBrush x:Key="UiWarningBrush" Color="{StaticResource UiWarningColor}" />
    <SolidColorBrush x:Key="UiWarningSoftBrush" Color="{StaticResource UiWarningSoftColor}" />
    <SolidColorBrush x:Key="UiInfoBrush" Color="{StaticResource UiInfoColor}" />
    <SolidColorBrush x:Key="UiInfoSoftBrush" Color="{StaticResource UiInfoSoftColor}" />
    <SolidColorBrush x:Key="UiSuccessBrush" Color="{StaticResource UiSuccessColor}" />
    <SolidColorBrush x:Key="UiCodeSurfaceBrush" Color="{StaticResource UiCodeSurfaceColor}" />
    <SolidColorBrush x:Key="UiSelectionBrush" Color="{StaticResource UiSelectionColor}" />
    <SolidColorBrush x:Key="UiSelectionInactiveBrush" Color="{StaticResource UiSelectionInactiveColor}" />

    <sys:Double x:Key="UiTitleMenuHeight">30</sys:Double>
    <sys:Double x:Key="UiControlHeightCompact">28</sys:Double>
    <sys:Double x:Key="UiControlHeightDefault">32</sys:Double>
    <sys:Double x:Key="UiCommandRowHeight">32</sys:Double>
    <sys:Double x:Key="UiDocumentTabHeight">30</sys:Double>
    <sys:Double x:Key="UiToolHeaderHeight">30</sys:Double>
    <sys:Double x:Key="UiStatusBarHeight">24</sys:Double>
    <sys:Double x:Key="UiSplitterThickness">4</sys:Double>
    <sys:Double x:Key="UiSpace1">4</sys:Double>
    <sys:Double x:Key="UiSpace2">8</sys:Double>
    <sys:Double x:Key="UiSpace3">12</sys:Double>
    <sys:Double x:Key="UiSpace4">16</sys:Double>
    <CornerRadius x:Key="UiCornerSmall">3</CornerRadius>
    <CornerRadius x:Key="UiCornerMedium">6</CornerRadius>
    <Thickness x:Key="UiBorderThickness">1</Thickness>
    <Thickness x:Key="UiFocusThickness">2</Thickness>
    <sys:Double x:Key="UiIconSmall">16</sys:Double>
    <sys:Double x:Key="UiIconMedium">20</sys:Double>
    <sys:Double x:Key="UiTreeRowHeight">24</sys:Double>
    <sys:Double x:Key="UiGridRowHeight">26</sys:Double>

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="UiCodeFontFamily">Consolas</FontFamily>
    <sys:Double x:Key="UiFontSizeDefault">12</sys:Double>
    <sys:Double x:Key="UiFontSizeMetadata">11</sys:Double>
    <sys:Double x:Key="UiFontSizeToolTitle">12</sys:Double>
    <sys:Double x:Key="UiFontSizeSectionTitle">13</sys:Double>
</ResourceDictionary>
