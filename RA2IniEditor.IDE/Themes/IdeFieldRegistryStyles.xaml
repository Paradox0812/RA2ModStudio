<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Field Registry presentation patterns. All state remains owned by existing windows/ViewModels. -->
    <Style x:Key="IdeFieldRegistryRootStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="IdeFieldRegistryCommandBarStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="IdeFieldRegistryCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource UiButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="IdeFieldRegistryAccentButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource UiAccentButtonStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="9,3" />
    </Style>

    <Style x:Key="IdeFieldRegistryNavigationPaneStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="10,9" />
    </Style>

    <Style x:Key="IdeFieldRegistryListPaneStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="IdeFieldRegistryDetailsPaneStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="IdeFieldRegistrySectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeSectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IdeFieldRegistryMetadataTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeMetadata}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IdeFieldRegistryDataGridStyle"
           TargetType="DataGrid"
           BasedOn="{StaticResource UiDataGridStyle}">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowHeight" Value="26" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style x:Key="IdeFieldRegistryCompactDataGridStyle"
           TargetType="DataGrid"
           BasedOn="{StaticResource IdeFieldRegistryDataGridStyle}">
        <Setter Property="RowHeight" Value="24" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeMetadata}" />
    </Style>

    <Style x:Key="IdeFieldRegistrySearchBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource UiTextBoxStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="IdeFieldRegistryFormInputStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource UiTextBoxStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="7,4" />
    </Style>

    <Style x:Key="IdeFieldRegistryFormComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource UiComboBoxStyle}">
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style x:Key="IdeFieldRegistryFormLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeDefault}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,6" />
    </Style>

    <Style x:Key="IdeFieldRegistryFormSectionStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="IdeFieldRegistryStatusCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiCornerSmall}" />
        <Setter Property="Padding" Value="9,7" />
    </Style>

    <Style x:Key="IdeFieldRegistryPriorityChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource UiCornerSmall}" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Padding" Value="7,3" />
    </Style>

    <Style x:Key="IdeFieldRegistryWorkflowBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="IdeFieldRegistryWriteBoundaryStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiWarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiWarningBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="IdeFieldRegistryStatusBarStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style x:Key="IdeFieldRegistryCodeTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource UiTextBoxStyle}">
        <Setter Property="Background" Value="{DynamicResource UiCodeSurfaceBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiCodeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeDefault}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="IdeFieldRegistryTabControlStyle"
           TargetType="TabControl"
           BasedOn="{StaticResource UiTabControlStyle}" />

    <Style x:Key="IdeFieldRegistryTabItemStyle"
           TargetType="TabItem"
           BasedOn="{StaticResource UiTabItemStyle}" />

    <!-- M4-R2 additive visual vocabulary. Existing Field Registry styles remain frozen. -->
    <Style x:Key="IdeFieldRegistryR2FlatCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource IdeFieldRegistryCommandButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,3" />
    </Style>

    <Style x:Key="IdeFieldRegistryR2FlatAccentButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource IdeFieldRegistryAccentButtonStyle}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style x:Key="IdeFieldRegistryR2DataGridCellStyle"
           TargetType="DataGridCell"
           BasedOn="{StaticResource UiDataGridCellStyle}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,3" />
    </Style>

    <Style x:Key="IdeFieldRegistryR2DataGridColumnHeaderStyle"
           TargetType="DataGridColumnHeader"
           BasedOn="{StaticResource UiDataGridColumnHeaderStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="7,3" />
    </Style>

    <Style x:Key="IdeFieldRegistryR2DataGridStyle"
           TargetType="DataGrid"
           BasedOn="{StaticResource IdeFieldRegistryDataGridStyle}">
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="CellStyle" Value="{StaticResource IdeFieldRegistryR2DataGridCellStyle}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource IdeFieldRegistryR2DataGridColumnHeaderStyle}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style x:Key="IdeFieldRegistryR2FlatSectionStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="IdeFieldRegistryR2InspectorSectionStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="0,0,0,10" />
    </Style>

    <Style x:Key="IdeFieldRegistryR2EmptyStateTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IdeFieldRegistryMetadataTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
