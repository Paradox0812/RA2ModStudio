<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="IdeAssistPopupFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UiSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource UiCornerMedium}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18"
                                  Direction="270"
                                  Opacity="0.18"
                                  ShadowDepth="4"
                                  Color="{StaticResource UiTextPrimaryColor}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IdeAssistPopupHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="{StaticResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="IdeAssistCompletionListStyle"
           TargetType="ListBox"
           BasedOn="{StaticResource UiListBoxStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style x:Key="IdeAssistCompletionItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemRoot"
                            Background="Transparent"
                            BorderBrush="{StaticResource UiDividerBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SelectionStripe" Background="Transparent" />
                            <ContentPresenter Grid.Column="1"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource UiSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource UiSelectionBrush}" />
                            <Setter TargetName="SelectionStripe" Property="Background" Value="{StaticResource UiAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.58" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IdeAssistCompletionPrimaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UiTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiCodeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeDefault}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IdeAssistMetadataTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UiTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeMetadata}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IdeAssistBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource UiCornerSmall}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,6,4" />
    </Style>

    <Style x:Key="IdeAssistAccentBadgeStyle"
           TargetType="Border"
           BasedOn="{StaticResource IdeAssistBadgeStyle}">
        <Setter Property="Background" Value="{StaticResource UiAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UiAccentBrush}" />
    </Style>

    <Style x:Key="IdeAssistBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UiTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeMetadata}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IdeAssistInspectorRootStyle" TargetType="Grid">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="IdeAssistInspectorHeaderStyle" TargetType="Border" BasedOn="{StaticResource IdeAssistPopupHeaderStyle}" />

    <Style x:Key="IdeAssistTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UiTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeSectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IdeAssistSectionStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{StaticResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource UiCornerSmall}" />
    </Style>

    <Style x:Key="IdeAssistSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UiTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeMetadata}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="IdeAssistBodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource UiTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeDefault}" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IdeAssistMutedTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IdeAssistBodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource UiTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSizeMetadata}" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <Style x:Key="IdeAssistCodeTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IdeAssistBodyTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource UiCodeFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="IdeAssistPathTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource IdeAssistMutedTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource UiCodeFontFamily}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="IdeAssistIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource UiIconButtonStyle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="5" />
    </Style>

    <Style x:Key="IdeAssistToolWindowRootStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UiSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="IdeAssistToolWindowHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{StaticResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="IdeAssistDataGridStyle"
           TargetType="DataGrid"
           BasedOn="{StaticResource UiDataGridStyle}">
        <Setter Property="Background" Value="{StaticResource UiSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="{StaticResource UiGridRowHeight}" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style x:Key="IdeAssistStatusBarStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="{StaticResource UiStatusBarHeight}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{StaticResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style x:Key="IdeAssistDialogRootStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UiCanvasBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="IdeAssistDialogCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UiSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource UiCornerMedium}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="IdeAssistWarningBandStyle"
           TargetType="Border"
           BasedOn="{StaticResource IdeAssistDialogCardStyle}">
        <Setter Property="Background" Value="{StaticResource UiWarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UiWarningBrush}" />
    </Style>

    <Style x:Key="IdeAssistDialogFooterStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="Padding" Value="0,12,0,0" />
        <Setter Property="BorderBrush" Value="{StaticResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style x:Key="IdeAssistCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource UiButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource UiControlHeightCompact}" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <Style x:Key="IdeAssistAccentButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource UiAccentButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource UiControlHeightCompact}" />
        <Setter Property="Padding" Value="12,4" />
    </Style>
</ResourceDictionary>
