<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avalondock="https://github.com/Dirkster99/AvalonDock"
                    xmlns:avalondockControls="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- Shell compatibility keys stay stable while their color values come from the semantic token authority. -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{StaticResource UiCanvasColor}" />
    <SolidColorBrush x:Key="ShellTopBarBrush" Color="{StaticResource UiSurfaceColor}" />
    <SolidColorBrush x:Key="ShellPanelBrush" Color="{StaticResource UiSurfaceColor}" />
    <SolidColorBrush x:Key="ShellBorderBrush" Color="{StaticResource UiBorderColor}" />
    <SolidColorBrush x:Key="ShellPrimaryTextBrush" Color="{StaticResource UiTextPrimaryColor}" />
    <SolidColorBrush x:Key="ShellMutedTextBrush" Color="{StaticResource UiTextSecondaryColor}" />
    <SolidColorBrush x:Key="ShellTopChromeBrush" Color="{StaticResource UiSurfaceSubtleColor}" />
    <SolidColorBrush x:Key="ShellMenuBarBrush" Color="{StaticResource UiSurfaceSubtleColor}" />
    <SolidColorBrush x:Key="ShellToolbarBrush" Color="{StaticResource UiSurfaceSubtleColor}" />
    <SolidColorBrush x:Key="ShellTopChromeInnerDividerBrush" Color="{StaticResource UiTopChromeInnerDividerColor}" />
    <SolidColorBrush x:Key="ShellToolbarSeparatorBrush" Color="{StaticResource UiDividerColor}" />
    <SolidColorBrush x:Key="ShellToolbarBottomBorderBrush" Color="{StaticResource UiToolbarBottomBorderColor}" />
    <SolidColorBrush x:Key="ShellAccentBrush" Color="{StaticResource UiAccentColor}" />
    <SolidColorBrush x:Key="ShellDockHeaderBrush" Color="{StaticResource UiDockHeaderColor}" />
    <SolidColorBrush x:Key="ShellDockTabHoverBrush" Color="{StaticResource UiSurfaceHoverColor}" />
    <SolidColorBrush x:Key="ShellDockTabSelectedBrush" Color="{StaticResource UiSurfaceColor}" />
    <SolidColorBrush x:Key="ShellDockSplitterBrush" Color="{StaticResource UiDockSplitterColor}" />
    <SolidColorBrush x:Key="ShellDockSplitterHoverBrush" Color="{StaticResource UiDockSplitterHoverColor}" />

    <Style x:Key="IdeMainMenuItemStyle"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource UiMenuItemStyle}">
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Padding" Value="5,3" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Padding" Value="5,3" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IdeMainMenuStyle"
           TargetType="{x:Type Menu}"
           BasedOn="{StaticResource UiMenuStyle}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource IdeMainMenuItemStyle}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="IdeDockPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="IdeMainToolbarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellTopChromeBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellToolbarBottomBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style x:Key="IdeShellTitleBarStyle" TargetType="Border">
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{StaticResource ShellTopChromeBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellTopChromeInnerDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="IdeShellSystemMenuButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource UiIconButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="29" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="IdeShellCaptionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource UiIconButtonStyle}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="29" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="IdeShellCloseCaptionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource IdeShellCaptionButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource UiDangerBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IdeDockFloatingWindowStyle"
           TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="Background" Value="{DynamicResource ShellPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="30"
                                    CornerRadius="0"
                                    GlassFrameThickness="0"
                                    ResizeBorderThickness="6"
                                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Panel.ZIndex="1"
                                    AutomationProperties.AutomationId="Shell.Dock.FloatingHost"
                                    AutomationProperties.Name="浮动工具窗口"
                                    Background="{DynamicResource ShellTopChromeBrush}"
                                    BorderBrush="{DynamicResource ShellBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PART_FloatingDragRegion"
                                            Grid.Column="0"
                                            Background="Transparent">
                                        <TextBlock x:Name="PART_FloatingTitleText"
                                                   Margin="7,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ShellPrimaryTextBrush}"
                                                   Text="{TemplateBinding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="PART_FloatingMinimizeButton"
                                                AutomationProperties.AutomationId="Shell.Dock.FloatingHost.MinimizeButton"
                                                AutomationProperties.Name="最小化浮动窗口"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                Style="{StaticResource IdeShellCaptionButtonStyle}"
                                                ToolTip="最小化">
                                            <Path Width="10" Height="1" Data="M 0,0.5 L 10,0.5"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1" />
                                        </Button>
                                        <Button x:Name="PART_FloatingCloseButton"
                                                AutomationProperties.AutomationId="Shell.Dock.FloatingHost.CloseButton"
                                                AutomationProperties.Name="关闭浮动工具窗口"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                Style="{StaticResource IdeShellCloseCaptionButtonStyle}"
                                                ToolTip="关闭浮动工具窗口">
                                            <Path Width="10" Height="10" Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <AdornerDecorator x:Name="PART_FloatingContentHost"
                                              Grid.Row="1">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IdeDocumentHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellTopBarBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="IdeDocumentTabStripStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiSelectionInactiveBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,0,0,0" />
    </Style>

    <Style x:Key="IdeDocumentTabStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="MaxWidth" Value="280" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="IdeDocumentTabTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ShellPrimaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IdeDocumentDirtyMarkerStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ShellMutedTextBrush}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Text" Value="*" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IdeIconCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource UiIconButtonStyle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="IdePrimaryIconCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource IdeIconCommandButtonStyle}">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="IdeCommandSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Background" Value="{StaticResource ShellToolbarSeparatorBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IdeToolWindowHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellTopBarBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="IdeToolWindowTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ShellPrimaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IdeToolWindowStatusStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ShellMutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IdeBottomToolCommandBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="IdeBottomToolDataGridStyle"
           TargetType="DataGrid"
           BasedOn="{StaticResource UiDataGridStyle}">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource UiDividerBrush}" />
    </Style>

    <Style x:Key="IdeOutputTextSurfaceStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource IdeWorkspaceLogTextBoxStyle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="IdeToolFooterStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="IdeShellStatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ShellTopBarBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="IdeToolSearchTextBoxStyle"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource UiTextBoxStyle}">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="SearchTextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource UiCornerSmall}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SearchTextBoxBorder" Property="BorderBrush" Value="{DynamicResource UiAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="SearchTextBoxBorder" Property="BorderBrush" Value="{DynamicResource UiFocusBrush}" />
                            <Setter TargetName="SearchTextBoxBorder" Property="BorderThickness" Value="{StaticResource UiFocusThickness}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SearchTextBoxBorder" Property="Background" Value="{DynamicResource UiSurfaceSubtleBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource UiTextDisabledBrush}" />
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IdeToolFilterChipStyle"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource UiCheckBoxStyle}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource UiBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="FilterChipBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource UiCornerSmall}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ContentSource="Content"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FilterChipBorder" Property="Background" Value="{DynamicResource UiSurfaceHoverBrush}" />
                            <Setter TargetName="FilterChipBorder" Property="BorderBrush" Value="{DynamicResource UiAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="FilterChipBorder" Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
                            <Setter TargetName="FilterChipBorder" Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource UiAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="FilterChipBorder" Property="Background" Value="{DynamicResource UiSelectionInactiveBrush}" />
                            <Setter TargetName="FilterChipBorder" Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource UiTextDisabledBrush}" />
                            <Setter Property="Opacity" Value="0.72" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IdeToolResultListStyle"
           TargetType="{x:Type ListView}"
           BasedOn="{StaticResource UiListViewStyle}">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="IdeSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="#E3E7EC" />
        <Setter Property="ShowsPreview" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="IdeToolWindowTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource ShellPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="IdeToolWindowDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeight" Value="24" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="IdeCompactTextBoxStyle" TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Foreground" Value="{StaticResource ShellPrimaryTextBrush}" />
    </Style>

    <Style x:Key="IdeCompactComboBoxStyle" TargetType="ComboBox">
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Foreground" Value="{StaticResource ShellPrimaryTextBrush}" />
    </Style>

    <Style x:Key="IdeCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource UiButtonStyle}">
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style x:Key="IdeBlueCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource UiAccentButtonStyle}">
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style x:Key="IdeEmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ShellMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <DataTemplate x:Key="IdeDockDocumentHeaderTemplate">
        <TextBlock AutomationProperties.AutomationId="{Binding ContentId, StringFormat=Shell.Dock.Header.{0}}"
                   AutomationProperties.Name="{Binding Title}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ShellPrimaryTextBrush}"
                   Text="{Binding Title}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="IdeDockAnchorableHeaderTemplate">
        <TextBlock AutomationProperties.AutomationId="{Binding ContentId, StringFormat=Shell.Dock.Header.{0}}"
                   AutomationProperties.Name="{Binding Title}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ShellPrimaryTextBrush}"
                   Text="{Binding Title}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="IdeDockAnchorableTitleTemplate">
        <TextBlock FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ShellPrimaryTextBrush}"
                   Text="{Binding Title}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
    </DataTemplate>

    <Style x:Key="IdeDockHeaderActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ShellDockTabHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiSurfacePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IdeDockHeaderMenuButtonStyle" TargetType="{x:Type avalondockControls:DropDownButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalondockControls:DropDownButton}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ShellDockTabHoverBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UiSurfacePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type avalondockControls:AnchorablePaneTitle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ShellPrimaryTextBrush}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalondockControls:AnchorablePaneTitle}">
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <avalondockControls:DropDownButton AutomationProperties.AutomationId="{Binding Model.ContentId, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Shell.Dock.Title.{0}.Menu}"
                                                           AutomationProperties.Name="工具窗口菜单"
                                                           DropDownContextMenu="{Binding Model.Root.Manager.AnchorableContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                                           DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Style="{StaticResource IdeDockHeaderMenuButtonStyle}"
                                                           ToolTip="工具窗口菜单">
                            <Path Width="10"
                                  Height="6"
                                  Data="M 1,1 L 5,5 L 9,1"
                                  SnapsToDevicePixels="True"
                                  Stroke="{DynamicResource ShellMutedTextBrush}"
                                  StrokeEndLineCap="Square"
                                  StrokeStartLineCap="Square"
                                  StrokeThickness="1.4" />
                        </avalondockControls:DropDownButton>
                        <Button x:Name="PART_AutoHidePin"
                                AutomationProperties.AutomationId="{Binding Model.ContentId, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Shell.Dock.Title.{0}.AutoHide}"
                                AutomationProperties.Name="自动隐藏"
                                Command="{Binding LayoutItem.AutoHideCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                Style="{StaticResource IdeDockHeaderActionButtonStyle}"
                                ToolTip="自动隐藏">
                            <Path Width="11"
                                  Height="11"
                                  Data="M 2,1 L 9,1 M 5.5,1 L 5.5,7 M 3,7 L 8,7 M 5.5,7 L 5.5,10"
                                  SnapsToDevicePixels="True"
                                  Stroke="{DynamicResource ShellMutedTextBrush}"
                                  StrokeThickness="1.2" />
                        </Button>
                        <Button x:Name="PART_HidePin"
                                AutomationProperties.AutomationId="{Binding Model.ContentId, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Shell.Dock.Title.{0}.Hide}"
                                AutomationProperties.Name="隐藏工具窗口"
                                Command="{Binding LayoutItem.HideCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                Style="{StaticResource IdeDockHeaderActionButtonStyle}"
                                ToolTip="隐藏工具窗口">
                            <Path Width="10"
                                  Height="10"
                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"
                                  SnapsToDevicePixels="True"
                                  Stroke="{DynamicResource ShellMutedTextBrush}"
                                  StrokeThickness="1.2" />
                        </Button>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Model.IsAutoHidden, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="PART_AutoHidePin" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type avalondockControls:LayoutAnchorableTabItem}">
        <Setter Property="Foreground" Value="{DynamicResource ShellPrimaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalondockControls:LayoutAnchorableTabItem}">
                    <avalondockControls:DropDownControlArea DropDownContextMenu="{Binding Root.Manager.AnchorableContextMenu}"
                                                            DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter Content="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplate="{Binding AnchorableHeaderTemplate, RelativeSource={RelativeSource AncestorType={x:Type avalondock:DockingManager}}}"
                                          VerticalAlignment="Center" />
                    </avalondockControls:DropDownControlArea>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type avalondockControls:LayoutAnchorableControl}">
        <Setter Property="Background" Value="{DynamicResource ShellPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalondockControls:LayoutAnchorableControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            KeyboardNavigation.TabNavigation="Cycle">
                        <ContentPresenter Content="{Binding LayoutItem.View, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplate="{Binding LayoutItem.View.ContentTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplateSelector="{Binding LayoutItem.View.ContentTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}"
                                          FlowDirection="{TemplateBinding FlowDirection}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IdeDockAnchorablePaneControlStyle"
           TargetType="{x:Type avalondockControls:LayoutAnchorablePaneControl}"
           BasedOn="{StaticResource UiTabControlStyle}">
        <Setter Property="Background" Value="{DynamicResource ShellPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ShellPrimaryTextBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TabStripPlacement" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalondockControls:LayoutAnchorablePaneControl}">
                    <Grid ClipToBounds="True"
                          KeyboardNavigation.TabNavigation="Local"
                          SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="HeaderRow" Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" Background="Transparent" />
                        <Border x:Name="PaneHeader"
                                Grid.Row="0"
                                Background="{DynamicResource ShellDockHeaderBrush}"
                                BorderBrush="{DynamicResource ShellBorderBrush}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <avalondockControls:AnchorablePaneTabPanel x:Name="HeaderPanel"
                                                                           Margin="0"
                                                                           IsItemsHost="True"
                                                                           KeyboardNavigation.TabIndex="1"
                                                                           Panel.ZIndex="1" />
                                <avalondockControls:AnchorablePaneTitle Grid.Column="1"
                                                                        Model="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Border>
                        <Border x:Name="ContentPanel"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Cycle">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Model.IsDirectlyHostedInFloatingWindow, RelativeSource={RelativeSource Self}}"
                                           Value="True" />
                                <Condition Binding="{Binding Model.ChildrenCount, RelativeSource={RelativeSource Self}}"
                                           Value="1" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HeaderRow" Property="Height" Value="0" />
                            <Setter TargetName="PaneHeader" Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem" BasedOn="{StaticResource UiTabItemStyle}">
                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding ContentId, StringFormat=Shell.Dock.Tab.{0}}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="MinWidth" Value="64" />
                    <Setter Property="Padding" Value="9,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabChrome"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource ShellDockTabHoverBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ShellPrimaryTextBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource ShellDockTabSelectedBrush}" />
                                        <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource ShellPrimaryTextBrush}" />
                                        <Setter Property="Panel.ZIndex" Value="2" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="TabChrome" Property="Opacity" Value="0.48" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <avalondockControls:LayoutAnchorableTabItem Model="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <avalondockControls:LayoutAnchorableControl Model="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IdeDockSplitterStyle" TargetType="{x:Type avalondockControls:LayoutGridResizerControl}">
        <Setter Property="Background" Value="{DynamicResource ShellDockSplitterBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type avalondockControls:LayoutGridResizerControl}">
                    <Border x:Name="SplitterChrome" Background="{TemplateBinding Background}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SplitterChrome" Property="Background" Value="{DynamicResource ShellDockSplitterHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
